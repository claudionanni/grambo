    def create_state_ladder(self, state: ClusterState) -> go.Figure:
        """Create vertical ladder mapping node states to levels.

        Bottom = CLOSED; top = SYNCED. Nodes move up/down across frames via the slider.
        """
        fig = go.Figure()

        # Define ordered levels from bottom to top
        # Add a dedicated level for DONOR/DESYNCED between JOINED and SYNCED
        levels = [
            ('CLOSED', 0),
            ('OPEN', 1),
            ('PRIMARY', 2),
            ('JOINER', 3),
            ('JOINED', 4),
            ('DONOR/DESYNCED', 4.5),
            ('SYNCED', 5),
        ]
        level_index = {name: y for name, y in levels}

        # Map additional/alias states commonly observed
        alias_levels = {
            'NON_PRIMARY': 2,
            'JOINING': 3,
            'DESYNCED': 4,               # slightly below SYNCED
            'DONOR': 4.5,                # show donors on the dedicated step
            'DONOR/DESYNCED': 4.5,       # donor but desynced
            'CONNECTED': 1,
            'UNKNOWN': 0,
            'DESTROYED': 0,
        }

        def state_to_level(s: str) -> float:
            if not s:
                return 0
            s_up = s.upper()
            if s_up in level_index:
                return float(level_index[s_up])
            return float(alias_levels.get(s_up, 0))

        # Prepare node positions: x by node index, y by level
        # Start from global stable ordering, limited to nodes present in this frame
        nodes = [n for n in (self.all_nodes or list(state.nodes.keys())) if n in state.nodes]
        # Filter placeholder nodes and deduplicate by display label
        def _is_placeholder(n: str) -> bool:
            if not n:
                return True
            nlow = str(n).strip().lower()
            return nlow in {"unknown", "joiner", "donor", "cluster", "n/a"}

        # Build map from display name -> canonical node key (first occurrence)
        display_to_key = {}
        for key in nodes:
            if _is_placeholder(key):
                continue
            display_name = self.node_name_mapping.get(key, key)
            if isinstance(display_name, str) and display_name.startswith('NODE_'):
                display_name = display_name[5:]
            display_to_key.setdefault(display_name, key)

        # Respect global stable ordering for x-axis
        nodes_sorted = [n for n in self.all_nodes if n in display_to_key.values()] if self.all_nodes else sorted(display_to_key.values(), key=lambda k: (self.node_name_mapping.get(k, k)))
        x_vals, y_vals, texts, colors = [], [], [], []

        color_map = {
            'SYNCED': 'green', 'JOINED': 'green',
            'DONOR': 'blue', 'DONOR/DESYNCED': 'blue',
            'PRIMARY': 'lightcoral', 'OPEN': 'lightcoral', 'NON_PRIMARY': 'lightcoral',
            'JOINER': 'orange', 'JOINING': 'orange', 'DESYNCED': 'orange', 'CONNECTED': 'lightblue',
            'CLOSED': 'gray', 'UNKNOWN': 'lightgray'
        }

        # Effective state overlay (donor/joiner) and selected transfers via shared helpers
        effective_state = self._effective_state_overlay(state)
        selected_transfers = self._select_active_transfers(state)

        for i, node in enumerate(nodes_sorted):
            nd = state.nodes[node]
            ns = (effective_state.get(node) or nd.get('state') or 'UNKNOWN')
            y = state_to_level(ns or 'UNKNOWN')
            x_vals.append(i)
            y_vals.append(y)
            # Clean display label
            display_name = self.node_name_mapping.get(node, node)
            if isinstance(display_name, str) and display_name.startswith('NODE_'):
                display_name = display_name[5:]
            label = f"{display_name}\n{ns}"
            texts.append(label)
            colors.append(color_map.get(ns or 'UNKNOWN', 'gray'))

        # Background bands for each level for readability
        for name, y in levels:
            fig.add_shape(
                type="rect",
                x0=-0.5, x1=max(0.5, len(nodes_sorted) - 0.5),
                y0=y - 0.4, y1=y + 0.4,
                line=dict(width=0),
                fillcolor='rgba(0,0,0,0.03)' if int(y) % 2 == 0 else 'rgba(0,0,0,0.06)'
            )
            fig.add_annotation(x=-0.8, y=y, text=name, showarrow=False,
                               xanchor='right', yanchor='middle',
                               font=dict(size=12, color='#555'))

        # Add node markers
        fig.add_trace(go.Scatter(
            x=x_vals, y=y_vals,
            mode='markers+text',
            marker=dict(size=20, color=colors, line=dict(width=2, color='white')),
            text=[t.split('\n')[0] for t in texts],
            textposition='bottom center',
            hovertext=texts,
            hoverinfo='text',
            name='nodes'
        ))

        # X-axis labels as node names (cleaned)
        x_labels = []
        for node in nodes_sorted:
            display_name = self.node_name_mapping.get(node, node)
            if isinstance(display_name, str) and display_name.startswith('NODE_'):
                display_name = display_name[5:]
            x_labels.append(display_name)

        fig.update_layout(
            title={
                'text': f"Node State Ladder - Frame {state.frame_id + 1}",
                'font': {'size': 16}
            },
            showlegend=False,
            margin=dict(b=40, l=70, r=20, t=50),
            xaxis=dict(
                tickmode='array',
                tickvals=list(range(len(nodes_sorted))),
                ticktext=x_labels,
                showgrid=False,
                zeroline=False,
            ),
            yaxis=dict(
                range=[-0.5, 6.2],
                tickmode='array',
                tickvals=[lvl for _, lvl in levels],
                ticktext=[name for name, _ in levels],
                showgrid=False,
                zeroline=False,
            ),
            plot_bgcolor='white',
            height=350
        )

        # Overlay SST/IST transfers as arrows across the ladder
        # Find x positions for donors and joiners
        x_index = {node: idx for idx, node in enumerate(nodes_sorted)}
        def level_of(node_name: str) -> float:
            # Use effective state (DONOR/DESYNCED and JOINER overlays during active SST)
            if not node_name:
                return 0.0
            nd = state.nodes.get(node_name) or {}
            ns = (effective_state.get(node_name) or nd.get('state') or 'UNKNOWN')
            return state_to_level(ns or 'UNKNOWN')

        drawn_pairs = set()
        for tr in selected_transfers:
            ttype = tr.get('type', 'SST')
            donor = tr.get('donor')
            joiner = tr.get('joiner')
            status = (tr.get('status') or 'in_progress').lower()
            method = tr.get('method', '')
            dur = tr.get('duration_seconds')

            if not joiner or joiner not in x_index:
                continue
            if ttype != 'SST' and ttype != 'IST':
                continue
            # Only draw active transfers (already filtered)
            pair = (donor or 'unknown', joiner)
            if pair in drawn_pairs:
                continue
            drawn_pairs.add(pair)

            # Determine colors by type/status
            base_color = '#3498db' if ttype == 'SST' else '#9b59b6'
            status_color = {
                'requested': '#8e44ad',
                'started': base_color,
                'in_progress': base_color,
                'completed': '#2ecc71',
                'failed': '#e74c3c'
            }.get(status, base_color)

            x2 = x_index[joiner]
            y2 = level_of(joiner)
            if donor and donor in x_index:
                x1 = x_index[donor]
                y1 = level_of(donor)
            else:
                # Unknown donor/source: draw short arrow above the joiner pointing down
                x1 = x2
                y1 = min(5.2, y2 + 0.8)

            label = f"{ttype}"
            if method and ttype == 'SST':
                label += f"/{method}"
            if status:
                label += f" [{status}]"
            if dur:
                label += f" ({int(dur)}s)"

            fig.add_annotation(
                x=x2, y=y2,
                ax=x1, ay=y1,
                xref='x', yref='y', axref='x', ayref='y',
                arrowhead=3, arrowsize=1.5, arrowwidth=2,
                arrowcolor=status_color,
                text=label,
                font=dict(size=10, color=status_color),
                yshift=8
            )

        # If all nodes at SYNCED, show a subtle banner
        if nodes_sorted and all(state_to_level(state.nodes[n]['state']) >= 5 for n in nodes_sorted):
            fig.add_annotation(
                xref='paper', yref='paper', x=0.5, y=1.08,
                text='All nodes SYNCED', showarrow=False,
                font=dict(size=14, color='#2ecc71')
            )

        return fig
    
    def create_timeline_marks(self, gap_threshold_minutes=60):
        """Create timeline marks with gap indicators and timestamps"""
        marks = {}
        gap_frames = set()
        
        # Detect frames with significant time gaps
        for i in range(1, len(self.states)):
            current_time = self.states[i].timestamp
            previous_time = self.states[i-1].timestamp
            
            time_diff = (current_time - previous_time).total_seconds() / 60  # Convert to minutes
            
            if time_diff >= gap_threshold_minutes:
                gap_frames.add(i)
        
        # Create marks for timeline slider
        # Show marks every ~10% of frames, but always include gap frames
        mark_interval = max(1, len(self.states) // 10)
        
        for i in range(0, len(self.states)):
            show_mark = (i % mark_interval == 0) or (i in gap_frames) or (i == len(self.states) - 1)
            
            if show_mark:
                frame_time = self.states[i].timestamp.strftime('%H:%M:%S')
                frame_label = f"Frame {i}"
                
                if i in gap_frames:
                    # Find the gap duration
                    if i > 0:
                        gap_minutes = (self.states[i].timestamp - self.states[i-1].timestamp).total_seconds() / 60
                        gap_label = f"🕐 Gap: {gap_minutes:.0f}min"
                    else:
                        gap_label = "🕐 Time Gap"
                    
                    marks[i] = {

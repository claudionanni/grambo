            if node_data.get('issues'):
                hover_info += f"Issues: {', '.join(node_data['issues'])}"
            
            hover_text.append(hover_info)
        
        # Add nodes to plot
        fig.add_trace(go.Scatter(
            x=node_x, y=node_y,
            mode='markers+text',
            marker=dict(
                size=55,  # Increased from 40 to 55 for better visibility
                color=node_colors,

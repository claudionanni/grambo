                        ]
                    } for frame in (self.frames if hasattr(self, 'frames') else [])
                ],
                'sst_workflows': [
                    {
                        'id': workflow.id,
                        'request_time': workflow.started_at.isoformat() if workflow.started_at else None,
                        'joiner': workflow.joiner_node,
                        'donor': workflow.donor_node,
                        'method': workflow.method,
                        'status': workflow.status,
                        'duration_seconds': workflow.duration_seconds,

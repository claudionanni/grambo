#!/usr/bin/env python3
"""
Grambo Cluster Analyzer
=======================

Multi-node Galera cluster log correlation tool.
Takes JSON outputs from gramboo.py and provides cluster-wide analysis.

Usage:
    python3 grambo-cluster.py node1.json node2.json node3.json
    python3 grambo-cluster.py --node-names db1,db2,db3 file1.json file2.json file3.json
    python3 grambo-cluster.py --node db1:db1.json --node db2:db2.json
    python3 grambo-cluster.py --format=json cluster-analysis/*.json
"""

import sys
import json
import argparse
from datetime import datetime, timedelta
from typing import List, Dict, Any, Optional, Set, Tuple, NamedTuple
from dataclasses import dataclass, field
from collections import defaultdict
import re
import os

class NodeData(NamedTuple):
    """Container for node analysis data"""
    name: str
    file_path: str
    data: Dict[str, Any]

@dataclass
class ClusterEvent:
    """Unified cluster event across all nodes"""
    timestamp: datetime
    node: str
    event_type: str
    details: Dict[str, Any]
    original_event: Dict[str, Any] = field(default_factory=dict)

@dataclass
class NodeState:
    """Node state at a specific point in time"""
    name: str
    membership_state: str = "unknown"  # PRIMARY, OPEN, CLOSED, SYNCED, DONOR/DESYNCED, JOINER, etc.
    seqno: Optional[int] = None
    cluster_view_id: Optional[str] = None
    is_in_cluster: bool = False
    last_seen: Optional[datetime] = None

@dataclass  
class SSTWorkflow:
    """SST workflow state - always between two nodes"""
    id: str  # format: timestamp_donor_joiner (e.g., "20250919_181717_d01_l05")
    status: str = "requested"  # requested, started, completed, failed
    joiner_node: str = ""
    donor_node: str = ""
    started_at: Optional[datetime] = None
    completed_at: Optional[datetime] = None
    method: Optional[str] = None
    reason: Optional[str] = None  # failure reason or completion details
    duration_seconds: Optional[float] = None

@dataclass
class ClusterState:
    """Cluster-wide state at a specific point in time"""
    view_id: Optional[str] = None
    member_count: int = 0
    primary_status: bool = False
    quorum_present: bool = False
    members: List[str] = field(default_factory=list)

@dataclass
class Frame:
    """Complete cluster state snapshot at a specific timestamp"""
    timestamp: datetime
    nodes: Dict[str, NodeState] = field(default_factory=dict)
    sst_workflows: Dict[str, SSTWorkflow] = field(default_factory=dict)
    cluster_state: ClusterState = field(default_factory=ClusterState)
    triggering_events: List[ClusterEvent] = field(default_factory=list)  # Events that caused this frame
    id: Optional[str] = None  # Unique SST identifier

@dataclass
class ClusterView:
    """Cluster membership view at a specific time"""
    timestamp: datetime
    node: str
    members: Set[str]
    seqno: Optional[int] = None
    view_id: Optional[str] = None

@dataclass
class StateTransition:
    """Node state transition event"""
    timestamp: datetime
    node: str
    from_state: str
    to_state: str
    seqno: Optional[int] = None

class FrameBuilder:
    """Builds frames by walking through events chronologically and maintaining entity states"""
    
    def __init__(self):
        self.current_nodes: Dict[str, NodeState] = {}
        self.current_sst_workflows: Dict[str, SSTWorkflow] = {}
        self.current_cluster_state = ClusterState()
        self.frames: List[Frame] = []
    
    def process_events(self, events: List[ClusterEvent]) -> List[Frame]:
        """Process events chronologically and generate frames"""
        # Sort all events by timestamp
        sorted_events = sorted(events, key=lambda e: e.timestamp)
        
        for event in sorted_events:
            self._process_single_event(event)
            
        return self.frames
    
    def _process_single_event(self, event: ClusterEvent) -> None:
        """Process a single event and update states"""
        # Store previous state for comparison
        previous_nodes = {k: self._copy_node_state(v) for k, v in self.current_nodes.items()}
        previous_sst_workflows = {k: self._copy_sst_workflow(v) for k, v in self.current_sst_workflows.items()}
        previous_cluster_state = self._copy_cluster_state(self.current_cluster_state)
        
        # Update states based on event
        state_changed = False
        
        if event.event_type == 'state_transition':
            if self._update_node_state(event):
                state_changed = True
                
        elif event.event_type == 'sst_event':
            if self._update_sst_workflow(event):
                state_changed = True
                
        elif event.event_type == 'cluster_view':
            if self._update_cluster_state(event):
                state_changed = True
        
        # Only create frame if state actually changed
        if state_changed:
            self._create_frame(event.timestamp, [event])
    
    def _copy_node_state(self, node: NodeState) -> NodeState:
        """Create a deep copy of NodeState"""
        return NodeState(
            name=node.name,
            membership_state=node.membership_state,
            seqno=node.seqno,
            cluster_view_id=node.cluster_view_id,
            is_in_cluster=node.is_in_cluster,
            last_seen=node.last_seen
        )
    
    def _copy_sst_workflow(self, workflow: SSTWorkflow) -> SSTWorkflow:
        """Create a deep copy of SSTWorkflow"""
        return SSTWorkflow(
            id=workflow.id,
            status=workflow.status,
            joiner_node=workflow.joiner_node,
            donor_node=workflow.donor_node,
            started_at=workflow.started_at,
            completed_at=workflow.completed_at,
            method=workflow.method,
            reason=workflow.reason,
            duration_seconds=workflow.duration_seconds
        )
    
    def _copy_cluster_state(self, cluster_state: ClusterState) -> ClusterState:
        """Create a deep copy of ClusterState"""
        return ClusterState(
            view_id=cluster_state.view_id,
            member_count=cluster_state.member_count,
            primary_status=cluster_state.primary_status,
            quorum_present=cluster_state.quorum_present,
            members=cluster_state.members.copy()
        )
    
    def _update_node_state(self, event: ClusterEvent) -> bool:
        """Update node membership state from state transition event. Returns True if state changed."""
        node_name = event.node or "unknown"
        
        # Get or create node
        if node_name not in self.current_nodes:
            self.current_nodes[node_name] = NodeState(name=node_name)
            state_changed = True
        else:
            state_changed = False
        
        node = self.current_nodes[node_name]
        old_timestamp = node.last_seen
        node.last_seen = event.timestamp
        if old_timestamp != node.last_seen:
            state_changed = True
        
        # Extract state from metadata
        metadata = event.details.get('metadata', {})
        if 'new_state' in metadata:
            old_state = node.membership_state
            node.membership_state = metadata['new_state']
            if old_state != node.membership_state:
                state_changed = True
                
        if 'seqno' in metadata:
            old_seqno = node.seqno
            node.seqno = metadata['seqno']
            if old_seqno != node.seqno:
                state_changed = True
                
        return state_changed
    
    def _update_sst_workflow(self, event: ClusterEvent) -> bool:
        """Update SST workflow state from SST event. Returns True if state changed."""
        metadata = event.details.get('metadata', {})
        subtype = metadata.get('subtype', '')
        state_changed = False
        
        # Extract joiner and donor
        joiner = metadata.get('joiner', event.node)
        donor = metadata.get('donor')
        
        # Skip events without proper joiner/donor metadata (None, empty, or 'None' string)
        if not joiner or not donor or joiner == 'None' or donor == 'None' or joiner == event.node:
            return False  # Can't track without both nodes
        
        # Create or update workflow based on event type
        if subtype == 'sst_requested':
            # Generate workflow ID using the request timestamp
            workflow_id = f"{event.timestamp.strftime('%Y%m%d_%H%M%S')}_{donor.replace('-', '_')}_{joiner.replace('-', '_')}"
            
            # Only create if it doesn't exist yet (avoid duplicates from multiple nodes)
            if workflow_id not in self.current_sst_workflows:
                workflow = SSTWorkflow(
                    id=workflow_id,
                    status='requested',
                    joiner_node=joiner,
                    donor_node=donor,
                    started_at=event.timestamp
                )
                self.current_sst_workflows[workflow_id] = workflow
                state_changed = True
            
        elif subtype in ['sst_started', 'sst_initiated']:
            # Find existing workflow by joiner/donor pair
            target_workflow = None
            for workflow in self.current_sst_workflows.values():
                if (workflow.joiner_node == joiner and 
                    workflow.donor_node == donor and 
                    workflow.status == 'requested'):
                    target_workflow = workflow
                    break
                    
            if target_workflow:
                old_status = target_workflow.status
                target_workflow.status = 'started'
                target_workflow.method = metadata.get('method')
                if old_status != target_workflow.status:
                    state_changed = True
                    
        elif subtype == 'sst_completed':
            # Find existing workflow by joiner/donor pair
            target_workflow = None
            for workflow in self.current_sst_workflows.values():
                if (workflow.joiner_node == joiner and 
                    workflow.donor_node == donor and 
                    workflow.status in ['requested', 'started']):
                    target_workflow = workflow
                    break
                    
            if target_workflow:
                old_status = target_workflow.status
                target_workflow.status = 'completed'
                target_workflow.completed_at = event.timestamp
                target_workflow.method = metadata.get('method')
                if target_workflow.started_at:
                    target_workflow.duration_seconds = (event.timestamp - target_workflow.started_at).total_seconds()
                if old_status != target_workflow.status:
                    state_changed = True
                    
        elif subtype == 'sst_failed':
            # Find existing workflow by joiner/donor pair
            target_workflow = None
            for workflow in self.current_sst_workflows.values():
                if (workflow.joiner_node == joiner and 
                    workflow.donor_node == donor and 
                    workflow.status in ['requested', 'started']):
                    target_workflow = workflow
                    break
                    
            if target_workflow:
                old_status = target_workflow.status
                target_workflow.status = 'failed'
                target_workflow.completed_at = event.timestamp
                target_workflow.reason = metadata.get('reason', 'Unknown failure')
                if target_workflow.started_at:
                    target_workflow.duration_seconds = (event.timestamp - target_workflow.started_at).total_seconds()
                if old_status != target_workflow.status:
                    state_changed = True
        
        return state_changed
    
    def _update_cluster_state(self, event: ClusterEvent) -> bool:
        """Update cluster-wide state from cluster view event. Returns True if state changed."""
        metadata = event.details.get('metadata', {})
        state_changed = False
        
        # Check view_id change
        old_view_id = self.current_cluster_state.view_id
        new_view_id = metadata.get('view_id')
        if old_view_id != new_view_id:
            self.current_cluster_state.view_id = new_view_id
            state_changed = True
        
        # Check primary status change
        old_primary = self.current_cluster_state.primary_status
        new_primary = metadata.get('status') == 'primary'
        if old_primary != new_primary:
            self.current_cluster_state.primary_status = new_primary
            state_changed = True
        
        # Check members change
        members = metadata.get('members', [])
        if isinstance(members, list):
            old_members = self.current_cluster_state.members
            old_count = self.current_cluster_state.member_count
            
            if set(old_members) != set(members):
                self.current_cluster_state.members = members
                state_changed = True
                
            if old_count != len(members):
                self.current_cluster_state.member_count = len(members)
                state_changed = True
        
        return state_changed
        
    def _create_frame(self, timestamp: datetime, triggering_events: List[ClusterEvent]) -> None:
        """Create a new frame with current state"""
        frame = Frame(
            timestamp=timestamp,
            nodes=self.current_nodes.copy(),
            sst_workflows=self.current_sst_workflows.copy(),
            cluster_state=ClusterState(
                view_id=self.current_cluster_state.view_id,
                member_count=self.current_cluster_state.member_count,
                primary_status=self.current_cluster_state.primary_status,
                quorum_present=self.current_cluster_state.quorum_present,
                members=self.current_cluster_state.members.copy()
            ),
            triggering_events=triggering_events
        )
        self.frames.append(frame)


class GramboClusterAnalyzer:
    """Analyzes multiple gramboo JSON outputs for cluster-wide insights"""
    
    def __init__(self, output_format: str = 'text', quiet: bool = False):
        self.nodes: List[NodeData] = []
        self.output_format = output_format
        self.quiet = quiet
        self.cluster_events: List[ClusterEvent] = []
        self.sst_workflows: List[SSTWorkflow] = []
        self.cluster_views: List[ClusterView] = []
        self.state_transitions: List[StateTransition] = []
        
    def log(self, message: str, level: str = 'info') -> None:
        """Log message to stderr with different levels"""
        if level == 'warning':
            # Always show warnings unless explicitly suppressed with --quiet
            if not self.quiet:
                print(message, file=sys.stderr)
        elif level == 'info':
            # Show info messages based on format and quiet flag
            if self.output_format == 'text' and not self.quiet:
                print(message, file=sys.stderr)
            # In JSON mode, suppress info messages unless --verbose is added later
    
    def load_node_data(self, file_path: str, node_name: Optional[str] = None) -> None:
        """Load gramboo JSON output for a node"""
        try:
            with open(file_path, 'r') as f:
                data = json.load(f)
            
            if not node_name:
                # Extract actual Galera node name from the JSON data
                cluster_info = data.get('cluster_info', {})
                galera_node_name = cluster_info.get('local_node_name')
                if galera_node_name:
                    node_name = galera_node_name
                else:
                    # Fallback to filename if no local_node_name found
                    base_name = os.path.basename(file_path)
                    node_name = base_name.split('.')[0]  # Remove .json extension
                    self.log(f"⚠ No local_node_name found, using filename: {node_name}")
            
            # Ensure node_name is not None
            if not node_name:
                node_name = "unknown_node"
            
            # Check for potential duplicate node names
            existing_names = [n.name for n in self.nodes]
            if node_name in existing_names:
                self.log(f"⚠️  WARNING: Duplicate node name '{node_name}' detected!", 'warning')
                self.log(f"   This might cause visualization issues (overlapping nodes, missing arrows)", 'warning')
                self.log(f"   Consider using explicit mapping: --node actual_name:{file_path}", 'warning')
                
            self.nodes.append(NodeData(node_name, file_path, data))
            self.log(f"✓ Loaded {node_name} from {file_path}")
            
        except (FileNotFoundError, json.JSONDecodeError) as e:
            print(f"✗ Error loading {file_path}: {e}", file=sys.stderr)
            sys.exit(1)
    
    def parse_timestamp(self, timestamp_str: str) -> Optional[datetime]:
        """Parse timestamp from various formats"""
        formats = [
            '%Y-%m-%d %H:%M:%S',
            '%Y-%m-%d %H:%M:%S.%f',
            '%m-%d %H:%M:%S',
            '%H:%M:%S'
        ]
        
        for fmt in formats:
            try:
                return datetime.strptime(timestamp_str, fmt)
            except ValueError:
                continue
        
        return None
    
    def extract_cluster_events(self) -> None:
        """Extract and normalize events from all nodes"""
        for node in self.nodes:
            node_data = node.data
            
            # Extract from detailed_events if available (newer format)
            detailed_events = node_data.get('detailed_events', [])
            for event in detailed_events:
                timestamp_str = event.get('timestamp')
                if not timestamp_str:
                    continue
                    
                timestamp = self.parse_timestamp(timestamp_str)
                if not timestamp:
                    continue
                
                event_type = event.get('event_type')
                
                # State Transition Events
                if event_type == 'state_transition' and event.get('state_transition'):
                    st = event['state_transition']
                    cluster_event = ClusterEvent(
                        timestamp=timestamp,
                        node=node.name,
                        event_type='state_transition',
                        details={
                            'from_state': st.get('from_state'),
                            'to_state': st.get('to_state'),
                            'sequence_number': st.get('sequence_number')
                        },
                        original_event=event
                    )
                    self.cluster_events.append(cluster_event)
                
                # Cluster View Events
                elif event_type == 'cluster_view' and event.get('cluster_view'):
                    cv = event['cluster_view']
                    members = []
                    if cv.get('members'):
                        for uuid, member in cv['members'].items():
                            if member.get('name'):
                                members.append(member['name'])
                    
                    cluster_event = ClusterEvent(
                        timestamp=timestamp,
                        node=node.name,
                        event_type='cluster_view',
                        details={
                            'view_id': cv.get('view_id'),
                            'status': cv.get('status'),
                            'members': ','.join(sorted(members)),
                            'member_count': len(members)
                        },
                        original_event=event
                    )
                    self.cluster_events.append(cluster_event)
                
                # SST Events (from metadata or raw message)
                elif event_type == 'sst_event' or 'SST' in event.get('raw_message', ''):
                    cluster_event = ClusterEvent(
                        timestamp=timestamp,
                        node=node.name,
                        event_type='sst_event',
                        details={
                            'message': event.get('raw_message', ''),
                            'metadata': event.get('metadata', {})
                        },
                        original_event=event
                    )
                    self.cluster_events.append(cluster_event)
            
            # Skip st_workflows - grambo-cluster builds its own from detailed_events
            # st_workflows from gramboo.py are pre-aggregated and would conflict with our state machine
            
            # Extract cluster membership from current_view if available
            cluster_info = node_data.get('cluster_info', {})
            if 'current_view' in cluster_info:
                current_view = cluster_info['current_view']
                if current_view and 'timestamp' in current_view:
                    timestamp = self.parse_timestamp(current_view['timestamp'])
                    if timestamp:
                        members = set()
                        view_members = current_view.get('members', {})
                        for uuid, member_info in view_members.items():
                            if member_info.get('name'):
                                members.add(member_info['name'])
                        
                        event = ClusterEvent(
                            timestamp=timestamp,
                            node=node.name,
                            event_type='cluster_view',
                            details={
                                'view_id': current_view.get('view_id'),
                                'status': current_view.get('status'),
                                'members': ','.join(sorted(members)),
                                'member_count': len(members)
                            },
                            original_event=current_view
                        )
                        self.cluster_events.append(event)
        
        # Sort all events by timestamp
        self.cluster_events.sort(key=lambda e: e.timestamp)
        self.log(f"✓ Extracted {len(self.cluster_events)} cluster events")
    
    def correlate_sst_workflows(self) -> None:
        """Find and correlate SST workflows using unique SST IDs"""
        # Track SST workflows by unique ID
        sst_workflows_by_id = {}  # sst_id -> SSTWorkflow
        
        # Sort events chronologically to process in correct order
        sst_events = [e for e in self.cluster_events if e.event_type in ['sst_request', 'sst_event']]
        sst_events.sort(key=lambda e: e.timestamp)
        
        # Smart deduplication: Group by timestamp and keep the most informative event
        from collections import defaultdict
        events_by_timestamp = defaultdict(list)
        
        # Group events by timestamp
        for event in sst_events:
            events_by_timestamp[event.timestamp].append(event)
        
        deduplicated_events = []
        for timestamp, events in events_by_timestamp.items():
            if len(events) == 1:
                # Only one event at this timestamp, keep it
                deduplicated_events.append(events[0])
            else:
                # Multiple events at same timestamp, pick the best one
                best_event = None
                best_score = -1
                
                for event in events:
                    details = event.details
                    metadata = event.original_event.get('metadata', {})
                    
                    # Calculate priority score
                    score = 0
                    subtype = metadata.get('subtype', '')
                    
                    # CRITICAL: Must be an SST failure event to be useful
                    if subtype == 'sst_failed':
                        score += 1000  # Highest priority for actual failure events
                        
                        # Bonus points for having joiner and donor
                        if details.get('joiner') and details.get('donor'):
                            score += 500
                        elif metadata.get('joiner') and metadata.get('donor'):
                            score += 400
                        
                        # Additional bonus for having useful metadata
                        if metadata.get('operation'):
                            score += 100
                        if metadata.get('reason'):
                            score += 100
                            
                    # For non-failure events, use original scoring
                    elif details.get('joiner') and details.get('donor'):
                        score += 100
                    elif metadata.get('joiner') and metadata.get('donor'):
                        score += 90
                    elif details.get('joiner') or metadata.get('joiner'):
                        score += 50
                    
                    # Medium priority: has useful metadata like operation details
                    if metadata.get('operation'):
                        score += 20
                    if metadata.get('reason'):
                        score += 15
                    
                    # Low priority: has some identifying info
                    if metadata.get('subtype'):
                        score += 10
                    
                    # Prefer events with meaningful raw messages (has node names)
                    raw_msg = event.original_event.get('raw_message', '')
                    if 'vinfr-db-d-l05' in raw_msg or 'vinfr-db-d-d01' in raw_msg:
                        score += 30
                    
                    if score > best_score:
                        best_score = score
                        best_event = event
                
                if best_event:
                    deduplicated_events.append(best_event)
                    if timestamp.strftime('%H:%M:%S') == '18:33:48':  # Debug the failure timestamp
                        # print(f"DEBUG: At {timestamp}, kept event with score {best_score}")
                        # print(f"DEBUG: Raw message: {best_event.original_event.get('raw_message', '')}")
                        # print(f"DEBUG: Joiner: {best_event.details.get('joiner')}, Donor: {best_event.details.get('donor')}")
                        # print(f"DEBUG: Metadata subtype: {best_event.original_event.get('metadata', {}).get('subtype')}")
                        # print(f"DEBUG: Event type: {best_event.event_type}")
                        pass
        
        sst_events = deduplicated_events
        # print(f"DEBUG: After deduplication: {len(sst_events)} SST events to process")
        
        # Check what sst_failed events remain after deduplication
        sst_failed_count = 0
        for e in sst_events:
            if e.original_event.get('metadata', {}).get('subtype') == 'sst_failed':
                sst_failed_count += 1
                print(f"DEBUG: Found sst_failed event at {e.timestamp}: {e.original_event.get('raw_message', '')[:80]}")
        # print(f"DEBUG: Found {sst_failed_count} sst_failed events after deduplication")
        
        def create_sst_id(timestamp, donor, joiner):
            """Create unique SST ID in format: timestamp_donor_joiner"""
            # Format: YYYYMMDD_HHMMSS_donor_joiner (donor first since they initiate)
            ts_str = timestamp.strftime('%Y%m%d_%H%M%S')
            donor_clean = donor.replace('-', '_') if donor else 'unknown'
            joiner_clean = joiner.replace('-', '_') if joiner else 'unknown'
            return f"{ts_str}_{donor_clean}_{joiner_clean}"
        
        # print("DEBUG: Starting SST correlation")
        for event in sst_events:
            details = event.details
            metadata = event.original_event.get('metadata', {})
            
            # Debug: Check if our sst_failed event enters the main loop
            if metadata.get('subtype') == 'sst_failed':
                print(f"DEBUG MAIN: sst_failed at {event.timestamp} enters main loop")
                print(f"DEBUG MAIN: event_type={event.event_type}, details={details}, metadata={metadata}")
            
            # Extract joiner and donor from event
            joiner = details.get('joiner') or metadata.get('joiner')
            donor = details.get('donor') or metadata.get('donor')
            
            # If joiner/donor are missing, try to extract from raw message
            if not joiner or not donor:
                raw_message = event.original_event.get('raw_message', '')
                
                # Extract joiner from patterns like "State transfer to 0.4 (vinfr-db-d-l05) failed"
                if not joiner:
                    import re
                    joiner_match = re.search(r'[Ss]tate transfer to [0-9.]+\s*\(([^)]+)\)', raw_message)
                    if joiner_match:
                        joiner = joiner_match.group(1)
                
                # Extract donor from log prefix like "1.1 (vinfr-db-d-d01):" 
                if not donor:
                    donor_match = re.search(r'[0-9.]+\s*\(([^)]+)\):', raw_message)
                    if donor_match:
                        donor = donor_match.group(1)
            
            if metadata.get('subtype') == 'sst_failed':
                print(f"DEBUG EXTRACT: sst_failed extracted joiner={joiner}, donor={donor}")
                print(f"DEBUG EXTRACT: About to proceed to classification")
            
            # For failure events without joiner info, we'll try to find the active SST later
            if not joiner and not (is_failure_event or is_completion_event):
                continue
            
            # Determine event type and significance
            meta_subtype = metadata.get('subtype', '').lower()
            meta_status = metadata.get('status', '').lower()
            raw_message = event.original_event.get('raw_message', '').lower()
            
            if metadata.get('subtype') == 'sst_failed':
                print(f"DEBUG CLASSIFY: About to classify sst_failed at {event.timestamp}")
                print(f"DEBUG CLASSIFY: meta_subtype='{meta_subtype}', meta_status='{meta_status}'")
            
            # Classify event types
            is_request_event = ('request' in meta_subtype or 'request' in meta_status or 
                              'requested state transfer' in raw_message)
            is_start_event = ('start' in meta_subtype or 'start' in meta_status or
                            'initiated' in meta_subtype or 'proceeding' in meta_subtype)
            is_failure_event = ('fail' in meta_subtype or 'fail' in meta_status)
            is_completion_event = ('complet' in meta_subtype or 'success' in meta_status)
            
            # Add debug for failure events specifically
            if meta_subtype == 'sst_failed':
                print(f"DEBUG FAILURE: sst_failed at {event.timestamp}: is_request={is_request_event}, joiner={joiner}, donor={donor}, is_failure={is_failure_event}")
            
            if is_request_event:
                # Request events must have joiner information
                if metadata.get('subtype') == 'sst_failed':
                    print(f"DEBUG PATH: sst_failed at {event.timestamp} took REQUEST path")
                if not joiner:
                    continue
                    
                # Create new SST workflow with unique ID
                sst_id = create_sst_id(event.timestamp, joiner, donor)
                
                # Check for duplicate request at same timestamp (avoid duplicates)
                if sst_id in sst_workflows_by_id:
                    # Duplicate request - just add the event
                    sst_workflows_by_id[sst_id].events.append(event)
                    continue
                
                # Create new workflow
                workflow = SSTWorkflow(
                    request_time=event.timestamp,
                    joiner_node=joiner,
                    donor_node=donor,
                    method=metadata.get('method', 'unknown'),
                    status='requested',
                    id=sst_id
                )
                workflow.events.append(event)
                sst_workflows_by_id[sst_id] = workflow
                
            else:
                # Find the SST workflow this event belongs to
                target_sst_id = None
                
                if metadata.get('subtype') == 'sst_failed':
                    print(f"DEBUG ELSE: sst_failed at {event.timestamp} entered ELSE block, joiner={joiner}")
                
                if joiner:
                    if metadata.get('subtype') == 'sst_failed':
                        print(f"DEBUG STRATEGY1/2: sst_failed at {event.timestamp} has joiner={joiner}, donor={donor}")
                    # Strategy 1: Look for exact timestamp match (same SST instance)
                    temp_sst_id = create_sst_id(event.timestamp, joiner, donor)
                    if temp_sst_id in sst_workflows_by_id:
                        target_sst_id = temp_sst_id
                    else:
                        # Strategy 2: Find the closest active SST for this joiner
                        closest_workflow = None
                        closest_time_diff = float('inf')
                        
                        for sst_id, workflow in sst_workflows_by_id.items():
                            if (workflow.joiner_node == joiner and 
                                workflow.status in ['requested', 'started'] and
                                event.timestamp >= workflow.request_time and
                                # Allow up to 30 minutes between request and subsequent events
                                (event.timestamp - workflow.request_time).total_seconds() <= 1800):
                                
                                time_diff = (event.timestamp - workflow.request_time).total_seconds()
                                print(f"DEBUG STRATEGY2: Candidate workflow {workflow.request_time}, time_diff={time_diff:.0f}s")
                                if time_diff < closest_time_diff:
                                    closest_time_diff = time_diff
                                    closest_workflow = sst_id
                                    print(f"DEBUG STRATEGY2: New closest workflow: {workflow.request_time} (diff={time_diff:.0f}s)")
                        
                        if closest_workflow:
                            target_sst_id = closest_workflow
                            print(f"DEBUG STRATEGY2: Selected workflow with {closest_time_diff:.0f}s difference")
                else:
                    # Strategy 3: For failure events without joiner info, parse from raw message or find any active SST
                    if is_failure_event or is_completion_event:
                        print(f"DEBUG STRATEGY3: Processing failure/completion event at {event.timestamp}")
                        # Group failure events by timestamp - treat simultaneous failures as one workflow event
                        failure_timestamp = event.timestamp
                        
                        # First try to extract joiner from any failure event with the same timestamp
                        import re
                        extracted_joiner = None
                        
                        # Check all SST events at this timestamp for joiner information
                        for same_time_event in sst_events:
                            if (same_time_event.timestamp == failure_timestamp and 
                                same_time_event.original_event.get('metadata', {}).get('subtype') == 'sst_failed'):
                                failure_raw = same_time_event.original_event.get('raw_message', '')
                                joiner_match = re.search(r'[Ss]tate transfer to [0-9.]+\s*\(([^)]+)\)\s*failed', failure_raw, re.IGNORECASE)
                                if joiner_match:
                                    extracted_joiner = joiner_match.group(1)
                                    print(f"DEBUG SST: Extracted joiner '{extracted_joiner}' from grouped failure at {failure_timestamp}")
                                    break
                        
                        if extracted_joiner:
                            # Find the most recent active SST for this extracted joiner
                            for sst_id, workflow in sst_workflows_by_id.items():
                                print(f"DEBUG SST: Checking workflow {sst_id}: joiner={workflow.joiner_node}, status={workflow.status}")
                                # Normalize both node names for comparison (replace dashes with underscores)
                                extracted_joiner_normalized = extracted_joiner.replace('-', '_')
                                workflow_joiner_normalized = workflow.joiner_node.replace('-', '_')
                                if (workflow_joiner_normalized == extracted_joiner_normalized and 
                                    workflow.status in ['requested', 'started'] and
                                    event.timestamp >= workflow.request_time and
                                    (event.timestamp - workflow.request_time).total_seconds() <= 1800):
                                    target_sst_id = sst_id
                                    joiner = extracted_joiner  # Update joiner for consistency
                                    donor = workflow.donor_node  # Use donor from workflow
                                    print(f"DEBUG SST: Found matching workflow {sst_id} for grouped failure!")
                                    break
                            if not target_sst_id:
                                print(f"DEBUG SST: No matching workflow found for extracted joiner '{extracted_joiner}' from grouped failure")
                        
                        # If no specific joiner found, fall back to any active SST
                        if not target_sst_id:
                            print(f"DEBUG SST: No joiner extracted, looking for any active SST workflow")
                            for sst_id, workflow in sst_workflows_by_id.items():
                                if (workflow.status in ['requested', 'started'] and
                                    event.timestamp >= workflow.request_time and
                                    # Allow up to 30 minutes between request and subsequent events
                                    (event.timestamp - workflow.request_time).total_seconds() <= 1800):
                                    target_sst_id = sst_id
                                    joiner = workflow.joiner_node  # Use joiner from workflow
                                    donor = workflow.donor_node   # Use donor from workflow
                                    print(f"DEBUG SST: Using fallback workflow {sst_id}")
                                    break
                
                if target_sst_id:
                    # Add event to existing workflow
                    workflow = sst_workflows_by_id[target_sst_id]
                    workflow.events.append(event)
                    print(f"DEBUG UPDATE: Updating workflow {workflow.request_time} status from '{workflow.status}' to failure")
                    
                    # Update workflow status based on event type
                    if is_start_event and workflow.status == 'requested':
                        workflow.status = 'started'
                    elif is_failure_event:
                        workflow.status = 'failed'
                        workflow.completion_time = event.timestamp
                        if workflow.request_time:
                            workflow.duration_seconds = (event.timestamp - workflow.request_time).total_seconds()
                        # Set method to failure reason for display
                        if metadata and metadata.get('reason'):
                            workflow.method = metadata.get('reason')
                        print(f"DEBUG UPDATE: Workflow {workflow.request_time} now has status='{workflow.status}', duration={workflow.duration_seconds:.0f}s")
                    elif is_completion_event:
                        workflow.status = 'completed'
                        workflow.completion_time = event.timestamp
                        if workflow.request_time:
                            workflow.duration_seconds = (event.timestamp - workflow.request_time).total_seconds()
                else:
                    # Orphaned event - create a minimal workflow for it if it's a terminal event
                    if is_failure_event or is_completion_event:
                        status = 'failed' if is_failure_event else 'completed'
                        sst_id = create_sst_id(event.timestamp, joiner, donor)
                        workflow = SSTWorkflow(
                            request_time=event.timestamp,
                            joiner_node=joiner,
                            donor_node=donor,
                            method=metadata.get('method', 'unknown'),
                            status=status,
                            completion_time=event.timestamp,
                            id=sst_id
                        )
                        workflow.events.append(event)
                        sst_workflows_by_id[sst_id] = workflow
        
        self.sst_workflows = list(sst_workflows_by_id.values())
        self.log(f"✓ Identified {len(self.sst_workflows)} SST workflows")
    
    def analyze_cluster_views(self) -> None:
        """Extract cluster view changes and detect inconsistencies"""
        for event in self.cluster_events:
            if event.event_type == 'cluster_view':
                details = event.details
                members_str = details.get('members', '')
                
                # Parse member list (assuming format like "node1,node2,node3")
                members = set()
                if members_str:
                    members = set(m.strip() for m in members_str.split(',') if m.strip())
                
                view = ClusterView(
                    timestamp=event.timestamp,
                    node=event.node,
                    members=members,
                    seqno=details.get('seqno'),
                    view_id=details.get('view_id')
                )
                self.cluster_views.append(view)
        
        self.log(f"✓ Analyzed {len(self.cluster_views)} cluster view changes")
    
    def extract_state_transitions(self) -> None:
        """Extract state transition events"""
        for event in self.cluster_events:
            if event.event_type == 'state_transition':
                details = event.details
                
                transition = StateTransition(
                    timestamp=event.timestamp,
                    node=event.node,
                    from_state=details.get('from_state', 'unknown'),
                    to_state=details.get('to_state', 'unknown'),
                    seqno=details.get('sequence_number')
                )
                self.state_transitions.append(transition)
        
        self.log(f"✓ Extracted {len(self.state_transitions)} state transitions")
    
    def analyze_cluster(self) -> None:
        """Perform complete cluster analysis using frame-based approach"""
        self.log("🔍 Starting cluster analysis...")
        
        # Extract all events from all nodes
        all_events = []
        for node in self.nodes:
            # Try both 'events' and 'detailed_events' keys for compatibility
            events_data = node.data.get('events', []) or node.data.get('detailed_events', [])
            for event_data in events_data:
                cluster_event = self._convert_to_cluster_event(event_data, node.name)
                if cluster_event:
                    all_events.append(cluster_event)
        
        self.cluster_events = all_events
        self.log(f"✓ Extracted {len(all_events)} cluster events")
        
        # Build frames using the state machine
        frame_builder = FrameBuilder()
        self.frames = frame_builder.process_events(all_events)
        self.log(f"✓ Generated {len(self.frames)} state frames")
        
        # Extract legacy data for compatibility
        self._extract_legacy_data_from_frames()
        
        self.extract_categorized_events()
        
        self.log("✅ Cluster analysis complete")
    
    def _convert_to_cluster_event(self, event_data: Dict[str, Any], node_name: str) -> Optional[ClusterEvent]:
        """Convert raw event data to ClusterEvent"""
        try:
            event_type = event_data.get('event_type', 'unknown')
            timestamp_str = event_data.get('timestamp')
            if not timestamp_str:
                return None
                
            timestamp = datetime.fromisoformat(timestamp_str.replace('Z', '+00:00'))
            
            return ClusterEvent(
                event_type=event_type,
                timestamp=timestamp,
                node=node_name,
                details={'message': event_data.get('raw_message', ''), 'metadata': event_data.get('metadata', {})},
                original_event=event_data
            )
        except Exception:
            return None

    def _extract_legacy_data_from_frames(self) -> None:
        """Extract legacy data structures from frames for display compatibility"""
        # Get final SST workflows from last frame
        if self.frames:
            final_frame = self.frames[-1]
            self.sst_workflows = list(final_frame.sst_workflows.values())
        else:
            self.sst_workflows = []
            
        # Convert ClusterEvents to legacy StateTransition objects
        self.state_transitions = []
        for frame in self.frames:
            for event in frame.triggering_events:
                if event.event_type == 'state_transition':
                    # Create StateTransition object from ClusterEvent
                    metadata = event.details.get('metadata', {})
                    state_transition = StateTransition(
                        timestamp=event.timestamp,
                        node=event.node or "unknown",
                        from_state=metadata.get('old_state', 'unknown'),
                        to_state=metadata.get('new_state', 'unknown'),
                        seqno=metadata.get('seqno', 0)
                    )
                    self.state_transitions.append(state_transition)
        
        # Convert ClusterEvents to legacy ClusterView objects  
        self.cluster_views = []
        for frame in self.frames:
            for event in frame.triggering_events:
                if event.event_type == 'cluster_view':
                    # Create ClusterView object from ClusterEvent
                    metadata = event.details.get('metadata', {})
                    cluster_view = ClusterView(
                        timestamp=event.timestamp,
                        node=event.node or "unknown",
                        view_id=metadata.get('view_id', 'unknown'),
                        members=set(metadata.get('members', [])),
                        seqno=metadata.get('seqno')
                    )
                    self.cluster_views.append(cluster_view)
    
    def extract_categorized_events(self) -> None:
        """Extract and categorize events for web display"""
        self.categorized_events = {
            'state_transfer': [],   # SST/IST events, state transitions
            'service': [],          # startup, shutdown, crash events
            'warnings_errors': []   # error, communication_issue events
        }
        
        for node in self.nodes:
            node_data = node.data
            detailed_events = node_data.get('detailed_events', [])
            
            for event in detailed_events:
                event_type = event.get('event_type', '')
                timestamp_str = event.get('timestamp', '')
                
                try:
                    # Parse timestamp
                    timestamp = datetime.fromisoformat(timestamp_str.replace(' ', 'T'))
                except (ValueError, AttributeError):
                    continue
                
                # Create categorized event
                categorized_event = {
                    'timestamp': timestamp.isoformat(),
                    'node': node.name,
                    'event_type': event_type,
                    'raw_message': event.get('raw_message', ''),
                    'metadata': event.get('metadata', {})
                }
                
                # Categorize events
                if event_type in ['sst_event', 'ist_event', 'state_transition']:
                    self.categorized_events['state_transfer'].append(categorized_event)
                elif event_type == 'service_event':
                    self.categorized_events['service'].append(categorized_event)
                elif event_type in ['error', 'communication_issue']:
                    self.categorized_events['warnings_errors'].append(categorized_event)
        
        # Sort events by timestamp within each category
        for category in self.categorized_events:
            self.categorized_events[category].sort(key=lambda x: x['timestamp'])
    
    def detect_split_brain(self) -> List[Dict[str, Any]]:
        """Detect split-brain scenarios from cluster views"""
        split_brain_events = []
        
        # Group views by timestamp (within a small window)
        time_groups = defaultdict(list)
        for view in self.cluster_views:
            # Round to nearest minute for grouping
            rounded_time = view.timestamp.replace(second=0, microsecond=0)
            time_groups[rounded_time].append(view)
        
        for timestamp, views in time_groups.items():
            if len(views) > 1:
                # Check if nodes have different views of cluster membership
                unique_memberships = set()
                for view in views:
                    membership_str = ','.join(sorted(view.members))
                    unique_memberships.add(membership_str)
                
                if len(unique_memberships) > 1:
                    split_brain_events.append({
                        'timestamp': timestamp,
                        'views': [{'node': v.node, 'members': v.members} for v in views]
                    })
        
        return split_brain_events
    
    def format_output_text(self) -> str:
        """Generate human-readable text output"""
        output = []
        
        # Header
        output.append("=" * 80)
        output.append("| G R A M B O - GALERA CLUSTER MULTI NODE LOG ANALYZER")
        output.append("=" * 80)
        
        # Cluster Overview
        output.append("\n🌐 CLUSTER OVERVIEW")
        output.append("-" * 50)
        node_names = [node.name for node in self.nodes]
        output.append(f"  Nodes: {', '.join(node_names)}")
        
        if self.cluster_events:
            start_time = min(e.timestamp for e in self.cluster_events)
            end_time = max(e.timestamp for e in self.cluster_events)
            output.append(f"  Time Range: {start_time} - {end_time}")
            output.append(f"  Total Events: {len(self.cluster_events)}")
        
        # SST/IST Workflows
        if self.sst_workflows:
            output.append("\n🔄 SST/IST WORKFLOWS")
            output.append("-" * 50)
            
            for workflow in self.sst_workflows[:10]:  # Limit to first 10
                duration_str = ""
                if workflow.duration_seconds:
                    duration_str = f" ({workflow.duration_seconds:.0f}s)"
                
                donor_info = f" → {workflow.donor_node}" if workflow.donor_node else ""
                method_info = f" ({workflow.method})" if workflow.method else ""
                
                output.append(f"  {workflow.started_at} | {workflow.joiner_node}{donor_info} | "
                            f"{workflow.status.upper()}{method_info}{duration_str}")
        
        # Split-Brain Detection
        split_brain_events = self.detect_split_brain()
        if split_brain_events:
            output.append("\n⚠️  SPLIT-BRAIN SCENARIOS")
            output.append("-" * 50)
            
            for event in split_brain_events[:5]:  # Limit to first 5
                output.append(f"  {event['timestamp']} | Different cluster views:")
                for view in event['views']:
                    members_str = ', '.join(sorted(view['members']))
                    output.append(f"    └─ {view['node']}: {{{members_str}}}")
        
        # State Transitions Timeline
        if self.state_transitions:
            output.append("\n🔄 STATE TRANSITIONS")
            output.append("-" * 50)
            
            for transition in self.state_transitions[:15]:  # Limit to first 15
                seqno_info = f" (seqno: {transition.seqno})" if transition.seqno else ""
                output.append(f"  {transition.timestamp} | {transition.node} | "
                            f"{transition.from_state} → {transition.to_state}{seqno_info}")
        
        return '\n'.join(output)
    

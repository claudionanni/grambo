                    {
                        'timestamp': event['timestamp'].isoformat() if isinstance(event['timestamp'], datetime) else str(event['timestamp']),
                        'views': [
                            {
                                'node': view['node'],
                                'members': list(view['members']) if isinstance(view['members'], set) else view['members']
                            }
                            for view in event['views']
                        ]

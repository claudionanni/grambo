def _read_input(path: Optional[str]) -> Dict[str, Any]:
    """Read a single GRAP JSON from a file or stdin."""
    if path and path != "-":
        with open(path, "r", encoding="utf-8") as f:
            return json.load(f)
    return json.load(sys.stdin)


def _read_multiple_inputs(paths: List[str]) -> Dict[str, Any]:
    """Read and merge multiple GRAP JSON files into a single object.

    Rules:
    - Accept one or more file paths; "-" means read one JSON payload from stdin (only once).
    - Each input must be a JSON object containing an "entities" array (GRAP output).
    - Merge all entities, then sort chronologically (timestamp, line_number).
    - Return a synthetic GRAP-like JSON: { entities: [...], merged_from: [...] }
    """
    merged_entities: List[Dict[str, Any]] = []
    merged_from: List[str] = []

    if not paths:
        raise ValueError("No input paths provided")

    used_stdin = False
    for p in paths:
        if p == "-":
            if used_stdin:
                # Avoid reading stdin twice
                continue
            data = _read_input("-")
            used_stdin = True
            merged_from.append("stdin")
        else:
            with open(p, "r", encoding="utf-8") as f:
                data = json.load(f)
            merged_from.append(p)

        ents = data.get("entities") or []
        # Defensive: ensure each entity has a timestamp/line_number field
        for e in ents:
            if "timestamp" not in e:
                e["timestamp"] = None
            if "line_number" not in e:
                e["line_number"] = 0
        merged_entities.extend(ents)

    # Sort once globally
    merged_entities = sort_entities(merged_entities)

    return {
        "source": "grap_multi_merge",
        "merged_from": merged_from,
        "entities": merged_entities,
    }


def main():
    import argparse
    p = argparse.ArgumentParser(description="Build per-event cluster frames from GRAP JSON")
    p.add_argument("inputs", nargs="*", help="One or more GRAP JSON files (use '-' for stdin)")
    p.add_argument("--output", "-o", help="Frames JSON output file (defaults to stdout)")
    p.add_argument("--ndjson", action="store_true", help="Emit NDJSON (one frame per line)")
    args = p.parse_args()

    # Input handling:
    # - No args: read a single JSON from stdin
    # - One arg: read that path (or '-' for stdin)
    # - Many args: merge all into a single entity stream
    try:
        if not args.inputs:
            grap_json = _read_input("-")
        elif len(args.inputs) == 1:
            grap_json = _read_input(args.inputs[0])
        else:
            grap_json = _read_multiple_inputs(args.inputs)
    except json.JSONDecodeError as e:
        print(f"Invalid JSON input: {e}", file=sys.stderr)
        sys.exit(2)
    except OSError as e:
        print(f"Cannot read input: {e}", file=sys.stderr)
        sys.exit(2)
    except ValueError as e:
        print(str(e), file=sys.stderr)
        sys.exit(2)

    frames = build_frames(grap_json)
    
    # Re-index frames to ensure sequential ordering by (timestamp, original_entity_index)
    # This preserves chronological order while maintaining deterministic frame indices
    for new_index, frame in enumerate(frames):
        frame["index"] = new_index

    if args.ndjson:
        out = sys.stdout
        close_after = False
        if args.output:
            out = open(args.output, "w", encoding="utf-8")
            close_after = True
        try:
            for fr in frames:
                out.write(json.dumps(fr, separators=(",", ":")) + "\n")
        except BrokenPipeError:
            try:
                out.flush()
            except Exception:
                pass
            # Exit quietly when the downstream pipe is closed (e.g., head)
            try:
                sys.exit(0)
            except SystemExit:
                return
        finally:
            if close_after:
                out.close()
    else:
        data = {
            "source": "grap_frames",
            "frames_count": len(frames),
            "frames": frames,
        }
        text = json.dumps(data, indent=2)
        try:
            if args.output:
                with open(args.output, "w", encoding="utf-8") as f:
                    f.write(text)
            else:
                print(text)
        except BrokenPipeError:
            # Quietly exit when piping to tools like head
            try:
                sys.exit(0)
            except SystemExit:
                return


if __name__ == "__main__":
    main()

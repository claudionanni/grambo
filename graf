#!/usr/bin/env python3
"""
GRAF - GRAP Frames Builder

Builds per-event cluster "frames" from GRAP JSON output. Each frame is a
snapshot of the cluster state immediately after applying one event, suitable
for timeline visualization.

Usage examples:
  # Pipe GRAP output directly
  ./grap --format=json unittest/error.31407.log | ./graf --ndjson | head -5

  # Or use files
  ./grap --format=json unittest/error.31407.log > grap.json
  ./graf grap.json -o frames.json

Output formats:
  - Default: JSON object with metadata and frames array
  - --ndjson: one JSON frame per line (stream-friendly)
"""

from __future__ import annotations

import sys
import json
import re
from dataclasses import dataclass, field, asdict
from typing import Dict, List, Optional, Any, Tuple, Set
from datetime import datetime


# -----------------------------
# Domain models (in-memory state)
# -----------------------------

@dataclass
class NodeMember:
    name: str = ""
    uuid: str = ""
    address: str = ""
    state: str = ""           # joined/synced/etc
    role: str = ""            # donor/joiner/unknown


@dataclass
class SstSession:
    session_id: str = ""
    method: str = ""
    donor: str = ""
    joiner: str = ""
    status: str = ""          # started/proceeding_with_backup/donor_selected/transfer_complete/failed/completed
    started_at: Optional[str] = None
    ended_at: Optional[str] = None
    duration_seconds: Optional[float] = None
    backup_transfer: Optional[bool] = None
    failure_reason: Optional[str] = None


@dataclass
class IstSession:
    session_id: str = ""
    node: str = ""            # receiver node or address when known
    uuid: str = ""
    status: str = ""          # preparing/prepared/receiving/applying/received/processing
    first: Optional[int] = None
    last: Optional[int] = None
    progress_percent: Optional[float] = None
    events_processed: Optional[int] = None
    events_total: Optional[int] = None
    started_at: Optional[str] = None
    updated_at: Optional[str] = None


@dataclass
class ClusterState:
    cluster_ref: str = ""
    cluster_name: Optional[str] = None
    cluster_uuid: Optional[str] = None
    view_state: str = "UNKNOWN"    # PRIM/NON_PRIM/UNKNOWN
    view_seq: Optional[int] = None
    view_id: Optional[str] = None
    quorum: Optional[bool] = None   # derived from view_state: PRIM => True

    members: Dict[str, NodeMember] = field(default_factory=dict)
    sst_sessions: Dict[str, SstSession] = field(default_factory=dict)
    ist_sessions: Dict[str, IstSession] = field(default_factory=dict)

    error_count: int = 0
    warning_count: int = 0
    errors_recent: List[Dict[str, Any]] = field(default_factory=list)  # capped list

    def snapshot(self) -> Dict[str, Any]:
        data = asdict(self)
        # Keep only the last 10 errors to bound size
        data["errors_recent"] = self.errors_recent[-10:]
        return data


@dataclass
class WorldState:
    clusters: Dict[str, ClusterState] = field(default_factory=dict)
    counters: Dict[str, int] = field(default_factory=lambda: {
        "view": 0, "node": 0, "sst": 0, "ist": 0, "error": 0, "transaction": 0, "cluster": 0
    })


# -----------------------------
# Error classification helpers
# -----------------------------

SST_FAILURE_PATTERNS = [
    re.compile(r"WSREP:\s+.*State transfer .* failed:\s+(?P<reason>.+)", re.IGNORECASE),
    re.compile(r"Application state transfer failed", re.IGNORECASE),
    re.compile(r"failed:\s+(?P<reason>Broken pipe|Invalid argument|Operation canceled)", re.IGNORECASE),
]

IST_FAILURE_PATTERNS = [
    re.compile(r"IST[^\n]*?(fail|failed|error|aborted|canceled)", re.IGNORECASE),
]


def detect_sst_failure(message: str) -> Optional[str]:
    for rx in SST_FAILURE_PATTERNS:
        m = rx.search(message)
        if m:
            reason = m.groupdict().get("reason") or m.group(0)
            return reason.strip()
    return None


def is_cluster_scope_error(message: str) -> bool:
    msg = message.lower()
    return any(k in msg for k in [
        "primary component", "non-prim", "non_primary", "quorum", "view change", "pc: ", "lost connection to cluster"
    ])


def _is_placeholder_name(n: Optional[str]) -> bool:
    if not n:
        return True
    nlow = str(n).strip().lower()
    return nlow in {"unknown", "joiner", "donor", "cluster", "n/a", "unspecified"}


def _normalize_node_state(raw: Optional[str]) -> str:
    """Normalize various raw node_state strings into the canonical set.

    Canonical states: CLOSED, OPEN, JOINER, JOINED, SYNCED, DONOR, UNKNOWN
    Accepts inputs like "JOINED -> SYNCED", "NODE_11407 -> synced", "requested",
    and returns the canonical uppercase state.
    """
    if not raw:
        return "UNKNOWN"
    s = str(raw).strip()
    # If arrow transition present, take RHS
    if '->' in s:
        parts = s.split('->')
        s = parts[-1].strip()
    s_up = s.upper()
    # Common normalizations
    if 'SYNCED' in s_up:
        return 'SYNCED'
    if 'JOINER' in s_up:
        return 'JOINER'
    if 'JOINED' in s_up:
        return 'JOINED'
    if 'DONOR' in s_up:
        return 'DONOR'
    if 'PRIMARY' in s_up:
        # primary is not a separate member lifecycle state we want to display;
        # keep as OPEN (or SYNCED) — prefer OPEN to avoid confusion
        return 'OPEN'
    if 'OPEN' in s_up:
        return 'OPEN'
    if 'CLOSED' in s_up:
        return 'CLOSED'
    # other words that indicate requested/request -> JOINER
    if 'REQUEST' in s_up or 'REQUESTED' in s_up:
        return 'JOINER'
    # fallback to UNKNOWN
    return 'UNKNOWN'


def _normalize_cluster_state(raw: Optional[str]) -> Optional[str]:
    """Normalize cluster/component state strings to canonical tokens.

    Returns one of PRIM, NON_PRIM or the uppercased value when recognisable.
    """
    if raw is None:
        return None
    s = str(raw).strip()
    if not s:
        return None
    s_up = s.upper().replace('-', '_')
    if s_up == 'NON_PRIMARY':
        return 'NON_PRIM'
    if s_up in {'PRIM', 'PRIMARY'}:
        return 'PRIM'
    if s_up == 'NON_PRIM':
        return 'NON_PRIM'
    return s_up


# -----------------------------
# Utilities
# -----------------------------

def parse_iso(ts: Optional[str]) -> Optional[datetime]:
    if not ts:
        return None
    try:
        return datetime.fromisoformat(ts.replace("Z", "+00:00"))
    except Exception:
        return None


def to_iso_string(dt: Optional[datetime]) -> Optional[str]:
    """Convert datetime to ISO string, handling None values."""
    if dt is None:
        return None
    return dt.isoformat()


def sort_entities(entities: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    def key(e: Dict[str, Any]) -> Tuple:
        ts = parse_iso(e.get("timestamp"))
        ln = e.get("line_number", 0)
        # Use timestamp_index for sub-ordering when available (multi-file processing)
        ts_idx = e.get("timestamp_index", 0)
        return ((ts or datetime.min), ts_idx, ln)
    return sorted(entities, key=key)


# -----------------------------
# Reducers per entity type
# -----------------------------

def reduce_view(world: WorldState, e: Dict[str, Any]):
    cref = e.get("cluster_ref")
    if not cref:
        return
    c = world.clusters.setdefault(cref, ClusterState(cluster_ref=cref))
    state = _normalize_cluster_state(e.get("cluster_state"))
    if state:
        c.view_state = state
    elif not c.view_state:
        c.view_state = "UNKNOWN"
    c.view_seq = e.get("view_seq") or c.view_seq
    c.view_id = e.get("view_id") or c.view_id
    c.cluster_uuid = e.get("cluster_uuid") or c.cluster_uuid
    c.quorum = True if c.view_state == "PRIM" else (False if c.view_state == "NON_PRIM" else None)
    # Members (when present)
    for name in e.get("members") or []:
        # Skip placeholder members like 'unspecified'
        if _is_placeholder_name(name):
            continue
        m = c.members.setdefault(name, NodeMember(name=name))
        if not m.state:
            m.state = "unknown"


def reduce_node(world: WorldState, e: Dict[str, Any]):
    cref = e.get("cluster_ref")
    if not cref:
        return
    c = world.clusters.setdefault(cref, ClusterState(cluster_ref=cref))
    name = e.get("node_name") or e.get("node_uuid") or "unknown"
    m = c.members.setdefault(name, NodeMember(name=name))
    if e.get("node_uuid"):
        m.uuid = e["node_uuid"]
    if e.get("node_address"):
        m.address = e["node_address"]
    if e.get("node_state"):
        m.state = _normalize_node_state(e["node_state"])


def reduce_sst(world: WorldState, e: Dict[str, Any]):
    cref = e.get("cluster_ref")
    if not cref:
        return
    c = world.clusters.setdefault(cref, ClusterState(cluster_ref=cref))
    sid = e.get("entity_id") or f"sst_{len(c.sst_sessions)+1}"
    sess = c.sst_sessions.setdefault(sid, SstSession(session_id=sid))
    sess.method = e.get("sst_method") or sess.method
    donor_node = e.get("donor_node")
    joiner_node = e.get("joiner_node")
    # Ignore placeholder names (unknown/unspecified) to avoid creating fake members
    if donor_node and not _is_placeholder_name(donor_node):
        sess.donor = donor_node
        # ensure member exists, but do NOT persist role here
        _ = c.members.setdefault(sess.donor, NodeMember(name=sess.donor))
    else:
        sess.donor = ""

    if joiner_node and not _is_placeholder_name(joiner_node):
        sess.joiner = joiner_node
        # ensure member exists, but do NOT persist role here
        _ = c.members.setdefault(sess.joiner, NodeMember(name=sess.joiner))
    else:
        sess.joiner = ""
    if e.get("sst_status"):
        sess.status = e["sst_status"]
    if e.get("backup_transfer_occurred") is not None:
        sess.backup_transfer = bool(e["backup_transfer_occurred"])
    # timestamps
    ts = e.get("timestamp")
    # Only consider these statuses as indicating an actual started transfer
    if sess.status in ("started", "backup_transfer_started", "proceeding_with_backup") and not sess.started_at:
        sess.started_at = ts
    if sess.status in ("transfer_complete", "completed") and not sess.ended_at:
        sess.ended_at = ts
        dur = None
        st = parse_iso(sess.started_at)
        en = parse_iso(sess.ended_at)
        if st and en:
            dur = (en - st).total_seconds()
        sess.duration_seconds = dur or e.get("duration_seconds")

    # If a donor/joiner is present, reflect that in the member's state so
    # the visualizer can highlight donor/joiner roles (don't override with
    # placeholders).
    # Only assign persistent 'role' to members here. Do NOT mutate member.state
    # because state is a transient property that should be derived from node_state
    # events and per-frame active SST overlays. This avoids donor flags leaking
    # indefinitely into future frames.
    # Do NOT persist role on members here. Role/visual highlighting for donor
    # and joiner will be computed per-frame when the session is active. This
    # prevents stale donor/joiner labels from appearing after a node has
    # transitioned back to JOINED/SYNCED.
    # Keep session donor/joiner values in the SstSession object only.


def reduce_ist(world: WorldState, e: Dict[str, Any]):
    cref = e.get("cluster_ref")
    if not cref:
        return
    c = world.clusters.setdefault(cref, ClusterState(cluster_ref=cref))
    sid = e.get("entity_id") or f"ist_{len(c.ist_sessions)+1}"
    sess = c.ist_sessions.setdefault(sid, IstSession(session_id=sid))
    if e.get("ist_uuid"): sess.uuid = e["ist_uuid"]
    if e.get("ist_status"): sess.status = e["ist_status"]
    if e.get("ist_first") is not None: sess.first = e["ist_first"]
    if e.get("ist_last") is not None: sess.last = e["ist_last"]
    if e.get("progress_percent") is not None: sess.progress_percent = e["progress_percent"]
    if e.get("events_processed") is not None: sess.events_processed = e["events_processed"]
    if e.get("events_total") is not None: sess.events_total = e["events_total"]
    # Try to infer node from receiver address "tcp://host:port"
    # Try multiple hints for node attribution
    # 1) direct node fields
    for key in ("node_name", "node", "receiver_node"):
        if e.get(key):
            sess.node = e[key]
            break
    # 2) receiver_address (tcp://host:port) -> extract host and match to known members by name/address
    if not sess.node and e.get("receiver_address"):
        sess.node = e["receiver_address"]
        addr = e["receiver_address"]
        host = None
        m = re.search(r"tcp://([^:/]+)", str(addr))
        if m:
            host = m.group(1)
        if host:
            # attempt to map host to existing members by address or substring match
            c = world.clusters.setdefault(e.get("cluster_ref", "_unknown_cluster"), ClusterState(cluster_ref=e.get("cluster_ref", "_unknown_cluster")))
            for name, member in c.members.items():
                if member.address and host in member.address:
                    sess.node = name
                    break
                if host in name:
                    sess.node = name
                    break
    ts = e.get("timestamp")
    if not sess.started_at:
        sess.started_at = ts
    sess.updated_at = ts


def reduce_error(world: WorldState, e: Dict[str, Any]):
    cref = e.get("cluster_ref")
    if cref:
        c = world.clusters.setdefault(cref, ClusterState(cluster_ref=cref))
    else:
        # Put under a synthetic bucket if no cluster_ref
        c = world.clusters.setdefault("_unknown_cluster", ClusterState(cluster_ref="_unknown_cluster"))
    level = (e.get("error_level") or "").lower()
    msg = e.get("error_message") or e.get("raw_line") or ""
    if level in ("warning", "warn"):
        c.warning_count += 1
    else:
        c.error_count += 1
    # Basic categorization
    msg_l = msg.lower()
    category = None
    scope = "node"
    if detect_sst_failure(msg):
        category = "sst_failure"
    elif "ist" in msg_l:
        category = "ist"
    elif any(k in msg_l for k in ["asio", "socket", "connect", "timeout", "gcomm"]):
        category = "network"
    elif is_cluster_scope_error(msg):
        category = "cluster"
        scope = "cluster"
    else:
        category = "general"

    c.errors_recent.append({
        "timestamp": e.get("timestamp"),
        "level": level or "error",
        "message": msg[:500],
        "component": e.get("component") or "",
        "category": category,
        "scope": scope,
    })
    # SST failure linkage: close the most recent open SST session
    reason = detect_sst_failure(msg)
    if reason:
        # Find last open session (no ended_at and status not terminal)
        open_sess = None
        for sess in reversed(list(c.sst_sessions.values())):
            if not sess.ended_at and sess.status not in ("failed", "completed", "transfer_complete"):
                open_sess = sess
                break
        if open_sess:
            open_sess.status = "failed"
            open_sess.failure_reason = reason
            open_sess.ended_at = e.get("timestamp")

    # IST failure linkage: mark the most recent IST session as failed when errors mention IST failure
    if any(rx.search(msg) for rx in IST_FAILURE_PATTERNS):
        for sess in reversed(list(c.ist_sessions.values())):
            if sess.status and sess.status.lower() not in ("received", "completed"):
                sess.status = "failed"
                sess.updated_at = e.get("timestamp")
                break


def reduce_cluster(world: WorldState, e: Dict[str, Any]):
    cref = e.get("cluster_ref")
    if not cref:
        return
    c = world.clusters.setdefault(cref, ClusterState(cluster_ref=cref))
    # Seed basic identity from the cluster entity
    if e.get("cluster_uuid"):
        c.cluster_uuid = e["cluster_uuid"]
    if e.get("cluster_name"):
        c.cluster_name = e["cluster_name"]


# -----------------------------
# Frame builder
# -----------------------------

def build_frames(grap_json: Dict[str, Any]) -> List[Dict[str, Any]]:
    entities = grap_json.get("entities") or []
    entities = sort_entities(entities)


    # --- State machine: track latest state for each entity property ---
    # For each entity type, keep a dict of {entity_id: {property: value, ...}}
    state_machine = {}
    # For each node, also keep a reference to its immutable core properties
    node_immutable = {}
    # For each cluster, keep immutable core properties
    cluster_immutable = {}
    # State machine for quorum events (per cluster key)
    # state_machine['quorum'][cluster_key] = latest quorum event dict

    frames: List[Dict[str, Any]] = []
    timestamps = []

    for idx, e in enumerate(entities):
        et = (e.get("entity_type") or "").lower()
        eid = e.get("entity_id")
        ts = parse_iso(e.get("timestamp"))
        timestamps.append(ts)

        # --- Track immutable entities ---
        if et == "node":
            node_immutable[e.get("node_name") or e.get("node_uuid") or eid] = dict(e)
        if et == "cluster":
            cluster_immutable[e.get("cluster_ref") or eid] = dict(e)

        # --- Track latest QuorumEntity per cluster using state machine ---
        if et == "quorum":
            # Use group_uuid, cluster_uuid, or cluster_ref as key
            key = e.get("group_uuid") or e.get("cluster_uuid") or e.get("cluster_ref") or "_default"
            if "quorum" not in state_machine:
                state_machine["quorum"] = {}
            prev = state_machine["quorum"].get(key, {})
            merged = dict(prev)
            # Track all keys ever seen for this quorum key
            if "_quorum_keys" not in state_machine:
                state_machine["_quorum_keys"] = {}
            prev_keys = set(prev.keys())
            new_keys = set(k for k in e.keys() if k not in ("raw_line", "log_source", "line_number"))
            all_keys = prev_keys | new_keys
            state_machine["_quorum_keys"].setdefault(key, set()).update(all_keys)
            # Update with new values, even if they are None or empty (explicit clear)
            for k in all_keys:
                if k in e and k not in ("raw_line", "log_source", "line_number"):
                    merged[k] = e[k]
                elif k not in ("raw_line", "log_source", "line_number"):
                    merged[k] = None
            state_machine["quorum"][key] = merged

        # --- Update state machine for time-varying entities ---
        if et not in state_machine:
            state_machine[et] = {}
        
        # Track UUIDs ONLY from node_state entities (they have reliable node linkage)
        if e.get("node_uuid") and et == "node_state":
            node_key = e.get("node_name") or e.get("node_uuid") or eid
            # Initialize node_uuid tracking if not present
            if "node_uuid" not in state_machine:
                state_machine["node_uuid"] = {}
            if node_key not in state_machine["node_uuid"]:
                state_machine["node_uuid"][node_key] = []
            
            # Check if we already have a UUID entry for this exact timestamp
            current_uuid = e["node_uuid"]
            existing_entry = None
            for entry in state_machine["node_uuid"][node_key]:
                if entry["timestamp"] == to_iso_string(ts):
                    existing_entry = entry
                    break
            
            if existing_entry:
                # If we have an existing UUID for this timestamp, prefer the longer/more complete one
                existing_uuid = existing_entry["uuid"]
                if len(current_uuid) > len(existing_uuid):
                    # Current UUID is longer, replace the existing one
                    existing_entry["uuid"] = current_uuid
                # Otherwise keep the existing UUID (it's longer or equal)
            else:
                # Store new timestamped UUID entry
                timestamped_uuid = {
                    "timestamp": to_iso_string(ts),
                    "uuid": current_uuid
                }
                state_machine["node_uuid"][node_key].append(timestamped_uuid)
        
        # Use node_name or node_uuid as key for node_state, etc.
        if et == "node_state":
            key = e.get("node_name") or e.get("node_uuid") or eid
            if key not in state_machine[et]:
                state_machine[et][key] = []  # Store list of timestamped states
            # Create timestamped state entry
            timestamped_state = {
                "timestamp": to_iso_string(ts),
                "state": {k: v for k, v in e.items() 
                         if k not in ("entity_type", "entity_id", "timestamp", "line_number", "raw_line", "log_source", "cluster_ref")}
            }
            state_machine[et][key].append(timestamped_state)
        elif et == "view" or et == "wsrep_view":
            cluster_key = e.get("cluster_ref") or eid
            layer = (e.get("view_layer") or ("wsrep" if et == "wsrep_view" else "gcomm")).lower()
            node_name = e.get("node_name")
            node_uuid = e.get("node_uuid")
            is_node_view = bool(node_name or node_uuid)

            if not is_node_view:
                # Track cluster-level view (gcomm + wsrep layers)
                # Store views in timestamped lists for accurate frame snapshots
                view_et = "view"
                if view_et not in state_machine:
                    state_machine[view_et] = {}
                if cluster_key not in state_machine[view_et]:
                    state_machine[view_et][cluster_key] = {}
                
                payload = {
                    k: v
                    for k, v in e.items()
                    if k not in {"entity_type", "entity_id", "line_number", "raw_line", "log_source"}
                }
                payload["timestamp"] = to_iso_string(ts)
                payload["view_layer"] = layer
                
                if layer == "wsrep":
                    # Store wsrep views as timestamped list
                    if "wsrep_view_history" not in state_machine[view_et][cluster_key]:
                        state_machine[view_et][cluster_key]["wsrep_view_history"] = []
                    state_machine[view_et][cluster_key]["wsrep_view_history"].append(payload)
                else:
                    # Store gcomm views as timestamped list
                    if "gcomm_view_history" not in state_machine[view_et][cluster_key]:
                        state_machine[view_et][cluster_key]["gcomm_view_history"] = []
                    state_machine[view_et][cluster_key]["gcomm_view_history"].append(payload)

            # Track per-node local view snapshots when node information present
            if node_name or node_uuid:
                nv_key = node_name or node_uuid
                node_view_sm = state_machine.setdefault("node_view", {})
                node_entry = node_view_sm.setdefault(nv_key, {})
                node_entry.update({
                    "node_name": node_name,
                    "node_uuid": node_uuid,
                    "component_uuid": e.get("component_uuid"),
                    "view_id": e.get("view_id"),
                    "cluster_uuid": e.get("cluster_uuid"),
                    "view_seq": e.get("view_seq"),
                    "member_role": e.get("member_role"),
                    "component_state": e.get("component_state"),
                    "members": e.get("members"),
                    "joined": e.get("joined"),
                    "left": e.get("left"),
                    "partitioned": e.get("partitioned"),
                    "cluster_ref": e.get("cluster_ref"),
                    "timestamp": to_iso_string(ts),
                })
        # Add other time-varying entity types as needed

        # --- Build frame: join latest state for all entities up to this timestamp ---

        def filter_props(d):
            return {k: v for k, v in d.items() if k not in ("line_number", "log_source", "raw_line")}

        def get_node_state_at_timestamp(node_key: str, target_ts: datetime) -> Dict[str, Any]:
            """Get the node state that was active at the given timestamp."""
            node_states = state_machine.get("node_state", {}).get(node_key, [])
            if not node_states:
                return {}
            
            # Find the most recent state at or before the target timestamp
            applicable_state = {}
            for timestamped_state in node_states:
                state_ts = parse_iso(timestamped_state["timestamp"])
                if state_ts and state_ts <= target_ts:
                    applicable_state = timestamped_state["state"]
                else:
                    break  # States are ordered by timestamp
            
            return applicable_state

        def get_node_uuid_at_timestamp(node_key: str, target_ts: datetime) -> Optional[str]:
            """Get the node UUID that was active at the given timestamp."""
            node_uuids = state_machine.get("node_uuid", {}).get(node_key, [])
            if not node_uuids:
                return None
                
            # Find the most recent UUID at or before the target timestamp
            applicable_uuid = None
            for timestamped_uuid in node_uuids:
                uuid_ts = parse_iso(timestamped_uuid["timestamp"])
                if uuid_ts and uuid_ts <= target_ts:
                    applicable_uuid = timestamped_uuid["uuid"]
                else:
                    break  # UUIDs are ordered by timestamp
            
            return applicable_uuid

        frame_nodes = {}
        for node_key, node_core in node_immutable.items():
            node_state = filter_props(dict(node_core))  # Make a deep copy
            # Overlay node_state properties that were active at this timestamp
            if ts is not None:
                ns = get_node_state_at_timestamp(node_key, ts)
                for k, v in ns.items():
                    if k not in node_state:
                        node_state[k] = v
                
                # For v3 compatibility: if from_state and to_state exist, also set node_state to to_state
                # This ensures backward compatibility with v2 visualization code
                if 'to_state' in ns and 'node_state' not in node_state:
                    node_state['node_state'] = ns['to_state']
                
                # Override UUID with time-aware UUID - ONLY for this specific node
                time_aware_uuid = get_node_uuid_at_timestamp(node_key, ts)
                if time_aware_uuid:
                    node_state["node_uuid"] = time_aware_uuid
                # Debug: print UUID assignment
                # if to_iso_string(ts) == "2025-09-23T10:30:56":
                #     print(f"DEBUG: Assigning UUID {time_aware_uuid} to node {node_key} at {to_iso_string(ts)}")
            node_state = filter_props(node_state)
            # Overlay latest node view snapshot if available
            nv = state_machine.get("node_view", {}).get(node_key)
            if not nv and node_state.get("node_uuid"):
                nv = state_machine.get("node_view", {}).get(node_state.get("node_uuid"))
            if nv:
                view_payload = {
                    "view_id": nv.get("view_id"),
                    "view_seq": nv.get("view_seq"),
                    "cluster_uuid": nv.get("cluster_uuid"),
                    "component_uuid": nv.get("component_uuid"),
                    "member_role": nv.get("member_role"),
                    "component_state": nv.get("component_state"),
                    "members": nv.get("members"),
                    "joined": nv.get("joined"),
                    "left": nv.get("left"),
                    "partitioned": nv.get("partitioned"),
                    "view_layer": nv.get("view_layer", "gcomm"),
                    "timestamp": nv.get("timestamp"),
                }
                # Drop keys that have no value to keep JSON tidy
                view_payload = {k: v for k, v in view_payload.items() if v is not None}
                if view_payload:
                    node_state.setdefault("gcomm_view", view_payload)
            frame_nodes[node_key] = node_state

        frame_clusters = {}
        for cluster_key, cluster_core in cluster_immutable.items():
            cluster_state = filter_props(dict(cluster_core))
            # Overlay latest view properties if present
            view = state_machine.get("view", {}).get(cluster_key, {})
            for k, v in view.items():
                if k not in cluster_state:
                    cluster_state[k] = v
            cluster_state = filter_props(cluster_state)
            cluster_state["nodes_view"] = {
                key: filter_props(value)
                for key, value in state_machine.get("node_view", {}).items()
                if value.get("cluster_ref") == cluster_key
            }
            frame_clusters[cluster_key] = cluster_state

        frame_views = {}
        view_sm = state_machine.get("view", {})
        for cluster_key, view_state in view_sm.items():
            layer_payloads: Dict[str, Dict[str, Any]] = {}
            
            # Handle wsrep_view layer - find the view active at current timestamp
            wsrep_history = view_state.get("wsrep_view_history", [])
            if wsrep_history and ts is not None:
                # Find the most recent wsrep view at or before this timestamp
                applicable_wsrep = None
                for view_entry in wsrep_history:
                    view_ts = parse_iso(view_entry.get("timestamp"))
                    if view_ts and view_ts <= ts:
                        applicable_wsrep = view_entry
                    else:
                        break  # Views are ordered by timestamp
                
                if applicable_wsrep:
                    wsrep_filtered = filter_props(dict(applicable_wsrep))
                    details = wsrep_filtered.pop("member_details", None)
                    if isinstance(details, list):
                        summary: List[str] = []
                        for detail in details:
                            if not isinstance(detail, dict):
                                continue
                            idx = detail.get("index")
                            node_name = detail.get("node_name")
                            uuid = detail.get("uuid")
                            label = ""
                            if node_name and not _is_placeholder_name(node_name):
                                label = node_name
                                if uuid:
                                    label = f"{node_name} ({uuid})"
                            elif uuid:
                                label = uuid
                            if idx is not None:
                                if label:
                                    label = f"{idx}: {label}"
                                else:
                                    label = f"{idx}:"
                            if label:
                                summary.append(label)
                        if summary:
                            wsrep_filtered["member_summary"] = summary
                    wsrep_filtered["view_layer"] = "wsrep"
                    layer_payloads["wsrep"] = wsrep_filtered
            
            # Handle gcomm view layer - find the view active at current timestamp
            gcomm_history = view_state.get("gcomm_view_history", [])
            if gcomm_history and ts is not None:
                # Find the most recent gcomm view at or before this timestamp
                applicable_gcomm = None
                for view_entry in gcomm_history:
                    view_ts = parse_iso(view_entry.get("timestamp"))
                    if view_ts and view_ts <= ts:
                        applicable_gcomm = view_entry
                    else:
                        break  # Views are ordered by timestamp
                
                if applicable_gcomm:
                    gcomm_filtered = filter_props(dict(applicable_gcomm))
                    gcomm_filtered["view_layer"] = "gcomm"
                    layer_payloads["gcomm"] = gcomm_filtered
            
            if layer_payloads:
                frame_views[cluster_key] = layer_payloads

        # --- Add quorum section: use the latest quorum entity (by timestamp) for this cluster, if any ---
        cluster_keys = list(frame_clusters.keys())
        quorum_section = None
        quorum_sm = state_machine.get("quorum", {})
        best_ts = None
        for ck in cluster_keys:
            c = frame_clusters[ck]
            for qk in [c.get("group_uuid"), c.get("cluster_uuid"), ck]:
                if qk and qk in quorum_sm:
                    qent = quorum_sm[qk]
                    qts = qent.get("timestamp")
                    if qts:
                        if best_ts is None or (qts > best_ts):
                            quorum_section = qent
                            best_ts = qts
        # If no timestamped quorum found, fallback to any match
        if quorum_section is None:
            for ck in cluster_keys:
                c = frame_clusters[ck]
                for qk in [c.get("group_uuid"), c.get("cluster_uuid"), ck]:
                    if qk and qk in quorum_sm:
                        quorum_section = quorum_sm[qk]
                        break
                if quorum_section:
                    break

        hotspots: Dict[str, Any] = {}

        # Cluster-level NON_PRIMARY detection (cluster + view layers)
        cluster_non_primary: List[Dict[str, Any]] = []
        cluster_seen: Set[Tuple[str, str, Optional[str]]] = set()
        for cluster_key, cluster_state in frame_clusters.items():
            state_candidate = (
                cluster_state.get("cluster_state")
                or cluster_state.get("component_state")
                or cluster_state.get("status")
            )
            state_norm = _normalize_cluster_state(state_candidate)
            if state_norm == "NON_PRIM":
                sig = (cluster_key, "cluster", None)
                if sig not in cluster_seen:
                    cluster_seen.add(sig)
                    cluster_non_primary.append({
                        "cluster": cluster_key,
                        "layer": "cluster",
                        "state": state_norm,
                        "view_id": cluster_state.get("view_id"),
                    })
        for cluster_key, layer_map in frame_views.items():
            if not isinstance(layer_map, dict):
                continue
            for layer_name, payload in layer_map.items():
                state_candidate = (
                    payload.get("cluster_state")
                    or payload.get("component_state")
                    or payload.get("status")
                )
                state_norm = _normalize_cluster_state(state_candidate)
                if state_norm == "NON_PRIM":
                    sig = (cluster_key, layer_name or "view", payload.get("view_id") or str(payload.get("view_seq")))
                    if sig not in cluster_seen:
                        cluster_seen.add(sig)
                        cluster_non_primary.append({
                            "cluster": cluster_key,
                            "layer": (layer_name or "view"),
                            "state": state_norm,
                            "view_id": payload.get("view_id"),
                            "view_seq": payload.get("view_seq"),
                        })
        if cluster_non_primary:
            hotspots["cluster_non_primary"] = cluster_non_primary

        # Node-level hotspot detection - non-member or NON_PRIM component state
        node_non_member: List[Dict[str, Any]] = []
        node_component_non_primary: List[Dict[str, Any]] = []
        node_non_member_seen: Set[Tuple[str, Optional[str], Optional[str]]] = set()
        node_comp_seen: Set[Tuple[str, Optional[str]]] = set()
        for node_key, node_state in frame_nodes.items():
            gcomm = node_state.get("gcomm_view") or {}
            if not gcomm:
                continue
            display_name = node_state.get("node_name") or node_key
            member_role = str(gcomm.get("member_role") or "").strip().lower()
            if member_role and member_role != "member":
                sig = (display_name, member_role, gcomm.get("view_id"))
                if sig not in node_non_member_seen:
                    node_non_member_seen.add(sig)
                    node_non_member.append({
                        "node": display_name,
                        "member_role": member_role,
                        "view_id": gcomm.get("view_id"),
                        "component_state": _normalize_cluster_state(gcomm.get("component_state")),
                    })
            comp_state = _normalize_cluster_state(gcomm.get("component_state"))
            if comp_state == "NON_PRIM":
                sig = (display_name, gcomm.get("view_id"))
                if sig not in node_comp_seen:
                    node_comp_seen.add(sig)
                    node_component_non_primary.append({
                        "node": display_name,
                        "component_state": comp_state,
                        "view_id": gcomm.get("view_id"),
                        "member_role": member_role or None,
                    })
        if node_non_member:
            hotspots["node_non_member"] = node_non_member
        if node_component_non_primary:
            hotspots["node_component_non_primary"] = node_component_non_primary

        frame = {
            "index": idx,
            "event": {
                "entity_type": et,
                "entity_id": eid,
                "timestamp": to_iso_string(ts),
                "line_number": e.get("line_number"),
                "cluster_ref": e.get("cluster_ref"),
            },
            "nodes": frame_nodes,
            "clusters": frame_clusters,
            "views": frame_views,
            "quorum": quorum_section,
        }
        if hotspots:
            frame["hotspots"] = hotspots
        frames.append(frame)

    return frames



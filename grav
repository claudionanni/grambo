from flask import Flask, render_template, request, jsonify
import json

import os
import argparse

app = Flask(__name__)

FRAMES = []
SST_REPORT_PATH = None
SOURCE_LOG_FILES = []
TIMELINE_HOTSPOTS = {
    "cluster_non_primary": [],
    "node_non_member": [],
    "node_component_non_primary": [],
    "sst_operations": []
}


def summarize_hotspots(frames):
    summary = {
        "cluster_non_primary": [],
        "node_non_member": [],
        "node_component_non_primary": [],
        "sst_operations": []
    }
    for idx, frame in enumerate(frames or []):
        hotspots = frame.get('hotspots') or {}
        for item in hotspots.get('cluster_non_primary') or []:
            entry = dict(item)
            entry['index'] = idx
            summary['cluster_non_primary'].append(entry)
        for item in hotspots.get('node_non_member') or []:
            entry = dict(item)
            entry['index'] = idx
            summary['node_non_member'].append(entry)
        for item in hotspots.get('node_component_non_primary') or []:
            entry = dict(item)
            entry['index'] = idx
            summary['node_component_non_primary'].append(entry)
        
        # Detect SST operations (DONOR + JOINER in same frame)
        nodes = frame.get('nodes', {})
        donors = []
        joiners = []
        for node_name, node_data in nodes.items():
            # Use to_state if available (v3), fallback to node_state (v2)
            node_state = (node_data.get('to_state') or node_data.get('node_state', '')).upper()
            if 'DONOR' in node_state or 'DESYNCED' in node_state:
                donors.append(node_name)
            elif node_state == 'JOINER':
                joiners.append(node_name)
        
        if donors and joiners:
            # Create SST hotspot entry
            summary['sst_operations'].append({
                'index': idx,
                'donors': donors,
                'joiners': joiners,
                'description': f"SST: {', '.join(donors)} → {', '.join(joiners)}"
            })
    
    return summary


def refresh_hotspot_cache():
    global TIMELINE_HOTSPOTS
    TIMELINE_HOTSPOTS = summarize_hotspots(FRAMES)

def propagate_node_states(frames):
    """Propagate latest to_state/node_state for each node across all frames."""
    latest_node_states = {}
    for frame in frames:
        nodes = frame.get('nodes', {})
        # Update node states if present in this frame
        for node_name, node_props in nodes.items():
            # Prefer to_state (v3), fallback to node_state (v2)
            if 'to_state' in node_props:
                latest_node_states[node_name] = node_props['to_state']
            elif 'node_state' in node_props:
                latest_node_states[node_name] = node_props['node_state']
        # Propagate to_state/node_state to all nodes in this frame
        for node_name, node_props in nodes.items():
            if 'to_state' not in node_props and 'node_state' not in node_props and node_name in latest_node_states:
                node_props = dict(node_props)  # copy to avoid mutating original
                # Set to_state (v3 format)
                node_props['to_state'] = latest_node_states[node_name]
                # Also set node_state for backward compatibility
                node_props['node_state'] = latest_node_states[node_name]
                nodes[node_name] = node_props
    return frames

def _load_sst_report() -> str | None:
    global SST_REPORT_PATH
    if not SST_REPORT_PATH:
        return None
    try:
        with open(SST_REPORT_PATH, 'r', encoding='utf-8') as fh:
            return fh.read()
    except OSError:
        return None


@app.route('/')
def index():
    report_available = bool(SST_REPORT_PATH and os.path.exists(SST_REPORT_PATH))
    return render_template(
        'index.html',
        total_frames=len(FRAMES),
        sst_available=report_available,
        timeline_hotspots=TIMELINE_HOTSPOTS
    )


@app.route('/sst')
def sst_report():
    report_text = _load_sst_report()
    if report_text is None:
        return render_template('sst.html', report_text=None)
    if request.args.get('download'):
        return app.response_class(
            report_text,
            mimetype='text/plain',
            headers={'Content-Disposition': 'attachment; filename="graa_sst_report.txt"'}
        )
    return render_template('sst.html', report_text=report_text)

@app.route('/frame/<int:idx>')
def get_frame(idx):
    if 0 <= idx < len(FRAMES):
        # Collect all entities from 'entities', 'nodes', 'clusters', and derived views
        frame = FRAMES[idx]
        all_entities = {}
        for key in ('entities', 'nodes', 'clusters'):
            ents = frame.get(key, {})
            if ents:
                for ent_name, ent_props in ents.items():
                    all_entities[f"{key[:-1]}:{ent_name}"] = ent_props
        views = frame.get('views', {})
        for cluster_key, layer_map in (views or {}).items():
            if not isinstance(layer_map, dict):
                continue
            for layer_name, props in layer_map.items():
                entry = dict(props)
                entry.setdefault('cluster_ref', cluster_key)
                entry.setdefault('view_layer', layer_name)
                composite_key = f"view:{cluster_key}:{layer_name}"
                all_entities[composite_key] = entry
        # Inject quorum entity if present (as 'quorum:<id>' or 'quorum:main')
        quorum = frame.get('quorum')
        if quorum:
            quorum_id = quorum.get('entity_id') or 'main'
            all_entities[f'quorum:{quorum_id}'] = quorum
        # Determine frame timestamp: prefer frame['timestamp'], else event timestamp, else None
        frame_ts = frame.get('timestamp')
        if not frame_ts and 'event' in frame and frame['event'].get('timestamp'):
            frame_ts = frame['event']['timestamp']
        return jsonify({
            'idx': idx,
            'total': len(FRAMES),
            'entities': all_entities,
            'timestamp': frame_ts,
            'hotspots': frame.get('hotspots'),
            'log_files': SOURCE_LOG_FILES
        })
    return jsonify({'error': 'Frame out of range'}), 404

@app.route('/logs/<path:log_path>')
def get_log_context(log_path):
    """Get log lines around a specific timestamp"""
    timestamp = request.args.get('timestamp')
    context_lines = int(request.args.get('context', 30))
    
    if not timestamp:
        return jsonify({'error': 'timestamp parameter required'}), 400
    
    try:
        # Find the log file
        log_file_path = None
        for log_file in SOURCE_LOG_FILES:
            if log_file['path'] == log_path:
                log_file_path = log_file['path']
                break
        
        if not log_file_path or not os.path.exists(log_file_path):
            return jsonify({'error': 'Log file not found'}), 404
        
        # Read the log file and find lines around the timestamp
        lines = []
        target_line_idx = None
        
        # Clean the timestamp for better matching
        # Handle different timestamp formats: "2025-09-24T08:39:36" -> "2025-09-24 08:39:36"
        search_timestamp = timestamp.replace('T', ' ').replace('Z', '')
        # Also try just the time part if full timestamp doesn't match
        time_part = search_timestamp.split(' ')[-1] if ' ' in search_timestamp else search_timestamp
        
        with open(log_file_path, 'r', encoding='utf-8', errors='ignore') as f:
            for line_num, line in enumerate(f, 1):
                line = line.rstrip('\n\r')
                
                # Try multiple timestamp matching strategies
                line_matches = (
                    search_timestamp in line or           # Full timestamp match
                    time_part in line or                  # Time part match
                    timestamp in line                     # Original timestamp format
                )
                
                if line_matches and target_line_idx is None:
                    target_line_idx = len(lines)
                
                lines.append({
                    'line_number': line_num,
                    'text': line,
                    'is_target': False
                })
        
        # If we found a target line, extract context around it
        if target_line_idx is not None:
            start_idx = max(0, target_line_idx - context_lines)
            end_idx = min(len(lines), target_line_idx + context_lines + 1)
            context_lines_data = lines[start_idx:end_idx]
            
            # Mark the target line(s) - there might be multiple lines with the same timestamp
            target_line_num = lines[target_line_idx]['line_number']
            for line_data in context_lines_data:
                # Mark line if it contains the timestamp
                if (search_timestamp in line_data['text'] or 
                    time_part in line_data['text'] or 
                    timestamp in line_data['text']):
                    line_data['is_target'] = True
        else:
            # If no exact match, try to find the closest timestamp
            # This is a fallback for when exact matching fails
            context_lines_data = lines[:min(len(lines), context_lines * 2)] if lines else []
        
        return jsonify({
            'lines': context_lines_data,
            'target_timestamp': timestamp,
            'search_timestamp': search_timestamp,
            'total_lines': len(lines),
            'found_target': target_line_idx is not None
        })
        
    except Exception as e:
        return jsonify({'error': f'Error reading log file: {str(e)}'}), 500

@app.route('/load', methods=['POST'])
def load_frames():
    global FRAMES
    file = request.files['file']
    if not file:
        return 'No file uploaded', 400
    content = file.read().decode('utf-8')
    try:
        if content.strip().startswith('{'):
            FRAMES = [json.loads(line) for line in content.splitlines() if line.strip()]
        else:
            FRAMES = json.loads(content)
        FRAMES = propagate_node_states(FRAMES)
        refresh_hotspot_cache()
    except Exception as e:
        return f'Error parsing file: {e}', 400
    return 'OK', 200

def load_frames_from_file(path):
    with open(path, 'r') as f:
        content = f.read()
        if content.strip().startswith('{'):
            frames = [json.loads(line) for line in content.splitlines() if line.strip()]
        else:
            frames = json.loads(content)
        return propagate_node_states(frames)

if __name__ == '__main__':
    parser = argparse.ArgumentParser(description='grav web visualizer')
    parser.add_argument('--frames', type=str, help='graf output file (json or ndjson) to load at startup')
    parser.add_argument('--sst-report', type=str, help='graa --sst report file to expose via the SST viewer')
    parser.add_argument('--logs', type=str, nargs='*', help='source log files to make available for context viewing')
    parser.add_argument('--host', type=str, default='127.0.0.1')
    parser.add_argument('--port', type=int, default=5000)
    args = parser.parse_args()

    if args.frames:
        FRAMES = load_frames_from_file(args.frames)
        refresh_hotspot_cache()
    if args.sst_report:
        SST_REPORT_PATH = args.sst_report
    if args.logs:
        SOURCE_LOG_FILES = [
            {'path': log_path, 'name': os.path.basename(log_path)}
            for log_path in args.logs
            if os.path.exists(log_path)
        ]
    app.run(debug=True, host=args.host, port=args.port)

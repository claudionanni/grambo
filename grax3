#!/usr/bin/env python3
"""GRAX3 - end-to-end Galera analysis pipeline helper (v3).

This utility orchestrates the standard v3 analysis workflow:

    graa --sst <logs>  →  SST session summary
    grap3 --format=json <logs>  →  Structured entities
    graf3 <grap.json> --ndjson  →  Timeline frames
    grav3 --frames=<frames.ndjson> --sst-report=<sst.txt>

Example usage:

    ./grax3 11407/error.11407.log jfd/*.log

You can override the output directory or skip launching the grav3 web UI via
command-line options. Run with --help for details.
"""

from __future__ import annotations

import argparse
import os
import shlex
import subprocess
import sys
from pathlib import Path
from typing import Iterable, List, Optional

ROOT_DIR = Path(__file__).resolve().parent
GRAA = ROOT_DIR / "graa"
GRAP = ROOT_DIR / "grap3"
GRAF = ROOT_DIR / "graf3"
GRAV = ROOT_DIR / "grav3"


def format_cmd(cmd: Iterable[str]) -> str:
    return " ".join(shlex.quote(str(part)) for part in cmd)


def run_step(cmd: List[str], *, stdout=None) -> None:
    print(f"[grax] running: {format_cmd(cmd)}")
    subprocess.run(cmd, check=True, stdout=stdout)


def main(argv: List[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description="Run graa → grap3 → graf3 → grav3 in sequence",
    )
    parser.add_argument(
        "logs",
        nargs=argparse.ONE_OR_MORE,
        help="One or more Galera log files to process"
    )
    parser.add_argument(
        "--output-dir",
        default="grax_output",
        help="Directory for generated artifacts (default: %(default)s)",
    )
    parser.add_argument(
        "--sst-report-name",
        default="graa_sst.txt",
        help="Filename for the graa --sst report (default: %(default)s)",
    )
    parser.add_argument(
        "--grap-output-name",
        default="grap_output.json",
        help="Filename for the grap JSON output (default: %(default)s)",
    )
    parser.add_argument(
        "--frames-output-name",
        default="graf_frames.ndjson",
        help="Filename for the graf3 frames output (default: %(default)s)",
    )
    parser.add_argument(
        "--use-cache",
        action="store_false",
        dest="no_cache",
        help="Allow grap to reuse its cache (default: disabled)",
    )
    parser.add_argument(
        "--python",
        help="Python interpreter to use for the pipeline (default: auto-detect .venv or current)",
    )
    parser.set_defaults(no_cache=True)
    parser.add_argument(
        "--no-serve",
        action="store_true",
        help="Skip launching the grav3 web UI",
    )
    parser.add_argument(
        "--host",
        default="127.0.0.1",
        help="Host interface for grav3 (default: %(default)s)",
    )
    parser.add_argument(
        "--port",
        type=int,
        default=5000,
        help="TCP port for grav (default: %(default)s)",
    )

    args = parser.parse_args(argv)

    output_dir = Path(args.output_dir).resolve()
    output_dir.mkdir(parents=True, exist_ok=True)

    sst_path = output_dir / args.sst_report_name
    sst_json_path = output_dir / "sst_sessions.json"  # Add SST JSON output
    grap_path = output_dir / args.grap_output_name
    frames_path = output_dir / args.frames_output_name

    def select_python(explicit: Optional[str]) -> str:
        if explicit:
            return explicit
        candidates = []
        if os.name == "nt":
            candidates.extend([
                ROOT_DIR / ".venv" / "Scripts" / "python.exe",
                ROOT_DIR / "venv" / "Scripts" / "python.exe",
            ])
        else:
            candidates.extend([
                ROOT_DIR / ".venv" / "bin" / "python3",
                ROOT_DIR / ".venv" / "bin" / "python",
                ROOT_DIR / "venv" / "bin" / "python3",
                ROOT_DIR / "venv" / "bin" / "python",
            ])
        for candidate in candidates:
            if candidate.exists() and os.access(candidate, os.X_OK):
                return str(candidate)
        return sys.executable

    python_cmd = select_python(args.python)
    print(f"[grax] using python interpreter: {python_cmd}")

    # Step 1: graa --sst (per log file, appended)
    with sst_path.open("w", encoding="utf-8") as sst_file:
        for idx, log_path in enumerate(args.logs, start=1):
            if idx > 1:
                sst_file.write("\n" + ("=" * 80) + "\n\n")
            sst_file.write(f"GRAA --sst report for {log_path}\n")
            sst_file.write("-" * 80 + "\n")
            graa_cmd = [python_cmd, str(GRAA), "--sst", str(log_path)]
            run_step(graa_cmd, stdout=sst_file)
            sst_file.flush()
    print(f"[grax] SST report saved to {sst_path}")

    # Step 1.5: graa --sst --json (for GRAV frontend integration)
    graa_json_cmd = [python_cmd, str(GRAA), "--sst", "--json", *map(str, args.logs)]
    with sst_json_path.open("w", encoding="utf-8") as sst_json_file:
        run_step(graa_json_cmd, stdout=sst_json_file)
    print(f"[grax] SST JSON data saved to {sst_json_path}")

    # Step 2: grap
    grap_cmd: List[str] = [python_cmd, str(GRAP)]
    grap_cmd.extend(["--format=json", *map(str, args.logs)])
    with grap_path.open("w", encoding="utf-8") as grap_file:
        run_step(grap_cmd, stdout=grap_file)
    print(f"[grax] GRAP JSON saved to {grap_path}")

    # Step 3: graf
    graf_cmd = [python_cmd, str(GRAF), str(grap_path), "--ndjson", "-o", str(frames_path)]
    run_step(graf_cmd)
    print(f"[grax] Frames written to {frames_path}")

    if args.no_serve:
        print("[grax] Skipping grav launch (--no-serve requested)")
        return 0

    grav_cmd = [
        python_cmd,
        str(GRAV),
        f"--frames={frames_path}",
        f"--sst-report={sst_path}",
        f"--sst-json={sst_json_path}",  # Pass SST JSON to grav
        f"--host={args.host}",
        f"--port={args.port}",
        "--logs",
        *map(str, args.logs)
    ]
    print(f"[grax] launching grav with frames and SST report…")
    run_step(grav_cmd)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

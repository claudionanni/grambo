# MariaDB pads the hour with a space before 10:00 ("2025-05-13  1:56:24") and
# mysqld_safe uses the short "250513  1:56:24" form. Every line is rewritten to
# "YYYY-MM-DD HH:MM:SS" on input so that patterns and sorting see one format.
_TS_LONG = re.compile(r'^(\d{4}-\d{2}-\d{2})\s+(\d{1,2}):(\d{2}:\d{2})')
_TS_SHORT = re.compile(r'^(\d{2})(\d{2})(\d{2})\s+(\d{1,2}):(\d{2}:\d{2})(?=\s)')
_TS_START = re.compile(r'^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}')
# wsrep_sst_* scripts put their own time at the end: "(20250513 01:56:30.123)"
_TS_SST_SCRIPT = re.compile(r'\((\d{4})(\d{2})(\d{2})\s+(\d{1,2}):(\d{2}:\d{2})\.\d+\)\s*$')


def normalize_timestamp(line: str) -> str:
    """Rewrite the leading timestamp of a log line to YYYY-MM-DD HH:MM:SS."""
    m = _TS_LONG.match(line)
    if m:
        return f"{m.group(1)} {m.group(2).zfill(2)}:{m.group(3)}{line[m.end():]}"
    m = _TS_SHORT.match(line)
    if m:
        return (f"20{m.group(1)}-{m.group(2)}-{m.group(3)} "
                f"{m.group(4).zfill(2)}:{m.group(5)}{line[m.end():]}")
    return line


@dataclass
class Pattern:
    """Simple pattern definition"""
    pattern_id: str
    regex: str
    entity_type: str
    priority: int
    context: str  # LOCAL, GLOBAL, PEER
    extract_fields: Dict[str, str]
    computed_fields: Dict[str, Any]
    confidence: float = 0.9
    
    def __post_init__(self):
        self.compiled_regex = re.compile(self.regex, re.IGNORECASE)


class EntityExtractor:
    """
    Lightweight entity extractor with full pattern coverage
    Compatible with graf frame generation
    """
    
    def __init__(self):
        self.local_node_name = None
        self.local_node_uuid = None
        self.cluster_uuid = None
        
        # Node tracking with UUID history (physical nodes)
        self.nodes = {}  # node_name -> {name, long_uuid, uuid_history, cluster_uuid, node_address, versions}
        self.uuid_to_node = {}  # uuid (all forms) -> node_name
        
        # Timestamp indexing for frame generation
        self.timestamp_indices = defaultdict(int)
        
        # Entity storage
        self.core_entities = {}  # For final node entities only
        self.temporal_entities = []  # List of temporal entities in order
        
        # Multi-line view parsing state
        self.view_buffer = None
        self.view_start_line = 0
        
        # Multi-line wsrep view parsing state
        self.wsrep_view_buffer = None
        self.wsrep_view_start_line = 0

        # Multi-line "Quorum results:" parsing state
        self.quorum_buffer = None

        # Last timestamp seen in the current file, for lines that carry none
        self.last_timestamp = None
        
        # Load patterns
        self.patterns = self._load_patterns()
    
    def _load_patterns(self) -> List[Pattern]:
        """Load all extraction patterns"""
        patterns = []
        
        # ==================================================================
        # NODE STATE CHANGE PATTERNS
        # ==================================================================
        
        patterns.append(Pattern(
            pattern_id="node_state_shifting",
            regex=r'(\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2})\s+\d+\s+\[Note\]\s+WSREP:\s+Shifting\s+(CLOSED|OPEN|PRIMARY|JOINER|JOINED|SYNCED|DONOR/DESYNCED|DONOR|DESYNCED)\s+->\s+(CLOSED|OPEN|PRIMARY|JOINER|JOINED|SYNCED|DONOR/DESYNCED|DONOR|DESYNCED)',
            entity_type="node_state",
            priority=100,
            context="LOCAL",
            extract_fields={
                1: "timestamp",
                2: "from_state",
                3: "to_state"
            },
            computed_fields={
                "transition_type": "LOCAL_SHIFT"
            },
            confidence=0.98
        ))
        
        patterns.append(Pattern(
            pattern_id="node_state_restored",
            regex=r'(\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2})\s+\d+\s+\[Note\]\s+WSREP:\s+Restored\s+state\s+(CLOSED|OPEN|PRIMARY|JOINER|JOINED|SYNCED|DONOR/DESYNCED|DONOR|DESYNCED)\s+->\s+(CLOSED|OPEN|PRIMARY|JOINER|JOINED|SYNCED|DONOR/DESYNCED|DONOR|DESYNCED)',
            entity_type="node_state",
            priority=95,
            context="LOCAL",
            extract_fields={
                1: "timestamp",
                2: "from_state",
                3: "to_state"
            },
            computed_fields={
                "transition_type": "RESTORED"
            },
            confidence=0.96
        ))
        
        # REMOVED: server_status_change pattern - captures non-canonical states
        # Only track canonical states from Shifting pattern: CLOSED, OPEN, DONOR/DESYNCED, JOINED, SYNCED, JOINER, PRIMARY
        # Non-canonical states like joiner->initializing, initializing->initialized are filtered out
        
        # REMOVED: synchronized_with_group pattern - uses non-canonical JOINING state  
        # Only track canonical states from Shifting pattern: CLOSED, OPEN, DONOR/DESYNCED, JOINED, SYNCED, JOINER, PRIMARY
        
        # REMOVED: ready_for_connections pattern - uses non-canonical INITIALIZING state
        # Only track canonical states from Shifting pattern: CLOSED, OPEN, DONOR/DESYNCED, JOINED, SYNCED, JOINER, PRIMARY
        
        # Logged by every member when a node reaches SYNCED, e.g.
        #   WSREP: Member 0.0 (node-1) synced with group.
        # It is the only state information available for nodes whose own log
        # is not part of the analysis.
        patterns.append(Pattern(
            pattern_id="member_synced",
            regex=r'(\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2}).*WSREP:\s+Member\s+\d+\.\d+\s+\(([A-Za-z0-9_.-]+)\)\s+synced\s+with\s+group',
            entity_type="node_state",
            priority=85,
            context="PEER",
            extract_fields={
                1: "timestamp",
                2: "node_name"
            },
            computed_fields={
                "to_state": "SYNCED",
                "transition_type": "MEMBER_SYNCED"
            },
            confidence=0.90
        ))
        
        # ==================================================================
        # CLUSTER VIEW PATTERNS
        # ==================================================================
        

        
        # Remove the old simple view pattern since we're doing multi-line parsing
        # patterns.append(Pattern(
        #     pattern_id="view_change_gcomm",
        #     ...
        # ))
        
        patterns.append(Pattern(
            pattern_id="view_empty",
            regex=r'(\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2})\s+\d+\s+\[Note\]\s+WSREP:\s+view\(\(empty\)\)',
            entity_type="view",
            priority=95,
            context="GLOBAL",
            extract_fields={
                1: "timestamp"
            },
            computed_fields={
                "cluster_state": "EMPTY",
                "view_layer": "gcomm",
                "member_count": 0,
                "members": [],
                "joined": [],
                "left": [],
                "partitioned": [],
                "view_uuid": "empty",  # Add placeholder to avoid null cluster_ref
                "view_id": "empty"
            },
            confidence=0.98
        ))
        
        
        # ==================================================================
        # QUORUM EVENT PATTERNS
        # ==================================================================
        
        # gcs logs one "New COMPONENT" line for every membership change this node
        # takes part in (gcs_group.cpp, gcs_group_handle_comp_msg). It states
        # whether the node's component is primary and how many members it has,
        # before any state exchange. The outcome of the state exchange is the
        # multi-line "Quorum results:" block, parsed in _parse_quorum_block.
        patterns.append(Pattern(
            pattern_id="component_change",
            regex=r'(\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2}).*WSREP:\s+(New\s+COMPONENT:\s+primary\s+=\s+(yes|no),\s+bootstrap\s+=\s+(yes|no),\s+my_idx\s+=\s+(-?\d+),\s+memb_num\s+=\s+(\d+))',
            entity_type="quorum",
            priority=100,
            context="LOCAL",
            extract_fields={
                1: "timestamp",
                2: "event_text",
                3: "component_primary",
                4: "bootstrap",
                5: "my_idx",
                6: "member_count"
            },
            computed_fields={
                "event_type": "COMPONENT"
            },
            confidence=0.99
        ))
        
        
        # ==================================================================
        # STATE TRANSFER PATTERNS
        # ==================================================================
        
        patterns.append(Pattern(
            pattern_id="sst_started",
            regex=r'(\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2}).*WSREP:.*Requesting\s+(?:state transfer|SST)(?::\s*(\w+))?',
            entity_type="sst",
            priority=100,
            context="LOCAL",
            extract_fields={
                1: "timestamp",
                2: "method"
            },
            computed_fields={
                "transfer_type": "SST",
                "status": "STARTED",
                "event_type": "started"
            },
            confidence=0.95
        ))
        
        patterns.append(Pattern(
            pattern_id="sst_donor_selected",
            regex=r'(\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2}).*Member\s+\d+\.\d+\s+\(([A-Za-z0-9_.-]+)\)\s+requested\s+state\s+transfer.*Selected\s+\d+\.\d+\s+\(([A-Za-z0-9_.-]+)\)',
            entity_type="sst",
            priority=95,
            context="GLOBAL",
            extract_fields={
                1: "timestamp",
                2: "joiner_name",
                3: "donor_name"
            },
            computed_fields={
                "transfer_type": "SST",
                "status": "DONOR_SELECTED",
                "event_type": "donor_selected"
            },
            confidence=0.90
        ))
        
        # Joiner side: the SST script handed the received position back to Galera
        #   WSREP: SST received: <group uuid>:<seqno>
        patterns.append(Pattern(
            pattern_id="sst_received",
            regex=r'(\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2}).*WSREP:\s+SST\s+received:\s+([a-f0-9-]+):(-?\d+)',
            entity_type="sst",
            priority=100,
            context="LOCAL",
            extract_fields={
                1: "timestamp",
                2: "state_uuid",
                3: "end_seqno"
            },
            computed_fields={
                "transfer_type": "SST",
                "status": "RECEIVED",
                "event_type": "received",
                "role": "joiner"
            },
            confidence=0.98
        ))

        # Donor side: WSREP: SST sent: <group uuid>:<seqno>
        patterns.append(Pattern(
            pattern_id="sst_sent",
            regex=r'(\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2}).*WSREP:\s+SST\s+sent:\s+([a-f0-9-]+):(-?\d+)',
            entity_type="sst",
            priority=100,
            context="LOCAL",
            extract_fields={
                1: "timestamp",
                2: "state_uuid",
                3: "end_seqno"
            },
            computed_fields={
                "transfer_type": "SST",
                "status": "SENT",
                "event_type": "sent",
                "role": "donor"
            },
            confidence=0.98
        ))

        # Donor side failure: WSREP: SST sending failed: -32
        patterns.append(Pattern(
            pattern_id="sst_sending_failed",
            regex=r'(\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2}).*WSREP:\s+SST\s+sending\s+failed:\s+(-?\d+)',
            entity_type="sst",
            priority=100,
            context="LOCAL",
            extract_fields={
                1: "timestamp",
                2: "error_code"
            },
            computed_fields={
                "transfer_type": "SST",
                "status": "FAILED",
                "event_type": "failed",
                "role": "donor"
            },
            confidence=0.98
        ))

        # Any member: "<idx> (<donor>): State transfer to <idx> (<joiner>) failed: <reason>"
        # Must outrank warning_wsrep, which would otherwise file it as a generic warning.
        patterns.append(Pattern(
            pattern_id="sst_transfer_failed",
            regex=r'(\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2}).*WSREP:\s+\d+\.\d+\s+\(([A-Za-z0-9_.-]+)\):\s+State\s+transfer\s+to\s+\d+\.\d+\s+\(([A-Za-z0-9_.-]+)\)\s+failed:\s*(.*)',
            entity_type="sst",
            priority=100,
            context="GLOBAL",
            extract_fields={
                1: "timestamp",
                2: "donor_name",
                3: "joiner_name",
                4: "failure_reason"
            },
            computed_fields={
                "transfer_type": "SST",
                "status": "FAILED",
                "event_type": "failed"
            },
            confidence=0.97
        ))

        # Any member: "<idx> (<joiner>): State transfer from <idx> (<donor>) complete."
        # The joiner's own completion; the "to ... complete" line below only
        # means the donor has finished its part.
        patterns.append(Pattern(
            pattern_id="sst_transfer_joined",
            regex=r'(\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2}).*WSREP:\s+\d+\.\d+\s+\(([A-Za-z0-9_.-]+)\):\s+State\s+transfer\s+from\s+-?\d+\.-?\d+\s+\(([^)]+)\)\s+complete',
            entity_type="sst",
            priority=100,
            context="GLOBAL",
            extract_fields={
                1: "timestamp",
                2: "joiner_name",
                3: "donor_name"
            },
            computed_fields={
                "transfer_type": "SST",
                "status": "JOINED",
                "event_type": "joined"
            },
            confidence=0.97
        ))

        # Any member: "<idx> (<donor>): State transfer to <idx> (<joiner>) complete."
        patterns.append(Pattern(
            pattern_id="sst_transfer_complete",
            regex=r'(\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2}).*WSREP:\s+\d+\.\d+\s+\(([A-Za-z0-9_.-]+)\):\s+State\s+transfer\s+to\s+\d+\.\d+\s+\(([A-Za-z0-9_.-]+)\)\s+complete',
            entity_type="sst",
            priority=100,
            context="GLOBAL",
            extract_fields={
                1: "timestamp",
                2: "donor_name",
                3: "joiner_name"
            },
            computed_fields={
                "transfer_type": "SST",
                "status": "COMPLETED",
                "event_type": "complete"
            },
            confidence=0.97
        ))
        
        # SST script messages (WSREP_SST)
        patterns.append(Pattern(
            pattern_id="sst_script_completed_joiner",
            regex=r'WSREP_SST:.*mariabackup\s+SST\s+completed\s+on\s+joiner',
            entity_type="sst",
            priority=98,
            context="LOCAL",
            extract_fields={},
            computed_fields={
                "transfer_type": "SST",
                "status": "COMPLETED",
                "event_type": "complete",
                "role": "joiner"
            },
            confidence=0.95
        ))
        
        patterns.append(Pattern(
            pattern_id="sst_script_completed_donor",
            regex=r'WSREP_SST:.*mariabackup\s+SST\s+completed\s+on\s+donor',
            entity_type="sst",
            priority=98,
            context="LOCAL",
            extract_fields={},
            computed_fields={
                "transfer_type": "SST",
                "status": "COMPLETED",
                "event_type": "complete",
                "role": "donor"
            },
            confidence=0.95
        ))
        
        patterns.append(Pattern(
            pattern_id="sst_donor_time",
            regex=r'WSREP_SST:.*Total\s+time\s+on\s+donor:\s*(\d+)\s+seconds',
            entity_type="sst",
            priority=96,
            context="LOCAL",
            extract_fields={
                1: "duration_seconds"
            },
            computed_fields={
                "transfer_type": "SST",
                "status": "DONOR_STATS",
                "event_type": "donor_selected_idx",
                "role": "donor"
            },
            confidence=0.92
        ))
        
        patterns.append(Pattern(
            pattern_id="sst_donor_status_change",
            regex=r'(\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2}).*Server\s+status\s+change\s+synced\s+->\s+donor',
            entity_type="sst",
            priority=97,
            context="LOCAL",
            extract_fields={
                1: "timestamp"
            },
            computed_fields={
                "transfer_type": "SST",
                "status": "DONOR_STATUS",
                "event_type": "donor_status",
                "role": "donor"
            },
            confidence=0.93
        ))
        
        # Joiner side: WSREP: ####### IST uuid:<uuid> f: <first>, l: <last>, STRv: 3
        patterns.append(Pattern(
            pattern_id="ist_range",
            regex=r'(\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2}).*WSREP:.*IST\s+uuid:\s*([a-f0-9-]+)\s+f:\s*(-?\d+),\s*l:\s*(-?\d+)',
            entity_type="ist",
            priority=100,
            context="LOCAL",
            extract_fields={
                1: "timestamp",
                2: "state_uuid",
                3: "first_seqno",
                4: "last_seqno"
            },
            computed_fields={
                "transfer_type": "IST",
                "status": "STARTED"
            },
            confidence=0.95
        ))
        
        # Joiner side: WSREP: IST received: <uuid>:<seqno>
        patterns.append(Pattern(
            pattern_id="ist_received",
            regex=r'(\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2}).*WSREP:\s+IST\s+received:\s+([a-f0-9-]+):(-?\d+)',
            entity_type="ist",
            priority=100,
            context="LOCAL",
            extract_fields={
                1: "timestamp",
                2: "state_uuid",
                3: "last_seqno"
            },
            computed_fields={
                "transfer_type": "IST",
                "status": "COMPLETED"
            },
            confidence=0.98
        ))
        
        patterns.append(Pattern(
            pattern_id="ist_receiving",
            regex=r'(\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2}).*WSREP:.*Receiving IST:\s*(\d+)\s+writesets,\s+seqnos\s+(\d+)-(\d+)',
            entity_type="ist",
            priority=105,
            context="LOCAL",
            extract_fields={
                1: "timestamp",
                2: "writeset_count",
                3: "first_seqno",
                4: "last_seqno"
            },
            computed_fields={
                "transfer_type": "IST",
                "status": "RECEIVING"
            },
            confidence=0.98
        ))
        
        # Donor side: "async IST sender starting to serve <addr> sending A-B"
        patterns.append(Pattern(
            pattern_id="ist_sending",
            regex=r'(\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2}).*WSREP:\s+async IST sender starting to serve\s+(\S+)\s+sending\s+(\d+)-(\d+)',
            entity_type="ist",
            priority=105,
            context="LOCAL",
            extract_fields={
                1: "timestamp",
                2: "joiner_address",
                3: "first_seqno",
                4: "last_seqno"
            },
            computed_fields={
                "transfer_type": "IST",
                "status": "SENDING",
                "role": "donor"
            },
            confidence=0.98
        ))

        patterns.append(Pattern(
            pattern_id="ist_progress",
            regex=r'(\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2}).*WSREP:.*Receiving IST\.+\s*([\d.]+)%\s*\((\d+)/(\d+)\s+events\)',
            entity_type="ist",
            priority=95,
            context="LOCAL",
            extract_fields={
                1: "timestamp",
                2: "progress_percent",
                3: "events_processed",
                4: "events_total"
            },
            computed_fields={
                "transfer_type": "IST",
                "status": "PROGRESS"
            },
            confidence=0.90
        ))
        
        # ==================================================================
        # ERROR PATTERNS
        # ==================================================================
        
        patterns.append(Pattern(
            pattern_id="error_wsrep",
            regex=r'(\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2}).*\[ERROR\]\s+WSREP:\s+(.*)',
            entity_type="error",
            priority=75,
            context="LOCAL",
            extract_fields={
                1: "timestamp",
                2: "message"
            },
            computed_fields={
                "severity": "ERROR",
                "level": "ERROR"
            },
            confidence=0.85
        ))
        
        patterns.append(Pattern(
            pattern_id="warning_wsrep",
            regex=r'(\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2}).*\[Warning\]\s+WSREP:\s+(.*)',
            entity_type="error",
            priority=70,
            context="LOCAL",
            extract_fields={
                1: "timestamp",
                2: "message"
            },
            computed_fields={
                "severity": "WARNING",
                "level": "WARNING"
            },
            confidence=0.80
        ))
        
        # General MySQL/MariaDB errors (not just WSREP)
        patterns.append(Pattern(
            pattern_id="error_generic",
            regex=r'(\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2}).*\[ERROR\]\s+(.*)',
            entity_type="error",
            priority=68,
            context="LOCAL",
            extract_fields={
                1: "timestamp",
                2: "message"
            },
            computed_fields={
                "severity": "ERROR",
                "level": "ERROR"
            },
            confidence=0.75
        ))
        
        patterns.append(Pattern(
            pattern_id="warning_generic",
            regex=r'(\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2}).*\[Warning\]\s+(.*)',
            entity_type="error",
            priority=63,
            context="LOCAL",
            extract_fields={
                1: "timestamp",
                2: "message"
            },
            computed_fields={
                "severity": "WARNING",
                "level": "WARNING"
            },
            confidence=0.70
        ))
        
        # mysqld_safe errors
        patterns.append(Pattern(
            pattern_id="error_safe_log",
            regex=r'(\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2})\s+mysqld_safe\s+(.*(?<![-\w])(?:error|failed)(?![-\w]).*)',
            entity_type="error",
            priority=72,
            context="LOCAL",
            extract_fields={
                1: "timestamp",
                2: "message"
            },
            computed_fields={
                "severity": "ERROR",
                "level": "ERROR",
                "source": "mysqld_safe"
            },
            confidence=0.78
        ))

        # wsrep_sst_* script errors, e.g.
        #   WSREP_SST: [ERROR] mariadb-backup finished with error: 1. (20250513 01:56:30.123)
        patterns.append(Pattern(
            pattern_id="error_sst_script",
            regex=r'WSREP_SST:\s+\[ERROR\]\s+(.*?)(?:\s+\(\d{8}\s+\d{2}:\d{2}:\d{2}\.\d+\))?\s*$',
            entity_type="error",
            priority=99,
            context="LOCAL",
            extract_fields={
                1: "message"
            },
            computed_fields={
                "severity": "ERROR",
                "level": "ERROR",
                "source": "wsrep_sst"
            },
            confidence=0.95
        ))
        
        # ==================================================================
        # NODE IDENTITY PATTERNS
        # ==================================================================
        
        patterns.append(Pattern(
            pattern_id="node_name_synced",
            regex=r'(\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2}).*Server\s+([A-Za-z0-9_.-]+)\s+synced\s+with\s+group',
            entity_type="node",
            priority=100,
            context="LOCAL",
            extract_fields={
                1: "timestamp",
                2: "node_name"
            },
            computed_fields={},
            confidence=0.98
        ))
        
        patterns.append(Pattern(
            pattern_id="node_uuid",
            regex=r'(\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2}).*My UUID:\s+([a-f0-9-]+)',
            entity_type="node",
            priority=100,
            context="LOCAL",
            extract_fields={
                1: "timestamp",
                2: "node_uuid"
            },
            computed_fields={},
            confidence=0.99
        ))
        
        
        # ==================================================================
        # FLOW CONTROL PATTERNS
        # ==================================================================
        
        patterns.append(Pattern(
            pattern_id="flow_control_interval",
            regex=r'(\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2})\s+\d+\s+\[Note\]\s+WSREP:\s+Flow-control interval:\s+\[(\d+),\s*(\d+)\]',
            entity_type="flow_control",
            priority=80,
            context="LOCAL",
            extract_fields={
                1: "timestamp",
                2: "lower_limit",
                3: "upper_limit"
            },
            computed_fields={},
            confidence=0.99
        ))
        
        # Sort by priority (descending)
        patterns.sort(key=lambda p: p.priority, reverse=True)
        
        return patterns
    
    def process_files(self, file_paths: List[Path]) -> Dict[str, Any]:
        """Process multiple log files"""
        for file_path in file_paths:
            with open(file_path, 'r', encoding='utf-8', errors='replace') as f:
                lines = [normalize_timestamp(line) for line in f]

            # A log file belongs to exactly one node. Its name is usually only
            # logged once the node has synced, so find it before processing;
            # otherwise the startup sequence would be attributed to no node, or
            # to the node of the previously processed file.
            self.local_node_name = None
            self.local_node_uuid = None
            self.last_timestamp = None
            name = self._identify_local_node(lines, file_path)
            if name:
                self._register_node(name)
                self.local_node_name = name

            log_source = str(file_path)
            for line_num, line in enumerate(lines, 1):
                self._process_line(line, line_num, log_source)

            # Finalize blocks still open at the end of the file
            self._flush_blocks()

            # What this file covers in time. Outside that window the node's
            # state is not observed, only last known.
            stamps = [l[:19] for l in lines if _TS_START.match(l)]
            if stamps and name:
                for event, ts, order, line_no in (
                        ('log_start', min(stamps), -1, 1),
                        ('log_end', max(stamps), 10 ** 9, len(lines))):
                    self.temporal_entities.append({
                        'entity_type': 'log_coverage',
                        'entity_id': f'{event}_{len(self.temporal_entities)}',
                        'event_type': event,
                        'node_name': name,
                        'timestamp': ts,
                        'timestamp_index': order,
                        'line_number': line_no,
                        'log_source': log_source,
                        'raw_line': '',
                        'pattern_name': 'log_coverage',
                        'extraction_method': 'file_bounds',
                        'confidence': 1.0,
                    })
        
        # Sort temporal entities chronologically (handle None timestamps)
        self.temporal_entities.sort(key=lambda e: (
            e.get('timestamp') or '',
            e.get('timestamp_index', 0)
        ))
        
        # Build output
        return self._build_output()
    
    def _register_node(self, name: str):
        """Create the tracking record for a node the first time it is seen"""
        if name not in self.nodes:
            self.nodes[name] = {
                'node_name': name,
                'long_uuid': None,
                'uuid_history': [],
                'cluster_uuid': None,
                'node_address': None,
                'galera_version': None,
                'mariadb_version': None,
                'wsrep_version': None,
                'cluster_name': None
            }

    def _identify_local_node(self, lines: List[str], file_path) -> Optional[str]:
        """Find the name of the node that wrote this log file"""
        own_index = None
        view_name = None
        for line in lines:
            m = re.search(r'WSREP:\s+Server\s+([A-Za-z0-9_.-]+)\s+synced\s+with\s+group', line)
            if m and m.group(1).lower() not in {'unknown', 'joiner', 'donor'}:
                return m.group(1)
            if view_name is None:
                # wsrep view block: "own_index: N" followed by "N: <uuid>, <name>"
                m = re.match(r'\s*own_index:\s*(-?\d+)', line)
                if m:
                    own_index = int(m.group(1))
                    continue
                if own_index is not None and own_index >= 0:
                    m = re.match(r'\s*(\d+):\s*[a-f0-9-]+,\s*(\S.*?)\s*$', line)
                    if m and int(m.group(1)) == own_index:
                        view_name = m.group(2)
        if view_name:
            return view_name
        for line in lines:
            m = re.search(r"wsrep_node_name\s*[:=]\s*'?([^'\s]+)'?", line, re.IGNORECASE)
            if m:
                return m.group(1)
        # Nothing in the log names the node; fall back to the file name so the
        # node's state can still be tracked under a stable key.
        return Path(str(file_path)).name

    def _flush_blocks(self):
        """Parse or drop multi-line blocks that are still open"""
        if self.view_buffer is not None:
            # A gcomm view is only usable when complete
            if self.view_buffer['lines'][-1].strip().endswith('})'):
                self._parse_view_block()
            self.view_buffer = None
        if self.wsrep_view_buffer is not None:
            if self.wsrep_view_buffer.get('confirmed'):
                self._parse_wsrep_view_block()
            self.wsrep_view_buffer = None
        if self.quorum_buffer is not None:
            self._parse_quorum_block()
            self.quorum_buffer = None

    def _process_line(self, line: str, line_num: int, log_source: str):
        """Process a single log line"""
        starts_new_entry = bool(_TS_START.match(line))
        if starts_new_entry:
            self.last_timestamp = line[:19]
            # The continuation lines of a multi-line block carry no timestamp.
            # A timestamped line therefore ends any open block, even one whose
            # terminator is missing (truncated or filtered logs); without this
            # a headless block would swallow every following line.
            if (self.view_buffer is not None or self.quorum_buffer is not None or
                    (self.wsrep_view_buffer is not None and self.wsrep_view_buffer['confirmed'])):
                self._flush_blocks()

        # Collect the body of a "Quorum results:" block
        if self.quorum_buffer is not None:
            self.quorum_buffer['lines'].append(line)
            return
        if starts_new_entry and re.search(r'WSREP:\s+Quorum results:', line):
            self.quorum_buffer = {
                'timestamp': line[:19],
                'lines': [line],
                'line_num': line_num,
                'log_source': log_source,
            }
            return

        # Check if we're in a gcomm view block
        if self.view_buffer is not None:
            # Continue collecting view lines
            self.view_buffer['lines'].append(line)
            
            # Check if view block is complete (line ends with })
            if line.strip().endswith('})'):
                # Parse complete view block
                self._parse_view_block()
                self.view_buffer = None
            return
        
        # Check if we're in a wsrep view block
        if self.wsrep_view_buffer is not None:
            # Continue collecting wsrep view lines
            self.wsrep_view_buffer['lines'].append(line)
            
            # Check if wsrep view block is complete (line with ====)
            if line.strip().startswith('==='):
                # Parse complete wsrep view block
                self._parse_wsrep_view_block()
                self.wsrep_view_buffer = None
            return
        
        # Check if this line starts a wsrep view block
        if re.search(r'WSREP:\s+={40,}', line):
            # This might be the start of a wsrep view block
            # Wait for the next line to confirm
            # Handle both single and double digit hours, and variable spacing
            timestamp_match = re.match(r'^(\d{4}-\d{2}-\d{2})\s+(\d{1,2}):(\d{2}):(\d{2})', line)
            extracted_timestamp = None
            if timestamp_match:
                # Combine date and time with single space and zero-padded hour
                date = timestamp_match.group(1)
                hour = timestamp_match.group(2).zfill(2)  # Zero-pad hour
                minute = timestamp_match.group(3)
                second = timestamp_match.group(4)
                extracted_timestamp = f"{date} {hour}:{minute}:{second}"
            self.wsrep_view_buffer = {
                'timestamp': extracted_timestamp,
                'lines': [line],
                'line_num': line_num,
                'log_source': log_source,
                'confirmed': False
            }
            return
        
        # If wsrep view buffer exists but not confirmed, check if this is "View:"
        if self.wsrep_view_buffer and not self.wsrep_view_buffer['confirmed']:
            self.wsrep_view_buffer['lines'].append(line)
            if line.strip() == 'View:':
                self.wsrep_view_buffer['confirmed'] = True
            else:
                # Not a view block, reset
                self.wsrep_view_buffer = None
            return
        
        # Check if this line starts a gcomm view block
        view_match = re.search(r'view\(view_id\((PRIM|NON_PRIM|PRIMARY|NON_PRIMARY),([a-f0-9-]+),(\d+)\)\s+memb\s+\{', line)
        if view_match:
            # Start collecting view block - handle variable whitespace and single-digit hours in timestamp
            timestamp_match = re.match(r'^(\d{4}-\d{2}-\d{2})\s+(\d{1,2}):(\d{2}):(\d{2})', line)
            timestamp = None
            if timestamp_match:
                # Combine date and time with single space and zero-padded hour
                date = timestamp_match.group(1)
                hour = timestamp_match.group(2).zfill(2)  # Zero-pad hour
                minute = timestamp_match.group(3)
                second = timestamp_match.group(4)
                timestamp = f"{date} {hour}:{minute}:{second}"
            self.view_buffer = {
                'timestamp': timestamp,
                'cluster_state': view_match.group(1),
                'view_uuid': view_match.group(2),
                'view_seq': view_match.group(3),
                'lines': [line],
                'line_num': line_num,
                'log_source': log_source
            }
            return
        
        # Detect local node info
        self._detect_local_node(line)
        
        # Try each pattern
        for pattern in self.patterns:
            match = pattern.compiled_regex.search(line)
            if not match:
                continue
            
            # Extract entity data
            entity = self._extract_entity(match, pattern, line, line_num, log_source)
            if entity:
                self._store_entity(entity)
                break  # First match wins (patterns are priority-sorted)
    
    def _parse_quorum_block(self):
        """Parse a "Quorum results:" block (gcs_group.cpp, group_post_state_exchange).

        This is the outcome of the state exchange that follows a primary
        component message: whether the group really is PRIMARY, the
        configuration id, and how many of the members hold the group state.
        """
        buf = self.quorum_buffer
        if not buf:
            return
        text = '\n'.join(buf['lines'])
        fields = dict(re.findall(r'^\s*([A-Za-z_. ]+?)\s*=\s*(.+?),?\s*$', text, re.M))
        component = (fields.get('component') or '').upper()
        if component not in ('PRIMARY', 'NON-PRIMARY'):
            return  # truncated block, nothing reliable to report
        primary = component == 'PRIMARY'
        timestamp = buf['timestamp']
        entity = {
            'entity_type': 'quorum',
            'entity_id': f"quorum_{buf['line_num']}",
            'timestamp': timestamp,
            'timestamp_index': self.timestamp_indices[timestamp],
            'event_type': 'QUORUM_RESULT',
            'event_text': f"Quorum results: component = {component}",
            'component': 'PRIMARY' if primary else 'NON_PRIMARY',
            'quorum_status': primary,
            'severity': 'INFO' if primary else 'CRITICAL',
            'raw_line': text.strip(),
            'line_number': buf['line_num'],
            'log_source': buf['log_source'],
            'confidence': 0.99,
            'pattern_name': 'quorum_results_multiline',
            'extraction_method': 'multiline_parse',
        }
        self.timestamp_indices[timestamp] += 1
        m = re.match(r'(-?\d+)', fields.get('conf_id', ''))
        if m:
            entity['conf_id'] = int(m.group(1))
        m = re.match(r'(\d+)/(\d+)', fields.get('members', ''))
        if m:
            entity['members_joined'] = int(m.group(1))
            entity['member_count'] = int(m.group(2))
        m = re.match(r'([a-f0-9-]{36})', fields.get('group UUID', ''))
        if m:
            entity['group_uuid'] = m.group(1)
            if m.group(1) != '00000000-0000-0000-0000-000000000000':
                entity['cluster_uuid'] = m.group(1)
                entity['cluster_ref'] = f"cluster_{m.group(1)[:8]}"
        if 'cluster_ref' not in entity and self.cluster_uuid:
            entity['cluster_uuid'] = self.cluster_uuid
            entity['cluster_ref'] = f"cluster_{self.cluster_uuid[:8]}"
        if self.local_node_name:
            entity['node_name'] = self.local_node_name
            if self.local_node_uuid:
                entity['node_uuid'] = self.local_node_uuid
        self.temporal_entities.append(entity)

    def _parse_view_block(self):
        """Parse a complete view block"""
        if not self.view_buffer:
            return
        
        # Extract member lists from the view block
        full_text = '\n'.join(self.view_buffer['lines'])
        
        # Parse sections: memb, joined, left, partitioned
        members = self._extract_view_section(full_text, 'memb')
        joined = self._extract_view_section(full_text, 'joined')
        left = self._extract_view_section(full_text, 'left')
        partitioned = self._extract_view_section(full_text, 'partitioned')
        
        # Resolve UUIDs to node names
        member_names = [self._resolve_node_by_uuid(m) or m for m in members]
        joined_names = [self._resolve_node_by_uuid(j) or j for j in joined]
        left_names = [self._resolve_node_by_uuid(l) or l for l in left]
        partitioned_names = [self._resolve_node_by_uuid(p) or p for p in partitioned]
        
        # Create view entity
        timestamp = self.view_buffer['timestamp']
        entity = {
            'entity_type': 'view',
            'entity_id': f"view_{self.view_buffer['line_num']}",
            'timestamp': timestamp,
            'timestamp_index': self.timestamp_indices[timestamp] if timestamp else 0,
            'cluster_state': self.view_buffer['cluster_state'],
            'view_uuid': self.view_buffer['view_uuid'],
            'view_seq': int(self.view_buffer['view_seq']),
            'view_id': f"{self.view_buffer['view_uuid']},{self.view_buffer['view_seq']}",
            'view_layer': 'gcomm',
            'members': members,
            'member_names': member_names,
            'member_count': len(members),
            'joined': joined,
            'joined_names': joined_names,
            'left': left,
            'left_names': left_names,
            'partitioned': partitioned,
            'partitioned_names': partitioned_names,
            'raw_line': full_text.strip(),
            'line_number': self.view_buffer['line_num'],
            'log_source': self.view_buffer['log_source'],
            'confidence': 0.95,
            'pattern_name': 'view_multiline',
            'extraction_method': 'multiline_parse',
        }
        
        if timestamp:
            self.timestamp_indices[timestamp] += 1
        
        # Add cluster info - use view_uuid as fallback if cluster_uuid not known
        if self.cluster_uuid:
            entity['cluster_uuid'] = self.cluster_uuid
            entity['cluster_ref'] = f"cluster_{self.cluster_uuid[:8]}"
        elif self.view_buffer.get('view_uuid'):
            # Use view_uuid as cluster identifier for gcomm views
            view_uuid = self.view_buffer['view_uuid']
            entity['cluster_uuid'] = view_uuid
            entity['cluster_ref'] = f"cluster_{view_uuid[:8]}"
        
        self.temporal_entities.append(entity)
    
    def _extract_view_section(self, text: str, section_name: str) -> List[str]:
        """Extract UUID list from a view section (memb, joined, left, partitioned)"""
        # Find the section
        pattern = rf'{section_name}\s+\{{([^}}]*)\}}'
        match = re.search(pattern, text, re.DOTALL)
        if not match:
            return []
        
        section_content = match.group(1)
        
        # Extract UUIDs (format: uuid,index or just uuid)
        uuids = []
        for line in section_content.split('\n'):
            line = line.strip()
            if not line:
                continue
            # Extract UUID (before comma if present)
            if ',' in line:
                uuid = line.split(',')[0].strip()
            else:
                uuid = line.strip()
            if uuid:
                uuids.append(uuid)
        
        return uuids
    
    def _parse_wsrep_view_block(self):
        """Parse a complete wsrep view block"""
        if not self.wsrep_view_buffer:
            return
        
        full_text = '\n'.join(self.wsrep_view_buffer['lines'])
        
        # Extract fields from wsrep view
        view_data = {}
        
        # id: group_uuid:seqno (group_uuid is the cluster uuid)
        match = re.search(r'id:\s*([a-f0-9-]+):(\d+)', full_text)
        if match:
            view_data['group_uuid'] = match.group(1)  # Renamed from view_uuid to group_uuid
            view_data['cluster_uuid'] = match.group(1)  # Same as group_uuid
            view_data['view_seq'] = int(match.group(2))
            view_data['view_id'] = f"{match.group(1)}:{match.group(2)}"
        
        # status: primary/non-primary
        match = re.search(r'status:\s*(primary|non-primary)', full_text, re.IGNORECASE)
        if match:
            view_data['status'] = match.group(1).upper()
            view_data['view_status'] = 'PRIM' if match.group(1).lower() == 'primary' else 'NON_PRIM'
            view_data['cluster_state'] = view_data['view_status']  # Keep both for compatibility
        
        # protocol_version
        match = re.search(r'protocol_version:\s*(\d+)', full_text)
        if match:
            view_data['protocol_version'] = int(match.group(1))
        
        # capabilities (comma-separated list)
        match = re.search(r'capabilities:\s*(.+?)(?:\n|$)', full_text)
        if match:
            caps_str = match.group(1).strip()
            view_data['capabilities'] = [c.strip() for c in caps_str.split(',')]
        
        # final: yes/no
        match = re.search(r'final:\s*(yes|no)', full_text, re.IGNORECASE)
        if match:
            view_data['final'] = match.group(1).lower() == 'yes'
        
        # own_index
        match = re.search(r'own_index:\s*(-?\d+)', full_text)
        if match:
            view_data['own_index'] = int(match.group(1))
        
        # members(N): followed by member lines
        match = re.search(r'members\((\d+)\):', full_text)
        if match:
            view_data['member_count'] = int(match.group(1))
        else:
            view_data['member_count'] = 0
        
        # Parse member details: "0: uuid, NODE_NAME"
        member_details = []
        members = []
        member_names = []
        member_uuids = []
        
        for line in full_text.split('\n'):
            # Match member line: \t0: uuid, name
            member_match = re.match(r'\s*(\d+):\s*([a-f0-9-]+),\s*(.+)', line)
            if member_match:
                index = int(member_match.group(1))
                uuid = member_match.group(2).strip()
                name = member_match.group(3).strip()
                
                member_details.append({
                    'index': index,
                    'uuid': uuid,
                    'node_name': name
                })
                members.append(name)
                member_names.append(name)
                member_uuids.append(uuid)
        
        view_data['member_details'] = member_details
        view_data['members'] = members
        view_data['member_names'] = member_names
        view_data['member_uuids'] = member_uuids
        
        # Determine the observing node from own_index
        own_index = view_data.get('own_index')
        observing_node_name = None
        observing_node_uuid = None
        if own_index is not None and own_index >= 0 and own_index < len(member_details):
            observing_node_name = member_details[own_index].get('node_name')
            observing_node_uuid = member_details[own_index].get('uuid')
        
        # Create wsrep view entity with LOCAL context (node-level view)
        timestamp = self.wsrep_view_buffer['timestamp']
        entity = {
            'entity_type': 'wsrep_view',
            'entity_id': f"wsrep_view_{self.wsrep_view_buffer['line_num']}",
            'timestamp': timestamp,
            'timestamp_index': self.timestamp_indices[timestamp] if timestamp else 0,
            'view_layer': 'wsrep',
            'context': 'LOCAL',  # This is a node-level view
            **view_data,
            'raw_line': full_text.strip(),
            'line_number': self.wsrep_view_buffer['line_num'],
            'log_source': self.wsrep_view_buffer['log_source'],
            'confidence': 0.98,
            'pattern_name': 'wsrep_view_multiline',
            'extraction_method': 'multiline_parse',
        }
        
        # Add observing node information
        if observing_node_name:
            entity['node_name'] = observing_node_name
        elif self.local_node_name:
            # Fallback to local node name when own_index is -1 or member list is empty
            entity['node_name'] = self.local_node_name
        if observing_node_uuid:
            entity['node_uuid'] = observing_node_uuid
        elif self.local_node_uuid:
            # Fallback to local node UUID
            entity['node_uuid'] = self.local_node_uuid
        
        if timestamp:
            self.timestamp_indices[timestamp] += 1
        
        # Add cluster reference - use group_uuid as cluster identifier
        if view_data.get('group_uuid'):
            entity['cluster_ref'] = f"cluster_{view_data['group_uuid'][:8]}"
            # Update global cluster UUID if we found a long-form UUID
            if '-' in view_data['group_uuid'] and len(view_data['group_uuid']) > 20:
                if not self.cluster_uuid:
                    self.cluster_uuid = view_data['group_uuid']
                    # Update all nodes with this cluster UUID
                    for node in self.nodes.values():
                        if not node['cluster_uuid']:
                            node['cluster_uuid'] = self.cluster_uuid
        elif self.cluster_uuid:
            entity['cluster_ref'] = f"cluster_{self.cluster_uuid[:8]}"
        
        self.temporal_entities.append(entity)
    
    def _detect_local_node(self, line: str):
        """Detect local node name and UUID, tracking UUID history"""
        # Node name patterns
        for pattern in [
            r"wsrep_node_name\s*[:=]\s*'?([^']+)'?",
            r"Server\s+([A-Za-z0-9_.-]+)\s+synced",
        ]:
            match = re.search(pattern, line, re.IGNORECASE)
            if match:
                name = match.group(1).strip()
                if name.lower() not in {'unknown', 'joiner', 'donor'}:
                    self.local_node_name = name
                    self._register_node(name)
                    break
        
        # UUID pattern - track history
        match = re.search(r'My UUID:\s+([a-f0-9-]+)', line)
        if match:
            uuid = match.group(1)
            self.local_node_uuid = uuid
            
            if self.local_node_name:
                node = self.nodes.get(self.local_node_name)
                if node:
                    # Add UUID to history if not already there
                    if uuid not in node['uuid_history']:
                        node['uuid_history'].append(uuid)
                        # Also add short form
                        short_uuid = self._shorten_uuid(uuid)
                        if short_uuid and short_uuid not in node['uuid_history']:
                            node['uuid_history'].append(short_uuid)
                    
                    # Update long_uuid to latest
                    node['long_uuid'] = uuid
                    
                    # Map all UUID forms to this node
                    short_uuid = self._shorten_uuid(uuid)
                    self.uuid_to_node[uuid] = self.local_node_name
                    self.uuid_to_node[uuid.replace('-', '')] = self.local_node_name
                    if short_uuid:
                        self.uuid_to_node[short_uuid] = self.local_node_name
        
        # Cluster UUID
        match = re.search(r'(?:Cluster\s+state\s+uuid|wsrep_cluster_state_uuid):\s*([a-f0-9-]+)', line, re.IGNORECASE)
        if match:
            self.cluster_uuid = match.group(1)
            # Update all nodes with cluster UUID
            for node in self.nodes.values():
                if not node['cluster_uuid']:
                    node['cluster_uuid'] = self.cluster_uuid
    
    def _shorten_uuid(self, uuid: str) -> Optional[str]:
        """Generate short UUID (first-fourth parts)"""
        if not uuid or '-' not in uuid:
            return None
        parts = uuid.split('-')
        if len(parts) >= 4:
            return f"{parts[0]}-{parts[3]}"
        return None
    
    def _resolve_node_by_uuid(self, uuid: str) -> Optional[str]:
        """Resolve UUID to node name"""
        if not uuid:
            return None
        
        # Try direct match
        if uuid in self.uuid_to_node:
            return self.uuid_to_node[uuid]
        
        # Try without dashes
        uuid_compact = uuid.replace('-', '')
        if uuid_compact in self.uuid_to_node:
            return self.uuid_to_node[uuid_compact]
        
        # Try short form
        short = self._shorten_uuid(uuid)
        if short and short in self.uuid_to_node:
            return self.uuid_to_node[short]
        
        return None
    
    def _extract_entity(self, match, pattern: Pattern, line: str, line_num: int, log_source: str) -> Optional[Dict]:
        """Extract entity data from regex match"""
        entity = {
            'entity_type': pattern.entity_type,
            'entity_id': f"{pattern.entity_type}_{line_num}",
            'raw_line': line.strip(),
            'line_number': line_num,
            'log_source': log_source,
            'confidence': pattern.confidence,
            'pattern_name': pattern.pattern_id,
            'extraction_method': 'pattern_match',
        }
        
        # Extract matched groups
        for group_idx, field_name in pattern.extract_fields.items():
            try:
                value = match.group(group_idx)
                if value:
                    entity[field_name] = value.strip()
            except IndexError:
                pass
        
        # Add computed fields
        for field_name, value in pattern.computed_fields.items():
            entity[field_name] = value
        
        # Normalize state names to uppercase for consistency
        if pattern.entity_type == 'node_state':
            if 'from_state' in entity:
                entity['from_state'] = entity['from_state'].upper()
            if 'to_state' in entity:
                entity['to_state'] = entity['to_state'].upper()
        
        # Add context-specific fields
        if pattern.context == "LOCAL" and self.local_node_name:
            entity['node_name'] = self.local_node_name
            if self.local_node_uuid:
                entity['node_uuid'] = self.local_node_uuid
        
        # Add cluster reference
        if self.cluster_uuid:
            entity['cluster_uuid'] = self.cluster_uuid
            entity['cluster_ref'] = f"cluster_{self.cluster_uuid[:8]}"
        # For empty views with placeholder view_uuid, create a cluster_ref
        elif entity.get('view_uuid') == 'empty':
            entity['cluster_ref'] = 'cluster_empty'
        
        # Special handling for flow_control entities
        if entity.get('entity_type') == 'flow_control':
            upper_limit = entity.get('upper_limit')
            lower_limit = entity.get('lower_limit')
            
            # Convert string to int if needed
            if isinstance(upper_limit, str):
                upper_limit = int(upper_limit)
                entity['upper_limit'] = upper_limit
            if isinstance(lower_limit, str):
                lower_limit = int(lower_limit)
                entity['lower_limit'] = lower_limit
            
            # Calculate inferred cluster size
            # Formula: upper_limit = 16 * sqrt(cluster_size)
            # Therefore: cluster_size = (upper_limit / 16)^2
            if upper_limit and upper_limit > 0:
                inferred_size = round((upper_limit / 16.0) ** 2)
                entity['inferred_cluster_size'] = inferred_size
                entity['fc_status'] = 'active'
            else:
                # [0, 0] means flow control disabled (node not SYNCED)
                entity['inferred_cluster_size'] = 0
                entity['fc_status'] = 'disabled'
        
        # Component message: typed fields and a readable status
        if pattern.pattern_id == 'component_change':
            primary = entity.pop('component_primary', 'no').lower() == 'yes'
            entity['component'] = 'PRIMARY' if primary else 'NON_PRIMARY'
            entity['quorum_status'] = primary
            entity['severity'] = 'INFO' if primary else 'CRITICAL'
            entity['bootstrap'] = entity.get('bootstrap', 'no').lower() == 'yes'
            entity['my_idx'] = int(entity.get('my_idx', -1))
            entity['member_count'] = int(entity.get('member_count', 0))

        # Lines without a leading timestamp (SST script output): use the time
        # the script printed, else the time of the preceding log entry.
        if not entity.get('timestamp'):
            m = _TS_SST_SCRIPT.search(line)
            if m:
                entity['timestamp'] = (f"{m.group(1)}-{m.group(2)}-{m.group(3)} "
                                       f"{m.group(4).zfill(2)}:{m.group(5)}")
            elif self.last_timestamp:
                entity['timestamp'] = self.last_timestamp

        # Add timestamp index for frame ordering
        timestamp = entity.get('timestamp')
        if timestamp:
            entity['timestamp_index'] = self.timestamp_indices[timestamp]
            self.timestamp_indices[timestamp] += 1
        else:
            entity['timestamp_index'] = 0
        
        return entity
    
    def _store_entity(self, entity: Dict):
        """Store entity in appropriate collection"""
        entity_type = entity.get('entity_type')
        
        if entity_type == 'node':
            # Node entities are handled separately via UUID tracking
            # We don't store individual node sightings, just track their UUIDs
            pass
        elif entity_type == 'cluster':
            # Store cluster entity as temporal (for compatibility with v2)
            self.temporal_entities.append(entity)
        else:
            # TEMPORAL entities - resolve node references
            # If entity has node_uuid, try to resolve to node_name
            if 'node_uuid' in entity and not entity.get('node_name'):
                node_name = self._resolve_node_by_uuid(entity['node_uuid'])
                if node_name:
                    entity['node_name'] = node_name
            
            # Also check for joiner/donor references
            if 'joiner_uuid' in entity:
                node_name = self._resolve_node_by_uuid(entity['joiner_uuid'])
                if node_name:
                    entity['joiner_name'] = node_name
            
            if 'donor_uuid' in entity:
                node_name = self._resolve_node_by_uuid(entity['donor_uuid'])
                if node_name:
                    entity['donor_name'] = node_name
            
            self.temporal_entities.append(entity)
    
    def _build_output(self) -> Dict[str, Any]:
        """Build final output compatible with graf"""
        entities = []
        
        # Collect cluster UUIDs seen (only long-form UUIDs are real cluster UUIDs)
        cluster_uuids = set()
        if self.cluster_uuid and '-' in self.cluster_uuid and len(self.cluster_uuid) > 20:
            cluster_uuids.add(self.cluster_uuid)
        for node_data in self.nodes.values():
            cu = node_data['cluster_uuid']
            if cu and '-' in cu and len(cu) > 20:  # Only long-form cluster UUIDs
                cluster_uuids.add(cu)
        # Also check wsrep_view entities for group_uuid
        for e in self.temporal_entities:
            if e.get('entity_type') == 'wsrep_view':
                gu = e.get('group_uuid')
                if gu and '-' in gu and len(gu) > 20:
                    cluster_uuids.add(gu)
        
        # Build cluster timeline: determine lifetime of each cluster bootstrap session
        # Lifetime = [first_seen, next_cluster_first_seen) or [first_seen, now) for last cluster
        cluster_lifetimes = []
        for cluster_uuid in cluster_uuids:
            # Find first timestamp where this cluster_uuid appears
            first_ts = None
            for e in self.temporal_entities:
                if ((e.get('cluster_uuid') == cluster_uuid or 
                     e.get('group_uuid') == cluster_uuid) and 
                    e.get('timestamp')):
                    first_ts = e['timestamp']
                    break
            if first_ts:
                cluster_lifetimes.append((cluster_uuid, first_ts))
        
        # Sort by first_seen timestamp
        cluster_lifetimes.sort(key=lambda x: x[1])
        
        # Helper function: assign entity to correct cluster based on timestamp
        def get_cluster_for_timestamp(timestamp: Optional[str]) -> Optional[str]:
            """Return cluster_uuid that was active at the given timestamp."""
            if not timestamp or not cluster_lifetimes:
                return None
            
            # Find the cluster whose lifetime contains this timestamp
            for i, (cluster_uuid, start_ts) in enumerate(cluster_lifetimes):
                # Check if timestamp is >= this cluster's start
                if timestamp >= start_ts:
                    # Check if timestamp is < next cluster's start (if exists)
                    if i + 1 < len(cluster_lifetimes):
                        next_start_ts = cluster_lifetimes[i + 1][1]
                        if timestamp < next_start_ts:
                            return cluster_uuid
                    else:
                        # This is the last cluster, so it extends to "now"
                        return cluster_uuid
            
            # If timestamp is before all clusters, assign to first cluster
            if cluster_lifetimes and timestamp < cluster_lifetimes[0][1]:
                return cluster_lifetimes[0][0]
            
            return None
        
        # Add CLUSTER entities (one per unique cluster UUID)
        for cluster_uuid in cluster_uuids:
            cluster_ref = f"cluster_{cluster_uuid[:8]}"
            
            # Aggregate statistics from temporal entities using time-based assignment
            # Count only SST sessions that started (not all SST events)
            sst_count = 0
            for e in self.temporal_entities:
                if (e.get('entity_type') == 'sst' and 
                    e.get('status') == 'STARTED'):
                    # Assign to cluster based on timestamp
                    event_cluster = get_cluster_for_timestamp(e.get('timestamp'))
                    if event_cluster == cluster_uuid:
                        sst_count += 1
            
            # Count unique cluster-level view changes (by view_id) using time-based assignment
            # Use wsrep_view only (cluster-level), ignore gcomm (per-node redundant views)
            view_ids_seen = set()
            for e in self.temporal_entities:
                if e.get('entity_type') == 'wsrep_view':
                    # Assign to cluster based on timestamp
                    event_cluster = get_cluster_for_timestamp(e.get('timestamp'))
                    if event_cluster == cluster_uuid:
                        view_id = e.get('view_id')
                        if view_id:
                            view_ids_seen.add(view_id)
            view_count = len(view_ids_seen)
            
            # Count errors and warnings using time-based assignment
            error_count = 0
            warning_count = 0
            for e in self.temporal_entities:
                if e.get('entity_type') == 'error':
                    event_cluster = get_cluster_for_timestamp(e.get('timestamp'))
                    if event_cluster == cluster_uuid:
                        if e.get('severity') == 'ERROR':
                            error_count += 1
                        elif e.get('severity') == 'WARNING':
                            warning_count += 1
            
            # Find first timestamp for this cluster
            first_timestamp = None
            for e in self.temporal_entities:
                event_cluster = get_cluster_for_timestamp(e.get('timestamp'))
                if event_cluster == cluster_uuid and e.get('timestamp'):
                    first_timestamp = e['timestamp']
                    break
            
            cluster_entity = {
                'entity_type': 'cluster',
                'entity_id': cluster_ref,
                'cluster_uuid': cluster_uuid,
                'cluster_ref': cluster_ref,
                'cluster_name': '',
                'max_members_seen': 0,  # Will be computed by graf
                'total_sst_operations': sst_count,
                'total_view_changes': view_count,
                'split_brain_events': 0,  # Will be computed by graf
                'error_count': error_count,
                'warning_count': warning_count,
                'analysis_start_time': first_timestamp,
                'log_sources': [],  # Will be populated by graf
                'timestamp': first_timestamp,
                'timestamp_index': 0,
                'line_number': 0,
                'raw_line': '',
                'log_source': '',
                'confidence': 1.0,
                'pattern_name': '',
                'extraction_method': 'manual',
                'validated': False,
                'validation_notes': ''
            }
            entities.append(cluster_entity)
        
        # Add CORE node entities (one per physical node)
        for node_name, node_data in self.nodes.items():
            # Compute node_id (short UUID: first and fourth fields)
            node_id = None
            if node_data['long_uuid']:
                parts = node_data['long_uuid'].split('-')
                if len(parts) >= 4:
                    node_id = f"{parts[0]}-{parts[3]}"
            
            node_entity = {
                'entity_type': 'node',
                'entity_id': f"node_{node_name}",
                'node_name': node_name,
                'node_id': node_id,
                'long_uuid': node_data['long_uuid'],
                'node_uuid': node_data['long_uuid'],  # Alias for compatibility
                'uuid_history': node_data['uuid_history'],
                'cluster_uuid': node_data['cluster_uuid'] or self.cluster_uuid,
                'cluster_ref': f"cluster_{(node_data['cluster_uuid'] or self.cluster_uuid)[:8]}" if (node_data['cluster_uuid'] or self.cluster_uuid) else None,
                'cluster_name': node_data.get('cluster_name'),
                'node_address': node_data.get('node_address'),
                'galera_version': node_data.get('galera_version'),
                'mariadb_version': node_data.get('mariadb_version'),
                'wsrep_version': node_data.get('wsrep_version'),
                'current_state': 'UNKNOWN',  # Will be tracked by node_state entities
                'level': 'Note',  # Standard log level
                'state_uuid': '',  # Legacy field
                'validated': False,
                'validation_notes': '',
                'timestamp': None,
                'timestamp_index': 0,
                'raw_line': '',
                'line_number': 0,
                'log_source': '',
                'confidence': 1.0,
                'pattern_name': 'node_tracking',
                'extraction_method': 'uuid_history'
            }
            entities.append(node_entity)
        
        # Add temporal entities
        entities.extend(self.temporal_entities)
        
        # Final sort by timestamp and index
        entities.sort(key=lambda e: (
            e.get('timestamp') or '',
            e.get('timestamp_index', 0)
        ))
        
        return {
            'grap_version': GRAP_VERSION,
            'extraction_time': datetime.now().isoformat(),
            'total_entities': len(entities),
            'entities': entities
        }


def main():
    parser = argparse.ArgumentParser(
        description='GRAP v3.0-alpha - Enhanced Galera Raw Analysis Parser'
    )
    parser.add_argument('files', nargs='+', help='Log files to process')
    parser.add_argument('--format', default='json', choices=['json'], help='Output format')
    parser.add_argument('--version', action='version', version=f'grap {GRAP_VERSION}')
    
    args = parser.parse_args()
    
    # Convert file paths
    file_paths = [Path(f) for f in args.files]
    
    # Validate files exist
    for fp in file_paths:
        if not fp.exists():
            print(f"Error: File not found: {fp}", file=sys.stderr)
            sys.exit(1)
    
    # Process files
    print(f"[GRAP] Processing {len(file_paths)} file(s)...", file=sys.stderr)
    
    extractor = EntityExtractor()
    result = extractor.process_files(file_paths)
    
    # Sort entities chronologically
    total = result['total_entities']
    print(f"[GRAP] Sorting {total} entities chronologically across {len(file_paths)} files", file=sys.stderr)
    print(f"[GRAP] Adding per-timestamp indices for deterministic frame ordering", file=sys.stderr)
    
    # Output
    print(json.dumps(result, indent=2, default=str))


if __name__ == '__main__':
    main()

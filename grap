    """Base entity class"""
    entity_type: str = ""
    entity_id: str = ""
    timestamp: Optional[datetime] = None
    line_number: int = 0
    log_source: str = ""
    confidence: float = 1.0
    raw_line: str = ""
    cluster_ref: Optional[str] = None

@dataclass  
class NodeEntity(Entity):
    """Galera cluster node"""
    node_uuid: str = ""
    node_name: str = ""
    node_address: str = ""
    node_state: str = ""
    cluster_position: str = ""
    
@dataclass
class ViewEntity(Entity):

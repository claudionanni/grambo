# Entity Types
class EntityType(Enum):
    """Types of entities found in Galera logs"""
    CLUSTER = "cluster"
    NODE = "node"
    VIEW = "view"
    SST = "sst"
    IST = "ist"
    ERROR = "error"
    FLOW_CONTROL = "flow_control"
    CERTIFICATION = "certification"
    REPLICATION = "replication"
    COMMUNICATION = "communication"
    SERVICE = "service"
    TRANSACTION = "transaction"
    CLIENT_CONNECTION = "client_connection"
    LOCK = "lock"
    SQL = "sql"

# Base Entity
@dataclass
class Entity:
    """Base class for all entities"""
    timestamp: Optional[datetime] = None
    line_number: int = 0
    raw_line: str = ""
    log_source: str = ""
    entity_id: str = ""
    entity_type: Optional[EntityType] = None
    cluster_ref: Optional[str] = None
    
    def __post_init__(self):
        """Generate entity_id if not provided"""
        if not self.entity_id:
            # Create unique ID from content hash
            content = f"{self.entity_type}_{self.line_number}_{self.raw_line[:50]}"
            self.entity_id = hashlib.md5(content.encode()).hexdigest()[:12]

# Cluster Entity
@dataclass 
class ClusterEntity(Entity):
    """Represents a Galera cluster"""
    cluster_uuid: Optional[str] = None
    cluster_name: Optional[str] = None
    cluster_size: Optional[int] = None
    primary_state: Optional[bool] = None
    protocol_version: Optional[int] = None
    
    def __post_init__(self):
        super().__post_init__()
        self.entity_type = EntityType.CLUSTER

# Node Entity
@dataclass
class NodeEntity(Entity):
    """Represents a node in the cluster"""
    node_name: Optional[str] = None
    node_uuid: Optional[str] = None
    node_state: Optional[str] = None
    node_index: Optional[int] = None
    node_address: Optional[str] = None
    wsrep_last_committed: Optional[int] = None
    known_uuids: List[str] = field(default_factory=list)
    
    def __post_init__(self):
        super().__post_init__()
        self.entity_type = EntityType.NODE

# View Entity with improved structure based on Galera source
@dataclass
class ViewEntity(Entity):
    """Represents a Galera cluster view change"""
    view_id: Optional[str] = None
    cluster_uuid: Optional[str] = None
    view_seq: Optional[int] = None
    cluster_state: Optional[str] = None  # PRIM or NON-PRIM
    my_uuid: Optional[str] = None
    protocol_version: Optional[int] = None
    
    # Member lists - based on Galera source code structure
    members: List[str] = field(default_factory=list)  # Current members
    joined_members: List[str] = field(default_factory=list)  # Newly joined
    left_members: List[str] = field(default_factory=list)  # Members that left
    partitioned_members: List[str] = field(default_factory=list)  # Partitioned
    
    # Additional member information
    member_segments: Dict[str, int] = field(default_factory=dict)  # member -> segment mapping
    member_uuid_map: Dict[str, str] = field(default_factory=dict)  # canonical name -> uuid/identifier mapping
    
    # Derived fields
    member_count: Optional[int] = None
    is_primary: Optional[bool] = None
    
    def __post_init__(self):
        """Calculate derived fields after initialization"""
        super().__post_init__()
        self.entity_type = EntityType.VIEW
        if self.members:
            self.member_count = len(self.members)
        if self.cluster_state:
            self.is_primary = self.cluster_state == "PRIM"


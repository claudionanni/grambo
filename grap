# --- Node entity deduplication helpers ---

def _node_entity_score(node: NodeEntity) -> int:
    """Simple heuristic score to prefer richer node metadata."""
    score = 0
    if getattr(node, 'long_uuid', None):
        score += 4
    if getattr(node, 'node_id', None):
        score += 2
    if getattr(node, 'node_address', None):
        score += 1
    if getattr(node, 'cluster_uuid', None):
        score += 1
    if getattr(node, 'cluster_ref', None):
        score += 1
    if getattr(node, 'timestamp', None):
        score += 1
    return score


def _merge_node_entities(primary: NodeEntity, candidate: NodeEntity) -> NodeEntity:
    """Merge missing attributes from candidate into primary in an immutable-safe way."""
    updates = {}
    candidate_updates = {}

    # Fill blanks on the primary with candidate data
    for attr in (
        'long_uuid', 'node_id', 'node_name', 'node_address', 'cluster_uuid',
        'cluster_ref', 'state_uuid', 'wsrep_version', 'galera_version',
        'mariadb_version', 'local_index', 'local_cached_downto'
    ):
        primary_val = getattr(primary, attr, None)
        candidate_val = getattr(candidate, attr, None)
        if (primary_val in (None, "", [])) and candidate_val not in (None, "", []):
            updates[attr] = candidate_val
        elif (candidate_val in (None, "", [])) and primary_val not in (None, "", []):
            candidate_updates[attr] = primary_val

    # Combine UUID history from both entities
    primary_history = list(getattr(primary, 'uuid_history', ()))
    candidate_history = list(getattr(candidate, 'uuid_history', ()))
    if primary_history or candidate_history:
        combined_history = list(dict.fromkeys(primary_history + candidate_history))
        if tuple(combined_history) != tuple(primary_history):
            updates['uuid_history'] = tuple(combined_history)
        if tuple(combined_history) != tuple(candidate_history):
            candidate_updates['uuid_history'] = tuple(combined_history)

    merged_primary = replace(primary, **updates) if updates else primary
    merged_candidate = replace(candidate, **candidate_updates) if candidate_updates else candidate

    # Pick the richer of the merged entities
    if _node_entity_score(merged_candidate) > _node_entity_score(merged_primary):
        return merged_candidate
    return merged_primary


def _deduplicate_node_entities(entities: List[Entity]) -> List[Entity]:
    """Ensure only one canonical NodeEntity per logical node is emitted."""
    deduped: List[Entity] = []
    seen: Dict[str, int] = {}

    for entity in entities:
        if isinstance(entity, NodeEntity):
            key_candidates = [
                getattr(entity, 'entity_id', None),
                getattr(entity, 'node_name', None),
                getattr(entity, 'long_uuid', None)
            ]
            key = next((k for k in key_candidates if k), None)
            if not key:
                deduped.append(entity)
                continue

            if key in seen:
                idx = seen[key]
                existing = deduped[idx]
                if isinstance(existing, NodeEntity):
                    deduped[idx] = _merge_node_entities(existing, entity)
                continue

            seen[key] = len(deduped)
        deduped.append(entity)

    return deduped


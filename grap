# Parser class
class GaleraLogParser:
    """Parse Galera logs and extract entities"""
    
    def __init__(self):
        self.entities: List[Entity] = []
        self.current_node_name: Optional[str] = None
        # Cluster tracking for multiple periods
        self.cluster_uuid: Optional[str] = None  # Primary/first cluster (backward compatibility)
        self.cluster_periods: List[Dict] = []  # List of {uuid, start_time, end_time, entities}
        self.cluster_ref: Optional[str] = None
        self._state_exchange_names: Dict[int, str] = {}
        self._uuid_name_map: Dict[str, str] = {}
        self._name_uuid_map: Dict[str, str] = {}
        self._node_uuid_history: Dict[str, List[str]] = {}
        
        # Local node information for current log file
        self.local_node_name: Optional[str] = None
        self.local_node_uuid: Optional[str] = None
        self.local_node_uuid_set: set = set()  # Set of all UUIDs for the local node
        
        # View parsing state
        self._view_block_active = False
        self._view_block_lines = []
        self._view_block_start_line = 0
        self._view_block_log_source = ""
        self._view_block_timestamp = None
        self._current_view_data = None
        self._current_view_section = None
        self._wsrep_view_block_active = False
        self._wsrep_view_lines = []
        self._wsrep_view_start_line = 0
        self._wsrep_view_log_source = ""
        self._wsrep_view_timestamp = None
    
    def parse_log(self, log_content: str, log_source: str = "unknown") -> List[Entity]:
        """Parse log content and return entities"""
        # Reset node context for new log file to prevent cross-contamination
        self.current_node_name = None
        self.local_node_name = None
        self.local_node_uuid = None
        self.local_node_uuid_set = set()
        
        lines = log_content.strip().split('\n')
        
        # FIRST PASS: Comprehensive local node identification
        print(f"[GRAP] Pre-processing {log_source} to identify local node...", file=sys.stderr)
        print(f"[GRAP] Processing {len(lines)} lines...", file=sys.stderr)
        local_node_timeline = []  # List of (line_num, node_name, node_uuid)
        
        # Enhanced patterns for local node detection
        uuid_patterns = [
            r"##*\s*my\s+uuid[:\s]+([0-9a-f-]{36})",  # "####### My UUID: ..."
            r"my\s+uuid[:\s]+([0-9a-f-]{36})",         # "my uuid: ..."
            r"local\s+uuid[:\s]+([0-9a-f-]{36})",      # "local uuid: ..."
        ]
        
        node_name_patterns = [
            r"Setting\s+wsrep_node_name\s+to\s+'([^']+)'",
            r"Node\s+name[:\s]+'?([^']+)'?",
            r"wsrep_node_name[:\s]+=\s*'?([^']+)'?",
            r"Server\s+([^\s]+)\s+connected",
            r"Node\s+([^\s,]+)[,\s]",
        ]
        
        # Additional patterns for view-based local node detection
        my_idx_pattern = r"my_idx\s*=\s*(\d+)"
        state_exchange_pattern = r"got\s+state\s+msg.*from\s+(\d+)\s+\(([^)]+)\)"
        
        # Track view information for local node detection
        my_idx = None
        idx_to_node_name = {}  # Map of node index to node name
        node_uuid_sets = {}    # Map of node_name -> set of UUIDs (long and short format)
        local_node_timeline = []  # List of (line_num, node_name, node_uuid)
        
        def add_uuid_to_node(node_name, uuid_value):
            """Add UUID to node's UUID set, tracking both long and short formats"""
            if node_name not in node_uuid_sets:
                node_uuid_sets[node_name] = set()
            
            # Add the UUID as-is
            node_uuid_sets[node_name].add(uuid_value.lower())
            
            # Add short format if this is a long UUID
            if len(uuid_value) == 36 and '-' in uuid_value:
                # Extract short format: first 8 chars + last 4 chars
                short_uuid = uuid_value[:8] + '-' + uuid_value[-4:]
                node_uuid_sets[node_name].add(short_uuid.lower())
            
            print(f"[GRAP] Added UUID {uuid_value} to node {node_name} (total: {len(node_uuid_sets[node_name])} UUIDs)", file=sys.stderr)
        
        def is_local_node_uuid(uuid_value, local_node_name):
            """Check if UUID belongs to the local node"""
            if not local_node_name or local_node_name not in node_uuid_sets:
                return False
            
            uuid_lower = uuid_value.lower()
            local_uuids = node_uuid_sets[local_node_name]
            
            # Direct match
            if uuid_lower in local_uuids:
                return True
            
            # Check if this is a short format of a long UUID we have
            if len(uuid_value) == 13 and '-' in uuid_value:  # short format
                for stored_uuid in local_uuids:
                    if len(stored_uuid) == 36:  # long format
                        stored_short = stored_uuid[:8] + '-' + stored_uuid[-4:]
                        if uuid_lower == stored_short:
                            return True
            
            # Check if this is a long format of a short UUID we have
            elif len(uuid_value) == 36 and '-' in uuid_value:  # long format
                short_version = uuid_value[:8] + '-' + uuid_value[-4:]
                if short_version.lower() in local_uuids:
                    return True
            
            return False
        
        for line_num, line in enumerate(lines, 1):
            # Look for my_idx in view blocks
            my_idx_match = re.search(my_idx_pattern, line, re.IGNORECASE)
            if my_idx_match:
                my_idx = int(my_idx_match.group(1))
                print(f"[GRAP] Found my_idx: {my_idx} at line {line_num}", file=sys.stderr)
            
            # Look for state exchange messages to map index to node name
            state_exchange_match = re.search(state_exchange_pattern, line, re.IGNORECASE)
            if state_exchange_match:
                node_idx = int(state_exchange_match.group(1))
                node_name = state_exchange_match.group(2).strip()
                idx_to_node_name[node_idx] = node_name
                print(f"[GRAP] Mapped node index {node_idx} to {node_name} at line {line_num}", file=sys.stderr)
            
            # Look for UUID patterns to identify the local node
            uuid_value = None
            for uuid_pattern in uuid_patterns:
                uuid_match = re.search(uuid_pattern, line, re.IGNORECASE)
                if uuid_match:
                    uuid_value = uuid_match.group(1).strip().lower()
                    print(f"[GRAP] Found UUID: {uuid_value} at line {line_num}", file=sys.stderr)
                    break
            
            if uuid_value:
                # Try to find the node name in nearby context
                node_name = None
                
                # First, try to use my_idx and index mapping
                if my_idx is not None and my_idx in idx_to_node_name:
                    node_name = idx_to_node_name[my_idx]
                    print(f"[GRAP] Using my_idx mapping: local node is {node_name}", file=sys.stderr)
                
                # Check current line for node name
                if not node_name:
                    for name_pattern in node_name_patterns:
                        node_match = re.search(name_pattern, line, re.IGNORECASE)
                        if node_match:
                            node_name = node_match.group(1).strip()
                            break
                
                # If not found, search in nearby lines (expanded search)
                if not node_name:
                    search_start = max(0, line_num - 20)
                    search_end = min(len(lines), line_num + 20)
                    for search_line in lines[search_start:search_end]:
                        for name_pattern in node_name_patterns:
                            node_match = re.search(name_pattern, search_line, re.IGNORECASE)
                            if node_match:
                                node_name = node_match.group(1).strip()
                                break
                        if node_name:
                            break
                
                # If still no node name, extract from view information or use fallback
                if not node_name and line_num <= 50:
                    node_name = "node_from_" + log_source.split('/')[-1].replace('.', '_').replace('-', '_')
                
                if node_name:
                    # Add this UUID to the node's UUID set
                    add_uuid_to_node(node_name, uuid_value)
                    local_node_timeline.append((line_num, node_name, uuid_value))
                    print(f"[GRAP] Associated UUID {uuid_value} with node {node_name} at line {line_num}", file=sys.stderr)
        
        # Set local node info with validation using UUID sets
        if local_node_timeline:
            _, self.local_node_name, self.local_node_uuid = local_node_timeline[0]
            self.current_node_name = self.local_node_name
            
            # Store all UUIDs for this local node for later matching
            if self.local_node_name in node_uuid_sets:
                self.local_node_uuid_set = node_uuid_sets[self.local_node_name]
                print(f"[GRAP] ✅ Local node identified: {self.local_node_name} with {len(self.local_node_uuid_set)} UUIDs", file=sys.stderr)
                for uuid in sorted(self.local_node_uuid_set):
                    print(f"[GRAP]   UUID: {uuid}", file=sys.stderr)
            else:
                self.local_node_uuid_set = {self.local_node_uuid.lower()} if self.local_node_uuid else set()
                uuid_display = self.local_node_uuid[:8] + "..." if self.local_node_uuid else "unknown"
                print(f"[GRAP] ✅ Local node identified: {self.local_node_name} (single UUID: {uuid_display})", file=sys.stderr)
            
            if len(local_node_timeline) > 1:
                print(f"[GRAP] Found {len(local_node_timeline)} UUID entries for {self.local_node_name}", file=sys.stderr)
        else:
            print(f"[GRAP] ⚠️  WARNING: No local node identification found in {log_source}", file=sys.stderr)
            print(f"[GRAP] ⚠️  Local state patterns (shifting, etc.) will be skipped to avoid misattribution", file=sys.stderr)
            # Don't proceed with local patterns if we can't identify the local node
            self.local_node_name = None
            self.local_node_uuid = None
            self.local_node_uuid_set = set()

        # --- Quorum block extraction ---
        quorum_block = []
        quorum_start = None
        for idx, line in enumerate(lines):
            if 'WSREP: Quorum results:' in line:
                quorum_block = [line]
                quorum_start = idx
            elif quorum_block:
                quorum_block.append(line)
                if re.match(r'.*group UUID\s*=\s*([0-9a-f-]+)', line):
                    # End of quorum block
                    # Parse fields
                    ts_match = re.match(r'^(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2})', quorum_block[0])
                    timestamp = None
                    if ts_match:
                        try:
                            timestamp = datetime.strptime(ts_match.group(1), "%Y-%m-%d %H:%M:%S")
                        except Exception:
                            pass
                    fields = {
                        'version': '', 'component': '', 'conf_id': '', 'quorum_members': '',
                        'act_id': '', 'last_appl': '', 'protocols': '', 'vote_policy': '', 'group_uuid': ''
                    }
                    key_map = {
                        'version': 'version',
                        'component': 'component',
                        'conf_id': 'conf_id',
                        'members': 'quorum_members',
                        'act_id': 'act_id',
                        'last_appl': 'last_appl',
                        'protocols': 'protocols',
                        'vote_policy': 'vote_policy',
                        'group_uuid': 'group_uuid',
                    }
                    # Allow string assignment
                    for l in quorum_block:
                        for pat_key, field_key in key_map.items():
                            pat = rf'{pat_key.replace("_", ".").replace("group.uuid", "group UUID").replace("last.appl", "last_appl.")}[\s:=]+([\w\-/().]+)'
                            m = re.search(pat, l.replace('last_appl.', 'last_appl.').replace('group UUID', 'group UUID'))
                            if m:
                                fields[field_key] = str(m.group(1))
                        # Special for group_uuid
                        m = re.search(r'group UUID\s*=\s*([0-9a-f-]+)', l)
                        if m:
                            fields['group_uuid'] = str(m.group(1))
                    entity = QuorumEntity(
                        timestamp=timestamp,
                        line_number=quorum_start+1 if quorum_start is not None else 0,
                        raw_lines='\n'.join(quorum_block),
                        log_source=log_source,
                        group_uuid=fields['group_uuid'],
                        version=fields['version'],
                        component=fields['component'],
                        conf_id=fields['conf_id'],
                        quorum_members=fields['quorum_members'],
                        act_id=fields['act_id'],
                        last_appl=fields['last_appl'],
                        protocols=fields['protocols'],
                        vote_policy=fields['vote_policy']
                    )
                    self.entities.append(entity)
                    quorum_block = []
                    quorum_start = None
        # --- End Quorum block extraction ---

        for line_num, line in enumerate(lines, 1):
            # Update local node context if this line represents a restart/UUID change
            self._update_local_node_context(line_num, local_node_timeline)
            self._parse_line(line, line_num, log_source)
        
        # Complete any pending view block
        if self._view_block_active:
            self._complete_view_block(line_num)
        
        # Debug: print cluster_uuid before scan
        # Always scan for cluster UUIDs to detect multiple cluster periods
        self._scan_for_cluster_uuid(lines)
        
        # If still not found, try to get from first ViewEntity
        if not self.cluster_uuid:
            for entity in self.entities:
                if isinstance(entity, ViewEntity) and entity.cluster_uuid:
                    self.cluster_uuid = entity.cluster_uuid
                    break
        else:
            print(f"[GRAP DEBUG] Skipping ViewEntity fallback (cluster_uuid now set: {self.cluster_uuid})", file=sys.stderr)

        # Assign cluster_ref to all entities
        if not self.cluster_ref and self.cluster_uuid:
            self.cluster_ref = f"cluster_{self.cluster_uuid[:8]}"
        elif not self.cluster_ref:
            # Try to derive from first view
            for entity in self.entities:
                if isinstance(entity, ViewEntity) and entity.cluster_uuid:
                    self.cluster_ref = f"cluster_{entity.cluster_uuid[:8]}"
                    break
            if not self.cluster_ref:
                self.cluster_ref = "_unknown_cluster"
        
        # Update all entities with cluster_ref (rebuild with dataclasses.replace for frozen dataclasses)
        from dataclasses import replace
        new_entities = []
        for entity in self.entities:
            if not getattr(entity, 'cluster_ref', None):
                # Get the correct cluster UUID for this entity's timestamp
                entity_timestamp = getattr(entity, 'timestamp', None)
                correct_cluster_uuid = self.get_cluster_for_timestamp(entity_timestamp)
                if correct_cluster_uuid:
                    cluster_ref = f"cluster_{correct_cluster_uuid[:8]}"
                else:
                    cluster_ref = self.cluster_ref  # Fallback to default
                entity = replace(entity, cluster_ref=cluster_ref)
            new_entities.append(entity)
        self.entities = new_entities
        
        # Add cluster entities - one for each unique cluster UUID discovered
        created_clusters = set()
        
        if self.cluster_periods:
            # Multiple clusters detected - create entity for each unique cluster
            for i, period in enumerate(self.cluster_periods):
                cluster_uuid = period['cluster_uuid']
                if cluster_uuid and cluster_uuid not in created_clusters:
                    # Calculate statistics for this cluster period
                    cluster_stats = self._calculate_cluster_statistics(cluster_uuid, period)
                    
                    cluster_entity = ClusterEntity(
                        timestamp=period['start_time'],
                        line_number=period['start_line'],
                        raw_line="",
                        log_source=log_source,
                        entity_id=f"cluster_{cluster_uuid[:8]}",
                        cluster_uuid=cluster_uuid,
                        cluster_ref=f"cluster_{cluster_uuid[:8]}",
                        cluster_start_time=period['start_time'],
                        cluster_end_time=period['end_time'],
                        analysis_start_time=period['start_time'],
                        max_members_seen=cluster_stats['max_members'],
                        total_sst_operations=cluster_stats['sst_count'],
                        total_view_changes=cluster_stats['view_count'],
                        split_brain_events=cluster_stats['split_brain_count'],
                        error_count=cluster_stats['error_count'],
                        warning_count=cluster_stats['warning_count']
                    )
                    self.entities.insert(0, cluster_entity)
                    created_clusters.add(cluster_uuid)
                    
        elif self.cluster_uuid and self.cluster_uuid not in created_clusters:
            # Single cluster UUID (backward compatibility)
            first_ts = self.entities[0].timestamp if self.entities and getattr(self.entities[0], 'timestamp', None) else None
            analysis_start_time = first_ts if isinstance(first_ts, datetime) else datetime.now()
            
            # Calculate statistics for single cluster
            period = {'start_time': first_ts, 'end_time': None}
            cluster_stats = self._calculate_cluster_statistics(self.cluster_uuid, period)
            
            cluster_entity = ClusterEntity(
                timestamp=first_ts,
                line_number=0,
                raw_line="",
                log_source=log_source,
                entity_id=f"cluster_{self.cluster_uuid[:8]}",
                cluster_uuid=self.cluster_uuid,
                cluster_ref=self.cluster_ref,
                cluster_start_time=first_ts,
                cluster_end_time=None,  # Still active
                analysis_start_time=analysis_start_time,
                max_members_seen=cluster_stats['max_members'],
                total_sst_operations=cluster_stats['sst_count'],
                total_view_changes=cluster_stats['view_count'],
                split_brain_events=cluster_stats['split_brain_count'],
                error_count=cluster_stats['error_count'],
                warning_count=cluster_stats['warning_count']
            )
            self.entities.insert(0, cluster_entity)
            created_clusters.add(self.cluster_uuid)

        # Ensure we emit canonical NodeEntity entries (one per node) using discovered names
        for node_name, history in self._node_uuid_history.items():
            if self._is_placeholder_name(node_name):
                continue  # Skip placeholder/unspecified nodes
            primary_uuid = self._select_primary_uuid(history) if history else None
            node_entity = NodeEntity(
                entity_id=f"node_{node_name}",
                node_name=node_name,
                long_uuid=primary_uuid or "",
                cluster_ref=self.cluster_ref,
                cluster_uuid=self.cluster_uuid or "",
                uuid_history=tuple(history)
            )
            # Avoid duplicates if already present
            existing = [e for e in self.entities if type(e).__name__ == "NodeEntity" and getattr(e, "node_name", None) == node_name]
            if not existing:
                self.entities.append(node_entity)
        
        return self.entities

    def _infer_node_name_from_source(self, log_source: str) -> Optional[str]:
        """Historically inferred node names from log source path; disabled per requirements."""
        return None

    def _shorten_uuid(self, uuid_str: str) -> Optional[str]:
        """Generate shortened UUID variant used by Galera view listings."""
        if not uuid_str:
            return None
        parts = uuid_str.split('-')
        if len(parts) >= 4:
            return f"{parts[0]}-{parts[3]}"
        return None

    def _register_member_name(self, name: str, index: Optional[int] = None, uuid: Optional[str] = None):
        """Register mapping metadata so we can resolve view members to canonical names."""
        # Ignore placeholder names such as 'unspecified' that may appear in raw view dumps
        if name and isinstance(name, str) and name.strip().lower() in {"unknown", "joiner", "donor", "cluster", "n/a", "unspecified"}:
            return
        if index is not None:
            self._state_exchange_names[index] = name
        identifiers: Set[str] = set()
        if uuid:
            norm_uuid = uuid.strip().lower()
            self._uuid_name_map[norm_uuid] = name
            identifiers.add(norm_uuid)
            short_uuid = self._shorten_uuid(norm_uuid)
            if short_uuid:
                self._uuid_name_map[short_uuid] = name
                identifiers.add(short_uuid)
            compact_uuid = norm_uuid.replace('-', '')
            if compact_uuid:
                self._uuid_name_map[compact_uuid] = name
                identifiers.add(compact_uuid)
            self._name_uuid_map[name] = norm_uuid
            self._register_node_uuid(name, norm_uuid)
        if identifiers:
            self._backfill_view_members(name, identifiers, uuid)

    def _resolve_member_name(self, identifier: str) -> Optional[str]:
        """Resolve a member identifier (index/uuid/short uuid) to a registered node name."""
        if identifier is None:
            return None
        candidate = identifier.strip().lower()
        if not candidate:
            return None
        if candidate.isdigit():
            idx = int(candidate)
            if idx in self._state_exchange_names:
                return self._state_exchange_names[idx]
        if candidate in self._uuid_name_map:
            return self._uuid_name_map[candidate]
        short_candidate = self._shorten_uuid(candidate)
        if short_candidate and short_candidate in self._uuid_name_map:
            return self._uuid_name_map[short_candidate]
        compact_candidate = candidate.replace('-', '')
        if compact_candidate in self._uuid_name_map:
            return self._uuid_name_map[compact_candidate]
        return None

    def _is_placeholder_name(self, name: Optional[str]) -> bool:
        """Return True when the given name is a placeholder that should not be treated as a real node."""
        if not name:
            return False
        try:
            nlow = str(name).strip().lower()
        except Exception:
            return False
        return nlow in {"unknown", "joiner", "donor", "cluster", "n/a", "unspecified"}

    def _normalize_node_state(self, raw: Optional[str]) -> Optional[str]:
        """Normalize a raw node state string to one of the canonical states.

        Canonical states: CLOSED, OPEN, PRIMARY, JOINER, JOINED, SYNCED, DONOR/DESYNCED
        The function extracts the RHS of arrow-style strings and maps to exact canonical values.
        Returns None for non-canonical states.
        """
        if not raw:
            return None
        s = str(raw).strip()
        # If it's an arrow 'A -> B' take RHS
        if '->' in s:
            parts = s.split('->')
            s = parts[-1].strip()
        
        # Exact case-insensitive matching with canonical states
        s_upper = s.upper()
        canonical_states = {'CLOSED', 'OPEN', 'PRIMARY', 'JOINER', 'JOINED', 'SYNCED', 'DONOR/DESYNCED'}
        
        if s_upper in canonical_states:
            return s_upper
        
        # Non-canonical states - return None to ignore them
        return None

    def _backfill_view_members(self, name: str, identifiers: Set[str], uuid: Optional[str]):
        """Update previously parsed view entities once canonical mappings become available."""
        if not identifiers:
            return
        lowered_identifiers = {ident.lower() for ident in identifiers}
        # No mutation allowed for frozen ViewEntity; skip backfill
        return

    def _is_full_uuid(self, value: str) -> bool:
        return bool(re.match(r'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$', value))

    def _select_primary_uuid(self, aliases: List[str]) -> Optional[str]:
        for alias in reversed(aliases):
            if self._is_full_uuid(alias):
                return alias
        return aliases[-1] if aliases else None

    def _refresh_uuid_aliases(self, node_name: str):
        history = self._node_uuid_history.get(node_name, [])
        if not history:
            return
        for alias in history:
            self._uuid_name_map[alias] = node_name
            self._uuid_name_map[alias.replace('-', '')] = node_name
        primary = self._select_primary_uuid(history)
        if primary:
            self._name_uuid_map[node_name] = primary

    def _register_node_uuid(self, node_name: Optional[str], uuid: Optional[str]):
        """Record uuid assignments per node and update existing entities, skipping placeholders."""
        if not node_name or not uuid:
            return
        norm_name = node_name.strip()
        if self._is_placeholder_name(norm_name):
            return  # Never register placeholder/unspecified nodes
        norm_uuid = uuid.strip().lower()
        if not norm_name or not norm_uuid:
            return
        history = self._node_uuid_history.setdefault(norm_name, [])

        def _add_alias(alias: Optional[str]):
            if not alias:
                return False
            alias_lc = alias.lower()
            if alias_lc not in history:
                history.append(alias_lc)
                return True
            return False

        added = _add_alias(norm_uuid)
        short_uuid = self._shorten_uuid(norm_uuid)
        added = _add_alias(short_uuid) or added

        # Maintain fast lookup aliases even if we don't keep them in history
        self._uuid_name_map[norm_uuid] = norm_name
        if short_uuid:
            self._uuid_name_map[short_uuid] = norm_name
        compact_uuid = norm_uuid.replace('-', '')
        if compact_uuid:
            self._uuid_name_map[compact_uuid] = norm_name

        self._refresh_uuid_aliases(norm_name)
        self._backfill_node_uuid(norm_name)

    def _backfill_node_uuid(self, node_name: str):
        """No-op: NodeEntity is now immutable; cannot mutate existing entities."""
        return

    def _backfill_node_entities(self, previous_name: Optional[str], new_name: str):
        """No-op: NodeEntity is now immutable; cannot mutate existing entities."""
        return

    def _should_backfill_node_name(self, previous_name: Optional[str], candidate_name: str) -> bool:
        """Determine if we should update previously inferred node names."""
        if not previous_name or not candidate_name:
            return False
        prev_norm = previous_name.lower()
        cand_norm = candidate_name.lower()
        if prev_norm == cand_norm:
            return False
        # Only backfill when prior name appears to be a truncated version of the candidate
        cand_without_digits = re.sub(r"\d+", "", cand_norm)
        if prev_norm == cand_without_digits:
            return True
        # Also allow hyphen/underscore stripping cases
        cand_compact = re.sub(r"[\W_]", "", cand_norm)
        prev_compact = re.sub(r"[\W_]", "", prev_norm)
        if prev_compact and prev_compact == cand_compact:
            return True
        return False
    
    def _scan_for_cluster_uuid(self, lines: List[str]):
        """Scan for cluster/group UUID and track multiple cluster periods"""
        # Cluster UUID patterns with context information  
        # Context: 'cluster' = cluster-wide information
        patterns = [
            (r'group\s+UUID\s*=\s*([0-9a-f-]+)', 'group UUID = ...', 'cluster'),
            (r'Group UUID\s*:\s*([0-9a-f-]+)', 'Group UUID   : ...', 'cluster'),
            (r'cluster id ([0-9a-f-]+)', 'Recovered cluster id ...', 'cluster'),
            (r'cluster\s+UUID:\s*([0-9a-f-]+)', 'cluster UUID: ...', 'cluster'),
            (r'View:\s*id:\s*([0-9a-f-]+):', 'View: id: <uuid>:', 'cluster'),
            (r'Group state:\s*([0-9a-f-]+):', 'Group state: <uuid>:', 'cluster'),
        ]
        
        detected_uuids = []  # List of (timestamp, uuid, line_num)
        
        for line_num, line in enumerate(lines, 1):
            timestamp = self._extract_timestamp(line)
            for pattern, desc, context in patterns:
                match = re.search(pattern, line, re.IGNORECASE)
                if match:
                    uuid = match.group(1)
                    detected_uuids.append((timestamp, uuid, line_num))
                    break  # Only one pattern per line
        
        # Process detected UUIDs to create cluster periods
        if detected_uuids:
            self._create_cluster_periods(detected_uuids)
            # For backward compatibility, keep the first detected UUID as primary
            # if cluster_uuid wasn't already set by view parsing
            if not self.cluster_uuid and self.cluster_periods:
                self.cluster_uuid = self.cluster_periods[0]['cluster_uuid']
            # If cluster_uuid was set by view parsing but we found multiple periods,
            # verify it matches one of the detected UUIDs
            elif self.cluster_uuid and self.cluster_periods:
                detected_uuid_set = {period['cluster_uuid'] for period in self.cluster_periods}
                if self.cluster_uuid not in detected_uuid_set:
                    # The view-detected UUID doesn't match scan results, use first from scan
                    self.cluster_uuid = self.cluster_periods[0]['cluster_uuid']

    def _create_cluster_periods(self, detected_uuids: List[Tuple]):
        """Create cluster periods from detected UUIDs with timeline analysis"""
        if not detected_uuids:
            return
            
        # Sort by timestamp
        detected_uuids.sort(key=lambda x: x[0] if x[0] else datetime.min)
        
        current_period = None
        
        for timestamp, uuid, line_num in detected_uuids:
            # Check if this is a new cluster period (different UUID)
            if not current_period or current_period['cluster_uuid'] != uuid:
                # End previous period
                if current_period:
                    current_period['end_time'] = timestamp
                
                # Start new period
                current_period = {
                    'cluster_uuid': uuid,
                    'start_time': timestamp,
                    'end_time': None,  # Will be set when period ends or at process end
                    'start_line': line_num,
                    'entity_count': 0
                }
                self.cluster_periods.append(current_period)
        
        # Close the last period (it goes to end of log)
        if current_period:
            current_period['end_time'] = detected_uuids[-1][0]  # Use last timestamp
    
    def get_cluster_for_timestamp(self, timestamp: Optional[datetime]) -> Optional[str]:
        """Get the correct cluster UUID for a given timestamp"""
        if not timestamp or not self.cluster_periods:
            return self.cluster_uuid  # Fallback to primary for backward compatibility
            
        for period in self.cluster_periods:
            start = period['start_time']
            end = period['end_time']
            
            # Check if timestamp falls within this period
            if start and timestamp >= start:
                if not end or timestamp <= end:
                    return period['cluster_uuid']
        
        # Fallback to primary cluster
        return self.cluster_uuid
    
    def _calculate_cluster_statistics(self, cluster_uuid: str, period: Dict) -> Dict[str, int]:
        """Calculate statistics for a specific cluster period"""
        start_time = period.get('start_time')
        end_time = period.get('end_time')
        
        # Filter entities that belong to this cluster period
        cluster_entities = [
            e for e in self.entities 
            if getattr(e, 'cluster_ref', '') == f"cluster_{cluster_uuid[:8]}" and
            self._entity_in_period(e, start_time, end_time)
        ]
        
        # Count different entity types
        # For SST count, count SST initiation events (request or donor_selected)
        sst_count = len([
            e for e in cluster_entities 
            if (e.entity_type.value == 'sst' and 
                hasattr(e, 'event_type') and 
                getattr(e, 'event_type', None) in ('request', 'donor_selected'))
        ])
        
        view_count = len([e for e in cluster_entities if e.entity_type.value == 'view'])
        error_count = len([e for e in cluster_entities if e.entity_type.value == 'error'])
        warning_count = len([e for e in cluster_entities if e.entity_type.value == 'warning'])
        
        # Calculate max members seen from ViewEntity instances
        max_members = 0
        for entity in cluster_entities:
            # Check if it's a ViewEntity or has members attribute
            if (entity.entity_type.value == 'view' and 
                hasattr(entity, 'members') and 
                getattr(entity, 'members', None)):
                try:
                    members_list = getattr(entity, 'members')
                    if members_list:
                        max_members = max(max_members, len(members_list))
                except (AttributeError, TypeError):
                    # Skip if members can't be accessed
                    pass
        
        # Calculate split-brain events (simplified deterministic count)
        # Group views by timestamp and check for conflicting memberships
        split_brain_count = self._count_split_brain_events(cluster_entities)
        
        return {
            'max_members': max_members,
            'sst_count': sst_count,
            'view_count': view_count,
            'split_brain_count': split_brain_count,
            'error_count': error_count,
            'warning_count': warning_count
        }
    
    def _entity_in_period(self, entity, start_time, end_time) -> bool:
        """Check if entity falls within the time period"""
        if not hasattr(entity, 'timestamp') or not entity.timestamp:
            return True  # Include entities without timestamps
        
        if start_time and entity.timestamp < start_time:
            return False
        if end_time and entity.timestamp > end_time:
            return False
        return True
    
    def _count_split_brain_events(self, cluster_entities) -> int:
        """Count split-brain events using deterministic formula"""
        # Get view entities and group by timestamp (within 30-second tolerance)
        view_entities = [e for e in cluster_entities if e.entity_type.value == 'view']
        if len(view_entities) < 2:
            return 0
        
        from collections import defaultdict
        timestamp_groups = defaultdict(list)
        tolerance_seconds = 30
        
        for view in view_entities:
            if view.timestamp:
                # Round to nearest 30-second interval for grouping
                rounded_time = datetime.fromtimestamp(
                    (view.timestamp.timestamp() // tolerance_seconds) * tolerance_seconds
                )
                timestamp_groups[rounded_time].append(view)
        
        # Count groups with conflicting memberships
        split_brain_events = 0
        for timestamp, views_at_time in timestamp_groups.items():
            if len(views_at_time) > 1:
                # Check for different memberships
                memberships = set()
                for view in views_at_time:
                    try:
                        if hasattr(view, 'members'):
                            members_list = getattr(view, 'members', [])
                            if members_list:
                                memberships.add(tuple(sorted(members_list)))
                    except (AttributeError, TypeError):
                        # Skip if members can't be accessed
                        pass
                
                # Multiple different memberships at same time = split brain
                if len(memberships) > 1:
                    split_brain_events += 1
        
        return split_brain_events
    
    def _parse_line(self, line: str, line_num: int, log_source: str):
        """Parse a single log line"""
        # Skip empty lines
        if not line.strip():
            return
        
        # Parse different entity types
        self._parse_node_events(line, line_num, log_source)
        self._parse_view_events(line, line_num, log_source)
        self._parse_sst_events(line, line_num, log_source)
        self._parse_ist_events(line, line_num, log_source)
        self._parse_error_events(line, line_num, log_source)
    
    def _update_local_node_context(self, current_line_num: int, local_node_timeline):
        """Update local node context based on timeline of UUID changes (for restarts)"""
        # Find the most recent node identity for this line number
        active_node_name = None
        active_node_uuid = None
        
        for line_num, node_name, node_uuid in local_node_timeline:
            if line_num <= current_line_num:
                active_node_name = node_name
                active_node_uuid = node_uuid
            else:
                break
        
        # Update local node context if it changed
        if active_node_name and active_node_uuid:
            # Check if this UUID belongs to our known local node UUIDs
            uuid_matches = False
            if hasattr(self, 'local_node_uuid_set') and self.local_node_uuid_set:
                uuid_matches = active_node_uuid.lower() in self.local_node_uuid_set
                # Also check short format if this is a long UUID
                if not uuid_matches and len(active_node_uuid) == 36 and '-' in active_node_uuid:
                    short_uuid = active_node_uuid[:8] + '-' + active_node_uuid[-4:]
                    uuid_matches = short_uuid.lower() in self.local_node_uuid_set
            
            if (self.local_node_name != active_node_name or 
                (self.local_node_uuid and self.local_node_uuid != active_node_uuid and not uuid_matches)):
                print(f"[DEBUG] Line {current_line_num}: UUID context change {self.local_node_name}:{self.local_node_uuid} -> {active_node_name}:{active_node_uuid}", file=sys.stderr)
                self.local_node_name = active_node_name
                self.local_node_uuid = active_node_uuid
                self.current_node_name = active_node_name
                
                # Add new UUID to the set if it's for the same node
                if hasattr(self, 'local_node_uuid_set') and active_node_name == self.local_node_name:
                    self.local_node_uuid_set.add(active_node_uuid.lower())
                    if len(active_node_uuid) == 36 and '-' in active_node_uuid:
                        short_uuid = active_node_uuid[:8] + '-' + active_node_uuid[-4:]
                        self.local_node_uuid_set.add(short_uuid.lower())

    def _extract_timestamp(self, line: str) -> Optional[datetime]:
        """Extract timestamp from log line"""
        # Pattern for timestamps like "2025-09-25 13:54:32" or "2025-09-23  2:31:29" (single digit hour)
        pattern = r'(\d{4}-\d{2}-\d{2})\s+(\d{1,2}):(\d{2}):(\d{2})'
        match = re.search(pattern, line)
        if match:
            date_str = match.group(1)
            hour = match.group(2).zfill(2)  # Pad single digit hours
            minute = match.group(3)
            second = match.group(4)
            timestamp_str = f"{date_str} {hour}:{minute}:{second}"
            try:
                return datetime.strptime(timestamp_str, "%Y-%m-%d %H:%M:%S")
            except ValueError:
                pass
        return None
    
    def _parse_node_events(self, line: str, line_num: int, log_source: str):
        """Parse node-related events and emit NodeStateEntity (immutable, timestamped)"""
        node_name_patterns = [
            (r"wsrep_node_name\s*[:=]\s*'?([^']+)'?", 1),
            (r"Setting\s+wsrep_node_name\s+to\s+'([^']+)'", 1),
            (r"Node\s+name:\s*'?([^']+)'?", 1),
            (r"SST\s+request:\s*.*\s+from:\s*'([^']+)'", 1),
            (r"Server\s+([^\s]+)\s+synced\s+with\s+group", 1),
        ]
        for pattern, group_idx in node_name_patterns:
            match = re.search(pattern, line, re.IGNORECASE)
            if match:
                self.current_node_name = match.group(group_idx).strip()
                break

        connect_match = re.search(r"Server\s+([^\s]+)\s+connected.*?ID\s+([0-9a-f-]{8,})", line, re.IGNORECASE)
        if connect_match:
            node_name = connect_match.group(1).strip()
            node_uuid = connect_match.group(2).strip()
            self.current_node_name = node_name
            self._register_node_uuid(node_name, node_uuid)

        # UUID patterns with better node context detection
        uuid_patterns = [
            r"\bmy\s+uuid:\s*([0-9a-f-]{8,})",
            r"\bwith\s+id\s+([0-9a-f-]{8,})"
        ]
        for uuid_pattern in uuid_patterns:
            match = re.search(uuid_pattern, line, re.IGNORECASE)
            if match:
                uuid_value = match.group(1)
                # Try to find a node name in the same line context first
                line_node_name = None
                for pattern, group_idx in node_name_patterns:
                    node_match = re.search(pattern, line, re.IGNORECASE)
                    if node_match:
                        line_node_name = node_match.group(group_idx).strip()
                        break
                
                # Use line context node name if found, otherwise fall back to current
                target_node_name = line_node_name or self.current_node_name
                if target_node_name:
                    self._register_node_uuid(target_node_name, uuid_value)
                break

        # Node state patterns with context information
        # IMPORTANT: Only process if we have confirmed local node identity
        if self.local_node_name:  # Only process local patterns if we have local node identity
            # Context: 'local' = state changes logged by local node about itself
            # ONLY CANONICAL STATES: CLOSED, OPEN, PRIMARY, JOINER, JOINED, SYNCED, DONOR, DONOR/DESYNCED
            local_node_patterns = [
                (r'.*\[Note\]\s+WSREP:\s+Shifting\s+(CLOSED|OPEN|PRIMARY|JOINER|JOINED|DONOR\/DESYNCED|SYNCED)\s*->\s*(CLOSED|OPEN|PRIMARY|JOINER|JOINED|DONOR\/DESYNCED|SYNCED)', 'shifting', 'local'),  # Local state transitions ONLY
            ]
            
            for pattern, event_type, context in local_node_patterns:
                match = re.search(pattern, line, re.IGNORECASE)
                if match:
                    node_state = None
                    
                    if event_type == 'shifting':  # Shifting X -> Y
                        node_state = match.group(2)  # Only capture the target state
                    
                    if node_state:
                        # Normalize the state
                        normalized_state = self._normalize_node_state(node_state)
                        if normalized_state:
                            # Use confirmed local node name for local context patterns
                            node_name = self.local_node_name
                            timestamp = self._extract_timestamp(line)
                            
                            # Check for duplicate state (avoid creating multiple entities for the same state change)
                            entity_id = f"node_state_{node_name}_{normalized_state}_{line_num}"
                            
                            # Skip if we already created this exact state change at this timestamp
                            duplicate_found = False
                            for existing_entity in self.entities:
                                if (existing_entity.entity_type == 'node_state' and 
                                    getattr(existing_entity, 'node_name', None) == node_name and 
                                    getattr(existing_entity, 'node_state', None) == normalized_state and 
                                    existing_entity.timestamp == timestamp):
                                    duplicate_found = True
                                    break
                            
                            if not duplicate_found:
                                self.entities.append(NodeStateEntity(
                                    entity_id=entity_id,
                                    timestamp=timestamp,
                                    line_number=line_num,
                                    raw_line=line.strip(),
                                    log_source=log_source,
                                    confidence=1.0,
                                    pattern_name="",
                                    extraction_method="local_pattern",  # Mark as local pattern
                                    cluster_ref=self.cluster_ref,
                                    validated=False,
                                    validation_notes="",
                                    node_name=node_name,
                                    node_state=normalized_state,
                                ))
                                print(f"[GRAP] Local state: {node_name} -> {normalized_state} (line {line_num})", file=sys.stderr)
                            else:
                                print(f"[GRAP] Skipped duplicate state: {node_name} -> {normalized_state} (line {line_num})", file=sys.stderr)
                    break
        else:
            # Log that we're skipping local patterns due to missing local node identity
            if any(re.search(pattern, line, re.IGNORECASE) for pattern, _ in [
                (r'.*\[Note\]\s+WSREP:\s+Shifting', 'local'),
                (r'.*\[Note\]\s+WSREP:\s+Synchronized\s+with\s+group', 'local'),
            ]):
                print(f"[GRAP] Skipping potential local state pattern at line {line_num} (no local node identity)", file=sys.stderr)
    
    def _parse_view_events(self, line: str, line_num: int, log_source: str):
        """Parse WSREP view events - handles multi-line views correctly based on Galera source"""
        
        # Check if we're continuing a WSREP provider-level view block
        if self._wsrep_view_block_active:
            self._continue_wsrep_view_block(line, line_num)
            return

        stripped_line = line.strip()
        if 'WSREP:' in stripped_line and '====' in stripped_line and 'view(' not in stripped_line.lower():
            self._start_wsrep_view_block(line, line_num, log_source)
            return

        # Check if we're continuing a multi-line view block
        if self._view_block_active:
            self._continue_view_block(line, line_num)
            return

        # Capture member index/full UUID/name mapping lines often emitted in verbose view dumps
        member_info_match = re.match(
            r'^\s*(\d+):\s*([0-9a-f-]{8,}),\s*([^,\s]+)',
            line,
            re.IGNORECASE
        )
        if member_info_match:
            member_idx = int(member_info_match.group(1))
            member_uuid = member_info_match.group(2).strip()
            member_name = member_info_match.group(3).strip().strip("'\"")
            self._register_member_name(member_name, index=member_idx, uuid=member_uuid)
            return
        
        # Check for STATE EXCHANGE messages to build name mappings
        state_exchange_pattern = r'STATE EXCHANGE:.*from\s+(\d+)\s+\(([^\)]+)\)'
        match = re.search(state_exchange_pattern, line)
        if match:
            node_index = int(match.group(1))
            node_name = match.group(2).strip()
            self._register_member_name(node_name, index=node_index)
            return
        
        # Main view start patterns based on Galera source
        # View patterns with context information
        # Context: 'local' = view seen by local node, 'cluster' = cluster-wide view information
        view_start_patterns = [
            (r'WSREP:\s+view\(view_id\((\w+),([0-9a-f-]+),(\d+)\)', 'standard', 'local'),      # Local node's view
            (r'WSREP:\s+New\s+COMPONENT.*?view_id\((\w+),([0-9a-f-]+),(\d+)\)', 'new_component', 'cluster'),  # Cluster component view
            (r'Current view of cluster.*?view:\s*([0-9a-f-]+):(\d+)', 'alternative', 'cluster')  # Cluster view summary
        ]
        
        for pattern, format_type, context in view_start_patterns:
            match = re.search(pattern, line, re.IGNORECASE)
            if match:
                # Only process local view patterns if we have local node identity
                if context == 'local' and not self.local_node_name:
                    print(f"[GRAP] Skipping local view pattern at line {line_num} (no local node identity)", file=sys.stderr)
                    continue
                    
                self._start_view_block(line, line_num, log_source, match, format_type, context)
                return
    
    def _start_view_block(self, line: str, line_num: int, log_source: str, match, format_type: str, context: str = 'cluster'):
        """Start parsing a multi-line view block"""
        self._view_block_active = True
        self._view_block_lines = [line]
        self._view_block_start_line = line_num
        self._view_block_log_source = log_source
        self._view_block_timestamp = self._extract_timestamp(line)
        self._view_block_context = context  # Store context for later use
        
        # Extract view components based on format
        if format_type in ['standard', 'new_component']:
            self._current_view_data = {
                'type': match.group(1),  # PRIM or NON-PRIM
                'uuid': match.group(2),
                'seq': int(match.group(3)),
                'members': [],
                'joined': [],
                'left': [],
                'partitioned': [],
                'member_segments': {},  # uuid -> segment mapping
                'member_uuid_map': {},
                'owner_name': self.current_node_name
            }
        else:  # alternative format
            self._current_view_data = {
                'type': 'UNKNOWN',
                'uuid': match.group(1),
                'seq': int(match.group(2)),
                'members': [],
                'joined': [],
                'left': [],
                'partitioned': [],
                'member_segments': {},
                'member_uuid_map': {},
                'owner_name': self.current_node_name
            }
            
        # Check if member section starts on same line
        if 'memb {' in line:
            self._current_view_section = 'members'
    
    def _continue_view_block(self, line: str, line_num: int):
        """Continue parsing a multi-line view block"""
        self._view_block_lines.append(line)
        
        # Detect section changes
        if 'memb {' in line:
            self._current_view_section = 'members'
        elif 'joined {' in line:
            self._current_view_section = 'joined'
        elif 'left {' in line:
            self._current_view_section = 'left'
        elif 'partitioned {' in line:
            self._current_view_section = 'partitioned'
        elif '}' in line:
            # Check if this completes the view
            if ')' in line:
                # View block complete
                self._complete_view_block(line_num)
                return
            # Check for double closing (empty section + view close)
            remaining = line[line.index('}') + 1:].strip()
            if remaining.startswith('}'):
                # Also check if there's more sections after
                if any(x in remaining for x in ['joined {', 'left {', 'partitioned {']):
                    self._current_view_section = None
                else:
                    # Might be end of view
                    if ')' in remaining:
                        self._complete_view_block(line_num)
                        return
            # Just ending a section
            self._current_view_section = None
        elif self._current_view_section:
            # Parse member line
            member_line = line.strip()
            if member_line and member_line not in ['{', '}', '(', ')']:
                self._parse_view_member_line(member_line)

    def _start_wsrep_view_block(self, line: str, line_num: int, log_source: str):
        if self._wsrep_view_block_active and self._wsrep_view_lines:
            self._complete_wsrep_view_block(line_num - 1)
        self._wsrep_view_block_active = True
        self._wsrep_view_lines = [line]
        self._wsrep_view_start_line = line_num
        self._wsrep_view_log_source = log_source
        self._wsrep_view_timestamp = self._extract_timestamp(line)

    def _continue_wsrep_view_block(self, line: str, line_num: int):
        self._wsrep_view_lines.append(line)
        if re.match(r'^=+$', line.strip()):
            self._complete_wsrep_view_block(line_num)

    def _complete_wsrep_view_block(self, line_num: int):
        lines = list(self._wsrep_view_lines)
        self._wsrep_view_block_active = False
        self._wsrep_view_lines = []
        if not lines:
            return

        data: Dict[str, Any] = {}
        members_detail: List[Dict[str, Any]] = []
        in_member_section = False

        for raw in lines:
            stripped = raw.strip()
            if not stripped:
                continue
            normalized = stripped
            if 'WSREP:' in normalized:
                parts = normalized.split('WSREP:', 1)
                normalized = parts[1].strip() if len(parts) > 1 else normalized
                if not normalized:
                    continue
            if normalized.lower().startswith('view'):
                continue
            if normalized.startswith('id:'):
                view_id = normalized.split(':', 1)[1].strip()
                data['view_id'] = view_id
                if ':' in view_id:
                    uuid_part, seq_part = view_id.split(':', 1)
                    data['cluster_uuid'] = uuid_part.strip()
                    try:
                        data['view_seq'] = int(seq_part.strip())
                    except ValueError:
                        data['view_seq'] = None
                continue
            if normalized.startswith('status:'):
                data['status'] = normalized.split(':', 1)[1].strip()
                continue
            if normalized.startswith('protocol_version:'):
                value = normalized.split(':', 1)[1].strip()
                try:
                    data['protocol_version'] = int(value)
                except ValueError:
                    data['protocol_version'] = None
                continue
            if normalized.startswith('capabilities:'):
                caps = normalized.split(':', 1)[1].strip()
                capabilities = [c.strip() for c in caps.split(',') if c.strip()]
                data['capabilities'] = capabilities
                continue
            if normalized.startswith('final:'):
                val = normalized.split(':', 1)[1].strip().lower()
                data['final'] = val in {'yes', 'true', '1'}
                continue
            if normalized.startswith('own_index:'):
                val = normalized.split(':', 1)[1].strip()
                try:
                    data['own_index'] = int(val)
                except ValueError:
                    data['own_index'] = None
                continue
            if normalized.startswith('members('):
                in_member_section = True
                count_match = re.search(r'members\((\d+)\)', normalized)
                if count_match:
                    try:
                        data['member_count'] = int(count_match.group(1))
                    except ValueError:
                        pass
                continue
            if in_member_section:
                if normalized.startswith('---') or normalized.startswith('==='):
                    continue
                if normalized.lower().startswith(('joined', 'left', 'partitioned')):
                    in_member_section = False
                    continue
                member_match = re.match(r'^(\d+):\s*([^,]+?)(?:,\s*(.+))?$', normalized)
                if member_match:
                    idx = int(member_match.group(1))
                    member_uuid = member_match.group(2).strip().strip(',')
                    member_name = member_match.group(3).strip() if member_match.group(3) else None
                    entry = {
                        'index': idx,
                        'uuid': member_uuid,
                        'node_name': member_name
                    }
                    members_detail.append(entry)
                    if member_name:
                        self._register_member_name(member_name, index=idx, uuid=member_uuid)
                    else:
                        self._register_member_name(member_uuid, index=idx, uuid=member_uuid)
                    continue
                # If line doesn't match member pattern, leave section
                in_member_section = False

        member_names: List[str] = []
        for entry in members_detail:
            name = entry.get('node_name')
            uuid = entry.get('uuid')
            if name and not self._is_placeholder_name(name):
                member_names.append(name)
            elif uuid:
                member_names.append(uuid)

        if member_names and 'member_count' not in data:
            data['member_count'] = len(member_names)

        status_raw = data.get('status')
        cluster_state = None
        if status_raw:
            lowered = status_raw.strip().lower()
            if lowered == 'primary':
                cluster_state = 'PRIM'
            elif lowered == 'non-primary':
                cluster_state = 'NON_PRIM'
            else:
                cluster_state = status_raw.strip().upper()
        data['cluster_state'] = cluster_state

        cluster_uuid = data.get('cluster_uuid')
        if cluster_uuid and not self.cluster_uuid:
            self.cluster_uuid = cluster_uuid

        cluster_ref = self.cluster_ref
        if not cluster_ref and cluster_uuid:
            cluster_ref = f"cluster_{cluster_uuid[:8]}"
            self.cluster_ref = cluster_ref

        view_seq = data.get('view_seq')
        entity_view_id = data.get('view_id')
        if entity_view_id and cluster_uuid and view_seq is not None:
            entity_id = f"wsrep_view_{cluster_uuid[:8]}_{view_seq}"
        elif entity_view_id:
            safe_id = entity_view_id.replace(':', '_')
            entity_id = f"wsrep_view_{safe_id}"
        else:
            entity_id = f"wsrep_view_{self._wsrep_view_start_line}"

        entity = WsrepViewEntity(
            timestamp=self._wsrep_view_timestamp,
            line_number=self._wsrep_view_start_line,
            raw_line='\n'.join(lines),
            log_source=self._wsrep_view_log_source,
            entity_id=entity_id,
            view_id=data.get('view_id'),
            cluster_uuid=cluster_uuid,
            view_seq=view_seq,
            status=status_raw,
            cluster_state=cluster_state,
            protocol_version=data.get('protocol_version'),
            capabilities=data.get('capabilities', []),
            final=data.get('final'),
            own_index=data.get('own_index'),
            member_count=data.get('member_count'),
            members=member_names,
            member_details=members_detail,
            cluster_ref=cluster_ref
        )
        self.entities.append(entity)
        # Reset WSREP block metadata
        self._wsrep_view_start_line = 0
        self._wsrep_view_log_source = ""
        self._wsrep_view_timestamp = None
    
    def _parse_view_member_line(self, line: str):
        """Parse a member entry from the view"""
        # Format from Galera source: uuid,segment or just uuid
        parts = line.split(',')
        if not parts[0]:
            return
            
        member_id = parts[0].strip()
        segment = 0
        
        # Extract segment if present
        if len(parts) > 1:
            try:
                segment = int(parts[1].strip())
            except ValueError:
                pass
        
        if not self._current_view_data or not self._current_view_section:
            return

        # Resolve member to canonical name if possible
        resolved_name = self._resolve_member_name(member_id)
        segment_key = resolved_name or member_id
        self._current_view_data['member_segments'][segment_key] = segment
        if resolved_name and resolved_name != member_id:
            # Preserve legacy lookup by raw identifier as well
            self._current_view_data['member_segments'][member_id] = segment

        display_value = resolved_name or member_id

        if resolved_name:
            uuid_map = self._current_view_data.setdefault('member_uuid_map', {})
            stored_uuid = self._name_uuid_map.get(resolved_name)
            if stored_uuid:
                    if not self._is_placeholder_name(resolved_name):
                        if resolved_name not in uuid_map:
                            uuid_map[resolved_name] = stored_uuid
                        self._register_node_uuid(resolved_name, stored_uuid)
            elif resolved_name not in uuid_map:
                    if not self._is_placeholder_name(resolved_name):
                        uuid_map[resolved_name] = member_id

        section_members = self._current_view_data[self._current_view_section]
        if display_value not in section_members:
            section_members.append(display_value)
    
    def _complete_view_block(self, line_num: int):
        """Complete the view block and create immutable view and node membership entities"""
        if not self._current_view_data:
            return
        view = self._current_view_data
        component_uuid = view.get('uuid')
        view_seq = view.get('seq')
        effective_cluster_uuid = self.cluster_uuid or component_uuid

        cluster_ref = self.cluster_ref
        if not cluster_ref:
            base_uuid = (effective_cluster_uuid or component_uuid or "unknown")
            cluster_ref = f"cluster_{base_uuid[:8]}"

        if view_seq is not None:
            id_suffix = view_seq
        else:
            id_suffix = self._view_block_start_line

        id_root = (effective_cluster_uuid or component_uuid or "unknown")
        view_entity_id = f"view_{id_root[:8]}_{id_suffix}"

        raw_component_state = view.get('type') or ""
        component_state = raw_component_state if raw_component_state else None
        component_uuid_value = component_uuid or ""
        members_list = list(view.get('members', []))
        joined_list = list(view.get('joined', []))
        left_list = list(view.get('left', []))
        partitioned_list = list(view.get('partitioned', []))
        member_segments_dict = dict(view.get('member_segments', {}))

        def _with_segments(items: List[str]) -> List[str]:
            detailed: List[str] = []
            for item in items:
                seg = member_segments_dict.get(item)
                if seg is None and item in self._name_uuid_map:
                    seg = member_segments_dict.get(self._name_uuid_map[item])
                if seg is not None:
                    detailed.append(f"{item},{seg}")
                else:
                    detailed.append(item)
            return detailed

        members_with_segments = _with_segments(members_list)
        joined_with_segments = _with_segments(joined_list)
        left_with_segments = _with_segments(left_list)
        partitioned_with_segments = _with_segments(partitioned_list)
        if view_seq is not None:
            anchor_uuid = component_uuid_value or effective_cluster_uuid or "unknown"
            view_id = f"{anchor_uuid},{view_seq}"
        else:
            view_id = effective_cluster_uuid or component_uuid or ""
        # Emit the immutable ViewEntity (structural, not time-varying)
        entity = ViewEntity(
            timestamp=self._view_block_timestamp,
            line_number=self._view_block_start_line,
            raw_line='\n'.join(self._view_block_lines),
            log_source=self._view_block_log_source,
            entity_id=view_entity_id,
            view_id=view_id,
            cluster_uuid=(effective_cluster_uuid or ""),
            component_uuid=component_uuid_value,
            view_seq=view_seq,
            cluster_state=(component_state or "unknown"),
            members=members_list,
            joined_nodes=joined_list,
            left_nodes=left_list,
            cluster_ref=cluster_ref
        )
        self.entities.append(entity)
        # Emit NodeViewEntity only for the node that owns this local view snapshot
        component_state = component_state or "UNKNOWN"
        owner_name = view.get('owner_name')
        owner_uuid_norm = None
        if component_uuid_value:
            owner_uuid_norm = component_uuid_value.strip().lower()
        owner_name = owner_name or None
        if owner_uuid_norm:
            owner_name = owner_name or self._uuid_name_map.get(owner_uuid_norm)
            short_uuid = self._shorten_uuid(owner_uuid_norm)
            if not owner_name and short_uuid:
                owner_name = self._uuid_name_map.get(short_uuid)
            compact_uuid = owner_uuid_norm.replace('-', '')
            if not owner_name and compact_uuid:
                owner_name = self._uuid_name_map.get(compact_uuid)
        if not owner_name and self.current_node_name:
            owner_name = self.current_node_name
        member_uuid_map = view.get('member_uuid_map') or {}
        owner_uuid = component_uuid_value or None
        if not owner_uuid and owner_name:
            owner_uuid = self._name_uuid_map.get(owner_name)
        if not owner_uuid and owner_name:
            owner_uuid = member_uuid_map.get(owner_name)

        owner_key_candidates: Set[str] = set()
        for candidate in [owner_name, owner_uuid, self._shorten_uuid(owner_uuid_norm) if owner_uuid_norm else None]:
            if candidate:
                owner_key_candidates.add(str(candidate).strip().lower())
        if owner_uuid_norm:
            owner_key_candidates.add(owner_uuid_norm)
            owner_key_candidates.add(owner_uuid_norm.replace('-', ''))

        def _to_lower_set(items: List[str]) -> Set[str]:
            return {str(it).strip().lower() for it in items}

        membership_sets = {
            "member": _to_lower_set(members_list),
            "joined": _to_lower_set(joined_list),
            "left": _to_lower_set(left_list),
            "partitioned": _to_lower_set(partitioned_list),
        }

        owner_role = None
        for role_name, population in membership_sets.items():
            if any(candidate in population for candidate in owner_key_candidates if candidate):
                owner_role = role_name
                break
        if owner_role is None:
            owner_role = "member" if members_list else None

        display_node_name = owner_name or (owner_uuid if owner_uuid else "unknown")
        node_uuid_value = owner_uuid or None
        if display_node_name and not node_uuid_value:
            node_uuid_value = self._name_uuid_map.get(display_node_name)

        node_cluster_uuid = effective_cluster_uuid or component_uuid
        node_view_entity = NodeViewEntity(
            timestamp=self._view_block_timestamp,
            line_number=self._view_block_start_line,
            raw_line='\n'.join(self._view_block_lines),
            log_source=self._view_block_log_source,
            entity_id=f"nodeview_{display_node_name}_{id_root[:8]}_{id_suffix}",
            node_name=display_node_name,
            node_uuid=node_uuid_value,
            component_uuid=component_uuid_value,
            view_id=view_id,
            cluster_uuid=node_cluster_uuid,
            view_seq=view_seq,
            member_role=owner_role,
            component_state=component_state,
            members=members_with_segments,
            joined=joined_with_segments,
            left=left_with_segments,
            partitioned=partitioned_with_segments,
            cluster_ref=cluster_ref
        )
        self.entities.append(node_view_entity)
    # Reset view block state
        self._view_block_active = False
        self._current_view_data = None
        self._current_view_section = None
        self._view_block_lines = []
    
    def _parse_sst_events(self, line: str, line_num: int, log_source: str):
        """Parse SST-related events and emit SSTEventEntity (atomic) and SSTSessionEntity (session)"""
        # For simplicity, treat each atomic SST event as an SSTEventEntity; session logic can be extended
        # SST patterns with context information
        # Context: 'local' = logged by local node about itself, 'cluster' = about cluster/other nodes
        sst_patterns = [
            (r'Member.*requested\s+state\s+transfer', 'request', 'cluster'),  # SST request - specific pattern  
            (r'Selected\s+[0-9\.]+\s*\(([^)]+)\).*?as\s+donor', 'donor_selected', 'cluster'),  # Cluster coordination message
            (r'donor\s*:\s*(\d+)', 'donor_selected_idx', 'cluster'),  # Cluster donor selection
            (r'SST\s+complete', 'complete', 'local'),  # Local SST completion
            (r'Donor\s+selected:\s*([^\s]+)', 'donor_selected', 'cluster'),  # Cluster donor selection
            (r'SST\s+method:\s*(\w+)', 'method', 'local'),  # Local SST method selection
            (r'Initiating\s+SST.*on\s+DONOR\s+side', 'donor_start', 'local'),  # Local donor starting SST
            (r'Server\s+status\s+change.*->\s*donor', 'donor_status', 'local'),  # Local node becoming donor
        ]
        for pattern, event_type, context in sst_patterns:
            match = re.search(pattern, line, re.IGNORECASE)
            if match:
                # Only process if we have proper node context for local patterns
                if context == 'local' and not self.local_node_name:
                    print(f"[GRAP] Skipping local SST pattern at line {line_num} (no local node identity)", file=sys.stderr)
                    continue
                    
                timestamp = self._extract_timestamp(line)
                donor_node = None
                joiner_node = None
                method = None
                details = None
                
                # Determine node assignment based on context
                if context == 'local' and event_type in ['request', 'complete', 'method']:
                    joiner_node = self.local_node_name  # Local node is the joiner
                elif context == 'local' and event_type in ['donor_start', 'donor_status']:
                    donor_node = self.local_node_name  # Local node is the donor
                elif context == 'cluster':
                    # For cluster patterns, extract node from the pattern match
                    if event_type == 'request':
                        # Extract joiner node from "Member X.Y (NODE_NAME) requested state transfer"
                        member_match = re.search(r'Member\s+[\d\.]+\s*\(([^)]+)\)', line)
                        if member_match:
                            joiner_node = member_match.group(1)
                    elif event_type == 'donor_selected':
                        donor_node = match.group(1)
                    elif event_type == 'donor_selected_idx':
                        idx = int(match.group(1))
                        donor_node = self._state_exchange_names.get(idx)
                
                # Extract additional details
                if event_type == 'method':
                    method = match.group(1)
                elif event_type == 'request':
                    # For request, extract details from the line instead of match groups
                    if "from '*any*'" in line:
                        details = "from *any*"
                    else:
                        details = "state transfer request"
                entity = SSTEventEntity(
                    timestamp=timestamp,
                    line_number=line_num,
                    raw_line=line,
                    log_source=log_source,
                    entity_id=f"sst_event_{event_type}_{line_num}",
                    session_id=None,  # Session tracking can be added
                    event_type=event_type,
                    donor_node=donor_node,
                    joiner_node=joiner_node,
                    method=method,
                    details=details,
                    cluster_ref=self.cluster_ref
                )
                self.entities.append(entity)
                break
    
    def _parse_ist_events(self, line: str, line_num: int, log_source: str):
        """Parse IST-related events and emit ISTEventEntity (atomic) and ISTSessionEntity (session)"""
        # IST patterns with context information
        # Context: 'local' = IST logged by local node, 'cluster' = IST about cluster/other nodes  
        ist_patterns = [
            (r'IST\s+receiver.*?from\s+(\d+)\s+to\s+(\d+)', 'receiver', 'local'),  # Local node receiving IST
            (r'IST\s+sender.*?from\s+(\d+)\s+to\s+(\d+)', 'sender', 'local'),     # Local node sending IST
            (r'Receiving\s+IST.*?(\d+)\s+writesets', 'receiving', 'local'),       # Local node receiving writesets
            (r'Sending\s+IST.*?(\d+)\s+writesets', 'sending', 'local'),           # Local node sending writesets
            (r'IST\s+request.*?from\s+([^\s]+)', 'request_from', 'cluster'),      # Cluster IST request
            (r'IST\s+completed.*?to\s+([^\s]+)', 'completed_to', 'cluster'),      # Cluster IST completion
        ]
        for pattern, event_type, context in ist_patterns:
            match = re.search(pattern, line, re.IGNORECASE)
            if match:
                # Only process local patterns if we have local node identity
                if context == 'local' and not self.local_node_name:
                    print(f"[GRAP] Skipping local IST pattern at line {line_num} (no local node identity)", file=sys.stderr)
                    continue
                    
                timestamp = self._extract_timestamp(line)
                sender_node = None
                receiver_node = None
                seqno_start = None
                seqno_end = None
                transfer_count = None
                details = None
                
                # Determine node assignment based on context
                if context == 'local':
                    if event_type in ('receiver', 'receiving'):
                        receiver_node = self.local_node_name
                    elif event_type in ('sender', 'sending'):
                        sender_node = self.local_node_name
                elif context == 'cluster':
                    # Extract node information from pattern
                    if event_type == 'request_from' and match.groups():
                        sender_node = match.group(1)
                    elif event_type == 'completed_to' and match.groups():
                        receiver_node = match.group(1)
                
                # Extract sequence numbers and counts
                if event_type in ('receiver', 'sender') and len(match.groups()) >= 2:
                    seqno_start = int(match.group(1))
                    seqno_end = int(match.group(2))
                elif event_type in ('receiving', 'sending') and match.groups():
                    transfer_count = int(match.group(1))
                entity = ISTEventEntity(
                    timestamp=timestamp,
                    line_number=line_num,
                    raw_line=line,
                    log_source=log_source,
                    entity_id=f"ist_event_{event_type}_{line_num}",
                    session_id=None,  # Session tracking can be added
                    event_type=event_type,
                    sender_node=sender_node,
                    receiver_node=receiver_node,
                    seqno_start=seqno_start,
                    seqno_end=seqno_end,
                    transfer_count=transfer_count,
                    details=details,
                    cluster_ref=self.cluster_ref
                )
                self.entities.append(entity)
                break
    
    def _parse_error_events(self, line: str, line_num: int, log_source: str):
        """Parse error and warning events as NodeErrorEntity (immutable, timestamped)"""
        # Error patterns with context information
        # Context: 'local' = error logged by local node, 'cluster' = error about cluster/other nodes
        error_patterns = [
            (r'\[ERROR\]\s*WSREP:\s*Failed\s+to\s+read\s+from.*SST', 'ERROR', 'local'),  # Local SST error
            (r'\[ERROR\]\s*WSREP:\s*Process\s+completed\s+with\s+error.*SST', 'ERROR', 'local'),  # Local SST error
            (r'\[ERROR\]\s*WSREP:\s*Command\s+did\s+not\s+run.*SST', 'ERROR', 'local'),  # Local SST error
            (r'\[ERROR\]\s*WSREP:\s*Failed\s+to\s+open\s+channel', 'ERROR', 'local'),  # Local connection error
            (r'\[ERROR\]\s*WSREP:\s*gcs\s+connect\s+failed', 'ERROR', 'local'),  # Local connection error
            (r'\[ERROR\]\s*WSREP:\s*Member\s+([^\s]+).*failed', 'ERROR', 'cluster'),  # Cluster member error
            (r'\[ERROR\]\s*WSREP:\s*Node\s+([^\s]+).*error', 'ERROR', 'cluster'),  # Cluster node error
            (r'\[ERROR\]\s*(.*)', 'ERROR', 'local'),  # Generic local error
            (r'\[Warning\]\s*WSREP:\s*Member\s+([^\s]+)', 'WARNING', 'cluster'),  # Cluster member warning
            (r'\[Warning\]\s*(.*)', 'WARNING', 'local'),  # Generic local warning
            (r'WSREP:\s+Failed\s+to\s+open\s+channel', 'ERROR', 'local'),  # Local connection failure
            (r'WSREP:\s+gcs\s+connect\s+failed', 'ERROR', 'local'),  # Local GCS connection failure
            (r'WSREP:\s+Failed.*', 'ERROR', 'local'),  # Generic WSREP failure (local)
        ]
        for pattern, level, context in error_patterns:
            match = re.search(pattern, line, re.IGNORECASE)
            if match:
                # Only process local patterns if we have local node identity
                if context == 'local' and not self.local_node_name:
                    print(f"[GRAP] Skipping local error pattern at line {line_num} (no local node identity)", file=sys.stderr)
                    continue
                    
                timestamp = self._extract_timestamp(line)
                if timestamp:
                    # Determine node assignment based on context
                    if context == 'local':
                        node_name = self.local_node_name or "unknown_local"
                    elif context == 'cluster':
                        # Try to extract node name from the error message
                        node_name = None
                        if match.groups() and len(match.groups()) >= 2:
                            node_name = match.group(2)  # Second group is the node name
                        if not node_name:
                            node_name = self.current_node_name or "unknown_cluster"
                    else:
                        node_name = self.current_node_name or "unknown"
                    
                    history = self._node_uuid_history.get(node_name, [])
                    primary_uuid = self._select_primary_uuid(history) if history else None
                    
                    # Extract error message
                    error_message = match.group(1) if match.groups() else line
                    
                    entity = NodeErrorEntity(
                        timestamp=timestamp,
                        line_number=line_num,
                        raw_line=line,
                        log_source=log_source,
                        entity_id=f"node_error_{level.lower()}_{line_num}",
                        node_name=node_name,
                        node_uuid=primary_uuid,
                        error_level=level,
                        error_message=error_message,
                        cluster_ref=self.cluster_ref
                    )
                    self.entities.append(entity)
                    print(f"[GRAP] {context.upper()} {level}: {node_name} - {error_message[:50]}...", file=sys.stderr)
                break

def entity_to_dict(entity) -> Any:
    """Convert entity to dictionary for JSON serialization"""
    from dataclasses import is_dataclass, fields
    if isinstance(entity, (str, int, float, bool, type(None))):
        return entity
    elif isinstance(entity, Enum):
        return entity.value
    elif isinstance(entity, (list, tuple)):
        return [entity_to_dict(item) for item in entity]
    elif isinstance(entity, dict):
        # Avoid recursing into dicts that are already converted
        return {k: entity_to_dict(v) for k, v in entity.items()}
    elif is_dataclass(entity):
        result = {}
        for field in fields(entity):
            value = getattr(entity, field.name, None)
            if value is not None:
                if field.name == 'entity_type':
                    # Always use the Enum value (canonical, lowercase)
                    if isinstance(value, Enum):
                        result[field.name] = value.value
                    elif hasattr(value, 'value'):
                        result[field.name] = value.value
                    else:
                        result[field.name] = str(value).lower() if value else ""
                    # Force lowercase for string values
                    if isinstance(result[field.name], str):
                        result[field.name] = result[field.name].lower()
                else:
                    result[field.name] = entity_to_dict(value)
        # Ensure entity_type is set properly and canonical
        if 'entity_type' not in result or not result['entity_type']:
            class_name = type(entity).__name__
            result['entity_type'] = class_name.replace('Entity', '').lower()
        elif isinstance(result['entity_type'], str):
            result['entity_type'] = result['entity_type'].lower()
        return result
    elif hasattr(entity, '__dict__'):
        # Fallback for non-dataclass objects
        return {k: entity_to_dict(v) for k, v in entity.__dict__.items() if v is not None}
    else:
        return str(entity)

def get_cache_key(file_path: str) -> str:
    """Generate cache key for a file"""
    stat = os.stat(file_path)
    return f"{file_path}_{stat.st_mtime}_{stat.st_size}_{GRAP_VERSION}"

def load_from_cache(cache_key: str) -> Optional[List[Entity]]:
    """Load entities from cache"""
    cache_file = CACHE_DIR / f"{hashlib.md5(cache_key.encode()).hexdigest()}.pkl"
    if cache_file.exists():
        try:
            with open(cache_file, 'rb') as f:
                return pickle.load(f)
        except:
            pass
    return None

def save_to_cache(cache_key: str, entities: List[Entity]):
    """Save entities to cache"""
    cache_file = CACHE_DIR / f"{hashlib.md5(cache_key.encode()).hexdigest()}.pkl"
    try:
        with open(cache_file, 'wb') as f:
            pickle.dump(entities, f)
    except:
        pass

def main():
    parser = argparse.ArgumentParser(description='GRAP - Galera Raw Analysis Parser')
    parser.add_argument('files', nargs='*', help='Log files to parse')
    parser.add_argument('--format', choices=['json', 'ndjson'], default='json',
                       help='Output format (default: json)')
    parser.add_argument('--no-cache', action='store_true', help='Disable caching')
    parser.add_argument('--filter', help='Filter entities by type (comma-separated)')
    
    args = parser.parse_args()
    
    # Read input
    all_entities = []
    
    if not args.files or args.files == ['-']:
        # Read from stdin
        content = sys.stdin.read()
        parser = GaleraLogParser()
        entities = parser.parse_log(content, "stdin")
        all_entities.extend(entities)
    else:
        # Read from files
        for file_path in args.files:
            # Try cache first
            cache_key = get_cache_key(file_path) if not args.no_cache else None
            entities = None
            
            if cache_key and not args.no_cache:
                entities = load_from_cache(cache_key)
                if entities:
                    all_entities.extend(entities)
                    continue
            
            # Parse file
            with open(file_path, 'r', errors='ignore') as f:
                content = f.read()
                parser = GaleraLogParser()
                entities = parser.parse_log(content, file_path)
                all_entities.extend(entities)
                
                # Save to cache
                if cache_key and not args.no_cache:
                    save_to_cache(cache_key, entities)
    
    # Filter if requested
    if args.filter:
        filter_types = [t.strip().lower() for t in args.filter.split(',')]
        all_entities = [e for e in all_entities if 
                       str(e.entity_type.value if hasattr(e.entity_type, 'value') 
                           else e.entity_type).lower() in filter_types]

    # Sort all entities chronologically when processing multiple files
    # NOTE: Chronological ordering is only guaranteed to 1-second granularity.
    # Events within the same second from different log files cannot be ordered
    # relative to each other, as log file timestamps typically have 1-second precision.
    if len(args.files) > 1:
        print(f"[GRAP] Sorting {len(all_entities)} entities chronologically across {len(args.files)} files", file=sys.stderr)
        all_entities.sort(key=lambda e: (
            getattr(e, 'timestamp', None) or datetime.min,
            getattr(e, 'line_number', None) or 0,
            getattr(e, 'log_source', None) or ''
        ))

    # Deduplicate node entities across multiple source files
    all_entities = _deduplicate_node_entities(all_entities)

    # Remove all normalization and mutation of node_state for immutable entities
    
    # Add per-timestamp indexing for deterministic sub-ordering when processing multiple files
    if len(args.files) > 1:
        print(f"[GRAP] Adding per-timestamp indices for deterministic frame ordering", file=sys.stderr)
    
    # Output
    if args.format == 'ndjson':
        # NDJSON format
        timestamp_groups = {}
        for entity in all_entities:
            entity_dict = entity_to_dict(entity)
            
            # Add timestamp_index for multi-file processing
            if len(args.files) > 1:
                ts = entity_dict.get('timestamp')
                if ts:
                    # Use string timestamp for grouping (second-level precision)
                    ts_key = ts[:19] if len(ts) >= 19 else ts  # Extract YYYY-MM-DDTHH:MM:SS
                    if ts_key not in timestamp_groups:
                        timestamp_groups[ts_key] = 0
                    entity_dict['timestamp_index'] = timestamp_groups[ts_key]
                    timestamp_groups[ts_key] += 1
                else:
                    entity_dict['timestamp_index'] = 0
            
            print(json.dumps(entity_dict, default=str))
    else:
        # Standard JSON
        entity_dicts = []
        timestamp_groups = {}
        
        for entity in all_entities:
            entity_dict = entity_to_dict(entity)
            
            # Add timestamp_index for multi-file processing
            if len(args.files) > 1:
                ts = entity_dict.get('timestamp')
                if ts:
                    # Use string timestamp for grouping (second-level precision)
                    ts_key = ts[:19] if len(ts) >= 19 else ts  # Extract YYYY-MM-DDTHH:MM:SS
                    if ts_key not in timestamp_groups:
                        timestamp_groups[ts_key] = 0
                    entity_dict['timestamp_index'] = timestamp_groups[ts_key]
                    timestamp_groups[ts_key] += 1
                else:
                    entity_dict['timestamp_index'] = 0
            
            entity_dicts.append(entity_dict)
        
        output = {
            "grap_version": GRAP_VERSION,
            "extraction_time": datetime.now().isoformat(),
            "total_entities": len(all_entities),
            "entities": entity_dicts
        }
        print(json.dumps(output, indent=2, default=str))

if __name__ == "__main__":
    main()
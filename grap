class GaleraLogParser:
    """Complete Galera log parser that extracts ALL entities"""
    
    def __init__(self):
        # Use a permissive list type to accommodate core library entities like ClusterEntity
        self.entities: List[Any] = []
        self.sst_sessions: Dict[str, Dict] = {}  # Track ongoing SST sessions
        # Track ongoing wsrep view member blocks
        self._in_view_block: bool = False
        self._pending_view: Optional[ViewEntity] = None
        self._view_section: Optional[str] = None  # memb|joined|left|partitioned
        
    def parse_log(self, log_file: Union[str, Path]) -> List[Entity]:
        """Parse a Galera log file and extract all entities"""
        self.entities = []
        
        with open(log_file, 'r', encoding='utf-8', errors='replace') as f:
            for line_num, line in enumerate(f, 1):
                line = line.strip()
                if not line:
                    continue
                    
                # Try all entity patterns
                self._parse_node_events(line, line_num, str(log_file))
                self._parse_view_events(line, line_num, str(log_file))
                self._parse_sst_events(line, line_num, str(log_file))
                self._parse_ist_events(line, line_num, str(log_file))
                self._parse_error_events(line, line_num, str(log_file))
                self._parse_transaction_events(line, line_num, str(log_file))
        
        # Post-process SST sessions to calculate durations
        self._finalize_sst_sessions()
        
        # Assign cluster references to entities
        self._assign_cluster_references()
        
        return sorted(self.entities, key=lambda e: e.timestamp or datetime.min)

    def _infer_node_name(self, log_source: str) -> str:
        """Infer a stable node name from the log source path (filename without extension)."""
        try:
            base = Path(log_source).name
            # Strip common extensions
            if '.' in base:
                base = base.split('.')[0]
            return base
        except Exception:
            return "unknown"
    
    def filter_entities(self, entities: List[Entity], 
                       entity_types: Optional[Set[str]] = None,
                       confidence_threshold: float = 0.0) -> List[Entity]:
        """Filter entities by type and confidence"""
        filtered = entities
        
        # Filter by entity types
        if entity_types:
            entity_types_lower = {t.lower() for t in entity_types}
            filtered = [e for e in filtered if e.entity_type.lower() in entity_types_lower]
        
        # Filter by confidence threshold
        if confidence_threshold > 0.0:
            filtered = [e for e in filtered if e.confidence >= confidence_threshold]
            
        return filtered
    
    def _parse_timestamp(self, line: str) -> Optional[datetime]:
        """Extract timestamp from log line"""
        # MariaDB format variants:
        #  - "2025-09-19 11:10:37" (standard)
        #  - "2025-09-19  2:10:37" (single-digit hour with double space before time)
        # Use a regex that tolerates one or more spaces and 1-2 digit hour, then normalize.
        m = re.search(r'(\d{4}-\d{2}-\d{2})\s+(\d{1,2}):(\d{2}):(\d{2})', line)
        if m:
            try:
                date_part, h, mi, s = m.groups()
                # Zero-pad hour to 2 digits before parsing
                norm = f"{date_part} {int(h):02d}:{mi}:{s}"
                return datetime.strptime(norm, '%Y-%m-%d %H:%M:%S')
            except ValueError:
                pass
                
        # mysqld_safe format: 250919 11:10:37  
        match = re.search(r'(\d{6}\s+\d{2}:\d{2}:\d{2})', line)
        if match:
            try:
                return datetime.strptime('20' + match.group(1), '%Y%m%d %H:%M:%S')
            except ValueError:
                pass
                
        return None
    
    def _parse_node_events(self, line: str, line_num: int, log_source: str):
        """Parse node-related events"""
        timestamp = self._parse_timestamp(line)
        
        # Node state changes: Server status change joined -> synced
        match = re.search(r'Server status change (\w+) -> (\w+)', line)
        if match:
            entity = NodeEntity(
                timestamp=timestamp,
                line_number=line_num,
                raw_line=line,
                log_source=log_source,
                node_name=self._infer_node_name(log_source),
                node_state=f"{match.group(1)} -> {match.group(2)}",
                entity_id=f"node_state_{line_num}"
            )
            self.entities.append(entity)
            return
            
        # Node sync status: Member 1.0 (NODE_50000) synced with group
        match = re.search(r'Member (\d+\.\d+) \(([^)]+)\) synced with group', line)
        if match:
            entity = NodeEntity(
                timestamp=timestamp,
                line_number=line_num,
                raw_line=line,
                log_source=log_source,
                cluster_position=match.group(1),
                node_name=match.group(2),
                node_state="synced",
                entity_id=f"node_sync_{line_num}"
            )
            self.entities.append(entity)
            return
            
        # Node state shifting: Shifting PRIMARY -> JOINER (TO: 3)
        match = re.search(r'Shifting (\S+) -> (\w+)(?:\s+\(TO:\s+(\d+)\))?', line)
        if match:
            entity = NodeEntity(
                timestamp=timestamp,
                line_number=line_num,
                raw_line=line,
                log_source=log_source,
                node_name=self._infer_node_name(log_source),
                node_state=f"{match.group(1)} -> {match.group(2)}",
                entity_id=f"node_shift_{line_num}"
            )
            self.entities.append(entity)
            return
    
    def _parse_view_events(self, line: str, line_num: int, log_source: str):
        """Parse cluster view events"""
        timestamp = self._parse_timestamp(line)

        # If currently collecting a wsrep view member block, accumulate members until closing brace
        if getattr(self, "_in_view_block", False) and self._pending_view:
            # Detect block termination
            # Handle transitions like "} joined {" / "} left {" / "} partitioned {"
            trans = re.search(r'}\s*(memb|joined|left|partitioned)\s*\{', line)
            if trans:
                self._view_section = trans.group(1).lower()
                return

            # Handle final close ")" after finishing sections
            if re.search(r'}\s*\)\s*$', line):
                # Finalize and append the pending view entity
                self._pending_view.line_number = self._pending_view.line_number or line_num
                self.entities.append(self._pending_view)
                # Reset state
                self._in_view_block = False
                self._pending_view = None
                self._view_section = None
                return

            # Try to extract member entries inside parentheses: (node_name[, uuid]?)
            # Example formats:
            #   "\t14e3444b-9273,0"  (uuid,idx)
            #   "  node_name,0"       (name,idx)
            #   or legacy: "1.0 (node_name)"
            # Prefer capturing tokens before comma, else try parentheses pattern
            # Only register members for sections 'memb' or 'joined'
            current_section = (self._view_section or '').lower()
            collect = current_section in {"memb", "joined"}
            m_uuid = re.search(r'\b([a-f0-9\-]{8,})\s*,\s*\d+', line, re.IGNORECASE) if collect else None
            added = False
            if m_uuid:
                tok = m_uuid.group(1).strip()
                if tok and tok.lower() not in {"unknown", "joiner", "donor", "cluster", "n/a"}:
                    if tok not in self._pending_view.members:
                        self._pending_view.members.append(tok)
                        added = True
            if not added and collect:
                m_name_idx = re.search(r'\b([^,()]+)\s*,\s*\d+', line)
                if m_name_idx:
                    name = m_name_idx.group(1).strip()
                    if name and name.lower() not in {"unknown", "joiner", "donor", "cluster", "n/a"}:
                        if name not in self._pending_view.members:
                            self._pending_view.members.append(name)
                            added = True
            if not added and collect:
                paren = re.search(r'\(([^)]+)\)', line)
                if paren:
                    inside = paren.group(1).strip()
                    name = inside.split(',')[0].strip()
                    if name and name.lower() not in {"unknown", "joiner", "donor", "cluster", "n/a"}:
                        if name not in self._pending_view.members:
                            self._pending_view.members.append(name)
            return

        # Start of a new view block: view(view_id(PRIM,14e...,1206) memb {
        mstart = re.search(r'view\(view_id\((\w+),([^,]+),(\d+)\)\s+memb\s*\{', line)
        if mstart:
            state, cuuid, seq = mstart.groups()
            ve = ViewEntity(
                timestamp=timestamp,
                line_number=line_num,
                raw_line=line,
                log_source=log_source,
                cluster_state=state,
                view_id=f"{cuuid}:{seq}",
                view_seq=int(seq),
                cluster_uuid=cuuid,
                members=[],
                entity_id=f"view_{cuuid}_{seq}"
            )
            self._pending_view = ve
            self._in_view_block = True
            self._view_section = 'memb'
            # If the block is immediately closed on same line, finalize
            if re.search(r'\}', line):
                # If also final close ")" present, finalize; otherwise switch sections handled above
                if re.search(r'}\s*\)\s*$', line):
                    self.entities.append(self._pending_view)
                    self._in_view_block = False
                    self._pending_view = None
                    self._view_section = None
            return

        # Fallback: view(view_id(...)) line without explicit memb block (rare)
        mfallback = re.search(r'view\(view_id\((\w+),([^,]+),(\d+)\)\)', line)
        if mfallback:
            state, cuuid, seq = mfallback.groups()
            entity = ViewEntity(
                timestamp=timestamp,
                line_number=line_num,
                raw_line=line,
                log_source=log_source,
                cluster_state=state,
                view_id=f"{cuuid}:{seq}",
                view_seq=int(seq),
                cluster_uuid=cuuid,
                entity_id=f"view_{cuuid}_{seq}"
            )
            self.entities.append(entity)
            return

        # State transfer request: Member 1.0 (NODE_50000) requested state transfer from '*any*'
        match = re.search(r'Member (\d+\.\d+) \(([^)]+)\) requested state transfer', line)
        if match:
            # This creates a view-like event about state transfer need (keep as ViewEntity for backward compatibility)
            entity = ViewEntity(
                timestamp=timestamp,
                line_number=line_num,
                raw_line=line,
                log_source=log_source,
                members=[match.group(2)],
                cluster_state="state_transfer_requested",
                entity_id=f"view_sst_req_{line_num}"
            )
            self.entities.append(entity)
            return
            
    def _parse_sst_events(self, line: str, line_num: int, log_source: str):
        """Parse SST events and track sessions"""
        timestamp = self._parse_timestamp(line)
        
        # SST script start: Running: 'wsrep_sst_mariabackup --role 'joiner'
        match = re.search(r"Running: 'wsrep_sst_(\w+).*?--role '(\w+)'", line)
        if match:
            method = match.group(1)
            role = match.group(2)
            session_key = f"sst_{line_num}"
            
            self.sst_sessions[session_key] = {
                'start_time': timestamp,
                'method': method,
                'role': role,
                'start_line': line_num
            }
            
            entity = SSTEntity(
                entity_type="sst",
                timestamp=timestamp,
                line_number=line_num,
                raw_line=line,
                log_source=log_source,
                sst_method=method,
                sst_status="started",
                sst_script_triggered=True,  # SST script was initiated
                joiner_node=role if role == 'joiner' else '',
                donor_node=role if role == 'donor' else '',
                entity_id=session_key
            )
            self.entities.append(entity)
            return
            
        # SST completion: mariabackup SST completed on joiner
        match = re.search(r'(\w+) SST completed on (\w+)', line)
        if match:
            method = match.group(1)
            role = match.group(2)
            
            # Find matching session
            session_key = None
            for key, session in self.sst_sessions.items():
                if session.get('method') == method and session.get('role') == role:
                    session_key = key
                    break
            
            if not session_key:
                session_key = f"sst_complete_{line_num}"
            
            entity = SSTEntity(
                entity_type="sst",
                timestamp=timestamp,
                line_number=line_num,
                raw_line=line,
                log_source=log_source,
                sst_method=method,
                sst_status="completed",
                joiner_node=role if role == 'joiner' else '',
                donor_node=role if role == 'donor' else '',
                entity_id=session_key
            )
            self.entities.append(entity)
            
            # Calculate duration if we have start time
            if session_key in self.sst_sessions:
                start_time = self.sst_sessions[session_key].get('start_time')
                if start_time and timestamp:
                    entity.duration_seconds = (timestamp - start_time).total_seconds()
            return
            
        # State transfer complete: State transfer to 1.0 (NODE_50000) complete
        match = re.search(r'State transfer to (\d+\.\d+) \(([^)]+)\) complete', line)
        if match:
            entity = SSTEntity(
                entity_type="sst",
                timestamp=timestamp,
                line_number=line_num,
                raw_line=line,
                log_source=log_source,
                sst_status="transfer_complete",
                joiner_node=match.group(2),
                entity_id=f"sst_xfer_complete_{line_num}"
            )
            self.entities.append(entity)
            return
            
        # Donor selection: Selected 0.0 (NODE_54320)(SYNCED) as donor
        match = re.search(r'Selected (\d+\.\d+) \(([^)]+)\)\(([^)]+)\) as donor', line)
        if match:
            entity = SSTEntity(
                entity_type="sst",
                timestamp=timestamp,
                line_number=line_num,
                raw_line=line,
                log_source=log_source,
                sst_status="donor_selected",
                donor_node=match.group(2),
                entity_id=f"sst_donor_{line_num}"
            )
            self.entities.append(entity)
            return
            
        # SST backup transfer proceeding: WSREP_SST: [INFO] Proceeding with SST
        if "Proceeding with SST" in line:
            # Find the most recent SST session to update
            for session_key in reversed(list(self.sst_sessions.keys())):
                session = self.sst_sessions[session_key]
                # Update existing entities to mark backup transfer
                for entity in reversed(self.entities):
                    if (isinstance(entity, SSTEntity) and 
                        entity.entity_id == session_key and 
                        entity.sst_status == "started"):
                        entity.sst_status = "backup_transfer_started"
                        entity.backup_transfer_occurred = True
                        entity.sst_script_triggered = True
                        break
                break
            
            # Also create a specific entity for this event
            entity = SSTEntity(
                entity_type="sst",
                timestamp=timestamp,
                line_number=line_num,
                raw_line=line,
                log_source=log_source,
                sst_status="proceeding_with_backup",
                backup_transfer_occurred=True,
                sst_script_triggered=True,
                entity_id=f"sst_proceeding_{line_num}"
            )
            self.entities.append(entity)
            return
    
    def _parse_ist_events(self, line: str, line_num: int, log_source: str):
        """Parse IST (Incremental State Transfer) events - Enhanced with full workflow tracking"""
        timestamp = self._parse_timestamp(line)
        
        # IST UUID and range definition: ####### IST uuid:670ce4a0-9538-11f0-aa1f-168ebbd1d7d1 f: 0, l: 3
        match = re.search(r'IST uuid:([a-f0-9\-]+) f: (\d+), l: (\d+)', line)
        if match:
            uuid, first, last = match.groups()
            entity = ISTEntity(
                entity_type="ist",
                entity_id=f"ist_{uuid[:8]}",
                timestamp=timestamp,
                line_number=line_num,
                raw_line=line,
                log_source=log_source,
                ist_uuid=uuid,
                ist_first=int(first),
                ist_last=int(last),
                ist_status="preparing"
            )
            self.entities.append(entity)
            return
            
        # IST receiver address: IST receiver addr using tcp://192.168.178.77:15321
        match = re.search(r'IST receiver addr using (.+)', line)
        if match:
            address = match.group(1)
            entity = ISTEntity(
                entity_type="ist",
                entity_id=f"ist_receiver_{line_num}",
                timestamp=timestamp,
                line_number=line_num,
                raw_line=line,
                log_source=log_source,
                receiver_address=address,
                ist_status="receiver_ready"
            )
            self.entities.append(entity)
            return
            
        # IST prepared receiver: Prepared IST receiver for 0-3704, listening at: tcp://192.168.178.79:15321
        match = re.search(r'Prepared IST receiver for (\d+)-(\d+), listening at: (.+)', line)
        if match:
            start, end, address = match.groups()
            entity = ISTEntity(
                entity_type="ist",
                entity_id=f"ist_prepared_{line_num}",
                timestamp=timestamp,
                line_number=line_num,
                raw_line=line,
                log_source=log_source,
                ist_first=int(start),
                ist_last=int(end),
                receiver_address=address,
                ist_status="prepared"
            )
            self.entities.append(entity)
            return
            
        # IST applying starts: ####### IST applying starts with 3705
        match = re.search(r'IST applying starts with (\d+)', line)
        if match:
            seqno = int(match.group(1))
            entity = ISTEntity(
                entity_type="ist",
                entity_id=f"ist_applying_{line_num}",
                timestamp=timestamp,
                line_number=line_num,
                raw_line=line,
                log_source=log_source,
                ist_first=seqno,
                ist_status="applying"
            )
            self.entities.append(entity)
            return
            
        # IST current seqno initialization: ####### IST current seqno initialized to 3668
        match = re.search(r'IST current seqno initialized to (\d+)', line)
        if match:
            seqno = int(match.group(1))
            entity = ISTEntity(
                entity_type="ist",
                entity_id=f"ist_seqno_init_{line_num}",
                timestamp=timestamp,
                line_number=line_num,
                raw_line=line,
                log_source=log_source,
                ist_first=seqno,
                ist_status="seqno_initialized"
            )
            self.entities.append(entity)
            return
            
        # IST progress: Receiving IST... 0.0% (0/37 events) complete.
        match = re.search(r'Receiving IST\.\.\. ([\d.]+)% \((\d+)/(\d+) events\) complete\.', line)
        if match:
            percent, processed, total = match.groups()
            entity = ISTEntity(
                entity_type="ist",
                entity_id=f"ist_progress_{line_num}",
                timestamp=timestamp,
                line_number=line_num,
                raw_line=line,
                log_source=log_source,
                progress_percent=float(percent),
                events_processed=int(processed),
                events_total=int(total),
                ist_status="receiving"
            )
            self.entities.append(entity)
            return
            
        # IST received completion: IST received: 322635c3-8fac-11f0-8a05-2f6d0edb475a:3704
        match = re.search(r'IST received: ([a-f0-9\-]+):(\d+)', line)
        if match:
            uuid, seqno = match.groups()
            entity = ISTEntity(
                entity_type="ist",
                entity_id=f"ist_received_{line_num}",
                timestamp=timestamp,
                line_number=line_num,
                raw_line=line,
                log_source=log_source,
                ist_uuid=uuid,
                ist_last=int(seqno),
                ist_status="received"
            )
            self.entities.append(entity)
            return
            
        # IST preload: IST preload starting at 3668  
        match = re.search(r'IST preload starting at (\d+)', line)
        if match:
            seqno = int(match.group(1))
            entity = ISTEntity(
                entity_type="ist",
                entity_id=f"ist_preload_{line_num}",
                timestamp=timestamp,
                line_number=line_num,
                raw_line=line,
                log_source=log_source,
                ist_first=seqno,
                ist_status="preloading"
            )
            self.entities.append(entity)
            return
            
        # Processing event queue (post-IST): Processing event queue:... 28.4% (13072/46040 events) complete.
        match = re.search(r'Processing event queue:\.\.\. ([\d.]+)% \((\d+)/(\d+) events\) complete\.', line)
        if match:
            percent, processed, total = match.groups()
            entity = ISTEntity(
                entity_type="ist",
                entity_id=f"ist_processing_{line_num}",
                timestamp=timestamp,
                line_number=line_num,
                raw_line=line,
                log_source=log_source,
                progress_percent=float(percent),
                events_processed=int(processed),
                events_total=int(total),
                ist_status="processing"
            )
            self.entities.append(entity)
            return
    
    def _parse_error_events(self, line: str, line_num: int, log_source: str):
        """Parse errors and warnings"""
        timestamp = self._parse_timestamp(line)
        
        # Standard log levels
        for level in ['ERROR', 'Warning', 'Error']:
            if f'[{level}]' in line:
                # Extract message after log level
                match = re.search(f'\\[{level}\\]\\s+(.+)', line)
                if match:
                    entity = ErrorEntity(
                        timestamp=timestamp,
                        line_number=line_num,
                        raw_line=line,
                        log_source=log_source,
                        error_level=level.lower(),
                        error_message=match.group(1),
                        entity_id=f"error_{level.lower()}_{line_num}"
                    )
                    self.entities.append(entity)
                    return
                    
        # WSREP specific errors
        if 'WSREP:' in line and any(word in line.lower() for word in ['error', 'fail', 'abort']):
            match = re.search(r'WSREP:\s+(.+)', line)
            if match:
                entity = ErrorEntity(
                    timestamp=timestamp,
                    line_number=line_num,
                    raw_line=line,
                    log_source=log_source,
                    error_level="wsrep_error",
                    error_message=match.group(1),
                    component="WSREP",
                    entity_id=f"wsrep_error_{line_num}"
                )
                self.entities.append(entity)
                return
    
    def _parse_transaction_events(self, line: str, line_num: int, log_source: str):
        """Parse transaction and commit events"""
        timestamp = self._parse_timestamp(line)
        
        # Transaction commit: applying trx ... 
        match = re.search(r'applying.*seqno:\s*(\d+)', line)
        if match:
            entity = TransactionEntity(
                timestamp=timestamp,
                line_number=line_num,
                raw_line=line,
                log_source=log_source,
                transaction_id=match.group(1),
                operation_type="applying",
                entity_id=f"trx_apply_{match.group(1)}"
            )
            self.entities.append(entity)
            return
            
        # Seqno information in various formats
        match = re.search(r'seqno[:\s]+(\d+)', line, re.IGNORECASE)
        if match and 'commit' in line.lower():
            entity = TransactionEntity(
                timestamp=timestamp,
                line_number=line_num,
                raw_line=line,
                log_source=log_source,
                transaction_id=match.group(1),
                operation_type="commit",
                entity_id=f"trx_commit_{match.group(1)}"
            )
            self.entities.append(entity)
            return
    
    def _finalize_sst_sessions(self):
        """Post-process SST sessions to link start/end events"""
        # This would link related SST events and calculate accurate durations
        pass
    
    def _assign_cluster_references(self):
        """
        Assign cluster references to entities based on relationship design:
        - VIEW → CLUSTER
        - NODE → CLUSTER  
        - SST → CLUSTER
        - IST → NODE
        - ERROR → NODE+CLUSTER (smart classification)
        """
        try:
            # Import cluster UUID extraction function from core library
            from lib.entities.enhanced_parser import extract_cluster_uuid_from_raw_line
        except ImportError:
            # Fallback if core library is not available
            extract_cluster_uuid_from_raw_line = None
        
        # Step 1: Detect cluster UUID by scanning the entire log file
        cluster_uuid = None
        
        # We need to scan the original log file, not just entity lines
        # The cluster UUID patterns might be in lines that aren't extracted as entities
        log_source = None
        for entity in self.entities:
            if hasattr(entity, 'log_source') and entity.log_source:
                log_source = entity.log_source
                break
        
        if log_source and extract_cluster_uuid_from_raw_line:
            try:
                with open(log_source, 'r', encoding='utf-8', errors='replace') as f:
                    for line in f:
                        detected_uuid = extract_cluster_uuid_from_raw_line(line)
                        if detected_uuid:
                            cluster_uuid = detected_uuid
                            break
            except Exception as e:
                pass

        # Fallback: derive from parsed view entities if scan failed
        if not cluster_uuid:
            for e in self.entities:
                if isinstance(e, ViewEntity) and e.cluster_uuid:
                    cluster_uuid = e.cluster_uuid
                    break

        # Last resort: try to extract from view_id if available
        if not cluster_uuid:
            for e in self.entities:
                if isinstance(e, ViewEntity) and e.view_id and ':' in e.view_id:
                    maybe_uuid = e.view_id.split(':', 1)[0].strip()
                    if maybe_uuid and re.match(r'^[0-9a-fA-F\-]{8,}$', maybe_uuid):
                        cluster_uuid = maybe_uuid
                        break
        
        # Create cluster reference name (use unknown bucket if UUID still missing)
        cluster_ref = f"cluster_{cluster_uuid[:8]}" if cluster_uuid else "_unknown_cluster"
        
        # Create cluster reference name
        # Step 2: Add cluster_ref field to base Entity class if not present
        for entity in self.entities:
            if not hasattr(entity, 'cluster_ref'):
                entity.cluster_ref = None
        
        # Step 3: Assign cluster references based on entity types
        for entity in self.entities:
            # Use class type like entity_to_dict does
            entity_type = type(entity).__name__.replace('Entity', '').lower()
            
            if entity_type == 'view':
                # VIEW → CLUSTER
                entity.cluster_ref = cluster_ref
                
            elif entity_type == 'node':
                # NODE → CLUSTER
                entity.cluster_ref = cluster_ref
                
            elif entity_type == 'sst':
                # SST → CLUSTER (cluster-wide operation)
                entity.cluster_ref = cluster_ref
                
            elif entity_type == 'ist':
                # IST → NODE (node-specific, but could also reference cluster via node)
                # For now, assign cluster_ref since we don't have node_ref field
                entity.cluster_ref = cluster_ref
                
            elif entity_type == 'error':
                # ERROR → NODE+CLUSTER (smart classification)
                # For simplicity, assign cluster_ref to all errors
                # More sophisticated logic could determine node vs cluster scope
                entity.cluster_ref = cluster_ref
        
        # Step 4: Create and add a CLUSTER entity using core library
        if ClusterEntity and cluster_uuid:
            # Determine a reasonable timestamp: earliest available among parsed entities
            earliest_ts = None
            for e in self.entities:
                ts = getattr(e, 'timestamp', None)
                if ts is None:
                    continue
                if earliest_ts is None:
                    earliest_ts = ts
                elif ts < earliest_ts:
                    earliest_ts = ts
            cluster_entity = ClusterEntity(
                entity_id=f"cluster_{cluster_uuid[:8]}",
                timestamp=earliest_ts,
                line_number=0,
                log_source="cluster_detection",
                confidence=1.0,
                raw_line=f"Cluster UUID: {cluster_uuid}",
                cluster_name=cluster_ref,
                cluster_uuid=cluster_uuid
            )
            # Set cluster_ref to itself
            cluster_entity.cluster_ref = cluster_ref
            self.entities.append(cluster_entity)
        


class GrapCacheManager:
    """Manages GRAP analysis cache for performance optimization"""
    
    def __init__(self, cache_dir: Optional[Path] = None):
        self.cache_dir = cache_dir or Path("./grap_cache")
        self.cache_dir.mkdir(exist_ok=True)
    
    def get_cache_key(self, log_file: Path) -> str:
        """Generate cache key based on file path and metadata"""
        # Use file path + size + mtime for cache key
        stat = log_file.stat()
        key_data = f"{log_file.absolute()}_{stat.st_size}_{stat.st_mtime}"
        return hashlib.md5(key_data.encode()).hexdigest()[:16]
    
    def get_cache_path(self, log_file: Path) -> Path:
        """Get cache file path for log file"""
        cache_key = self.get_cache_key(log_file)
        safe_filename = log_file.stem.replace('/', '_').replace('\\', '_')
        return self.cache_dir / f"{safe_filename}_grap_{cache_key}.json"
    
    def is_cache_valid(self, log_file: Path) -> bool:
        """Check if cache exists and is valid"""
        cache_path = self.get_cache_path(log_file)
        
        if not cache_path.exists():
            return False
        
        try:
            # Load cache and check metadata
            with open(cache_path, 'r', encoding='utf-8') as f:
                cache_data = json.load(f)
            
            cache_meta = cache_data.get('cache_metadata', {})
            original_file = Path(cache_meta.get('original_file', ''))
            
            # Check if original file still exists and matches metadata
            if not original_file.exists() or original_file.absolute() != log_file.absolute():
                return False
            
            stat = log_file.stat()
            # Use rounded comparison for mtime to handle floating point precision
            return (cache_meta.get('file_size') == stat.st_size and 
                   abs(cache_meta.get('file_mtime', 0) - stat.st_mtime) < 0.001)
        
        except (json.JSONDecodeError, KeyError, OSError):
            return False
    
    def load_cache(self, log_file: Path) -> Optional[Dict[str, Any]]:
        """Load cached analysis if valid"""
        if not self.is_cache_valid(log_file):
            return None
        
        cache_path = self.get_cache_path(log_file)
        try:
            with open(cache_path, 'r', encoding='utf-8') as f:
                return json.load(f)
        except (json.JSONDecodeError, OSError):
            return None
    
    def save_cache(self, log_file: Path, analysis_data: Dict[str, Any]) -> Path:
        """Save analysis to cache with metadata"""
        cache_path = self.get_cache_path(log_file)
        
        # Get file metadata
        stat = log_file.stat()
        
        # Create cache data with metadata header
        cache_data = {
            'cache_metadata': {
                'original_file': str(log_file.absolute()),
                'original_filename': log_file.name,
                'file_size': stat.st_size,
                'file_mtime': stat.st_mtime,
                'file_modified_time': datetime.fromtimestamp(stat.st_mtime).isoformat(),
                'cache_created': datetime.now().isoformat(),
                'grap_version': '2.2.0',
                'cache_format_version': '1.0'
            },
            'analysis_data': analysis_data
        }
        
        # Save to cache
        with open(cache_path, 'w', encoding='utf-8') as f:
            json.dump(cache_data, f, indent=2)
        
        return cache_path

class GrapOutputFormatter:
    """Output formatter for GRAP results"""
    
    @staticmethod
    def format_text(entities: List[Entity]) -> str:
        """Format entities as human-readable text"""
        output = []
        output.append("GRAP Complete Entity Extraction Results")
        output.append("=" * 50)
        output.append(f"Generated: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
        output.append(f"Total entities: {len(entities)}")
        output.append("")
        
        # Group by entity type
        entity_groups = {}
        for entity in entities:
            entity_type = type(entity).__name__.replace('Entity', '').upper()
            if entity_type not in entity_groups:
                entity_groups[entity_type] = []
            entity_groups[entity_type].append(entity)
        
        for entity_type, group_entities in entity_groups.items():
            output.append(f"{entity_type} ({len(group_entities)} entities)")
            output.append("-" * 30)
            
            for entity in group_entities[:10]:  # Limit to first 10
                timestamp_str = entity.timestamp.strftime('%Y-%m-%d %H:%M:%S') if entity.timestamp else 'No timestamp'
                output.append(f"  {timestamp_str} ({entity.confidence:.2f}) [ID: {entity.entity_id[:10]}]")
                
                if isinstance(entity, NodeEntity):
                    output.append(f"    Node: {entity.node_name or 'Unknown'} | State: {entity.node_state}")
                elif isinstance(entity, ViewEntity):
                    output.append(f"    View: {entity.view_id[:10]}... | Seq: {entity.view_seq} | State: {entity.cluster_state}")
                elif isinstance(entity, SSTEntity):
                    output.append(f"    Method: {entity.sst_method} | Status: {entity.sst_status} | Duration: {entity.duration_seconds:.1f}s")
                elif isinstance(entity, ISTEntity):
                    output.append(f"    UUID: {entity.ist_uuid[:20]}... | Range: {entity.ist_first}-{entity.ist_last}")
                elif isinstance(entity, ErrorEntity):
                    output.append(f"    Level: {entity.error_level} | Message: {entity.error_message[:50]}...")
                elif isinstance(entity, TransactionEntity):
                    output.append(f"    Transaction: {entity.transaction_id} | Operation: {entity.operation_type}")
                    
            if len(group_entities) > 10:
                output.append(f"    ... and {len(group_entities) - 10} more entities")
            output.append("")
            
        return "\n".join(output)
    
    @staticmethod
    def entity_to_dict(entity: Entity) -> Dict[str, Any]:
        """Convert entity to dictionary representation"""
        # Handle entity_type from both string and enum sources
        entity_type = type(entity).__name__.replace('Entity', '').lower()
        
        # Handle core library entities with EntityType enum
        et_attr = getattr(entity, 'entity_type', None)
        if et_attr:
            # If already a non-empty string, use it
            if isinstance(et_attr, str) and et_attr.strip():
                entity_type = et_attr.lower()
            else:
                # Attempt to read enum-like .value attribute
                val = getattr(et_attr, 'value', None)
                if isinstance(val, str) and val.strip():
                    entity_type = val.lower()
        
        result = {
            'entity_type': entity_type,
            'entity_id': entity.entity_id,
            'timestamp': entity.timestamp.isoformat() if entity.timestamp else None,
            'line_number': entity.line_number,
            'log_source': entity.log_source,
            'confidence': entity.confidence,
            'raw_line': entity.raw_line,
            'cluster_ref': entity.cluster_ref
        }
        
        # Add entity-specific fields
        if isinstance(entity, NodeEntity):
            result.update({
                'node_uuid': entity.node_uuid,
                'node_name': entity.node_name,
                'node_address': entity.node_address,
                'node_state': entity.node_state,
                'cluster_position': entity.cluster_position
            })
        elif isinstance(entity, ViewEntity):
            result.update({
                'view_id': entity.view_id,
                'view_seq': entity.view_seq,
                'cluster_state': entity.cluster_state,
                'cluster_uuid': entity.cluster_uuid,
                'members': entity.members
            })
        elif isinstance(entity, SSTEntity):
            result.update({
                'sst_method': entity.sst_method,
                'donor_node': entity.donor_node,
                'joiner_node': entity.joiner_node,
                'sst_status': entity.sst_status,
                'seqno_start': entity.seqno_start,
                'seqno_end': entity.seqno_end,
                'duration_seconds': entity.duration_seconds,
                'backup_transfer_occurred': entity.backup_transfer_occurred,
                'sst_script_triggered': entity.sst_script_triggered,
                'installed_state_seqno': entity.installed_state_seqno,
                'related_ist_id': entity.related_ist_id
            })
        elif isinstance(entity, ISTEntity):
            result.update({
                'ist_uuid': entity.ist_uuid,
                'ist_first': entity.ist_first,
                'ist_last': entity.ist_last,
                'donor_node': entity.donor_node,
                'receiver_address': entity.receiver_address,
                'progress_percent': entity.progress_percent,
                'events_total': entity.events_total,
                'events_processed': entity.events_processed,
                'ist_status': entity.ist_status,
                'follows_sst_id': entity.follows_sst_id,
                'applying_from_seqno': entity.applying_from_seqno
            })
        elif isinstance(entity, ErrorEntity):
            result.update({
                'error_level': entity.error_level,
                'error_code': entity.error_code,
                'error_message': entity.error_message,
                'component': entity.component
            })
        elif isinstance(entity, TransactionEntity):
            result.update({
                'transaction_id': entity.transaction_id,
                'operation_type': entity.operation_type
            })
        elif ClusterEntity and isinstance(entity, ClusterEntity):
            result.update({
                'cluster_name': entity.cluster_name,
                'cluster_uuid': entity.cluster_uuid,
                'cluster_health_score': entity.cluster_health_score,
                'split_brain_detected': entity.split_brain_detected
            })
            
        return result
        
        data = {
            'grap_version': '2.2.0',
            'extraction_time': datetime.now().isoformat(),
            'total_entities': len(entities),
            'entities': [entity_to_dict(e) for e in entities]
        }
        
        return json.dumps(data, indent=2)
    
    @staticmethod
    def format_json(entities: List[Entity]) -> str:
        """Format entities as JSON"""
        formatter = GrapOutputFormatter()
        
        data = {
            'grap_version': '2.2.0',
            'extraction_time': datetime.now().isoformat(),
            'total_entities': len(entities),
            'entities': [formatter.entity_to_dict(e) for e in entities]
        }
        
        return json.dumps(data, indent=2)
    
    @staticmethod
    def format_yaml(entities: List[Entity]) -> str:
        """Format entities as YAML"""
        data = {
            'grap_version': '2.3.0-enhanced',
            'extraction_time': datetime.now().isoformat(),
            'total_entities': len(entities),
            'entities': []
        }
        
        formatter = GrapOutputFormatter()
        for entity in entities:
            entity_dict = formatter.entity_to_dict(entity)
            data['entities'].append(entity_dict)
        
        return yaml.dump(data, default_flow_style=False, sort_keys=False)

def main():
    """Enhanced main CLI entry point with filtering and YAML support"""
    parser = argparse.ArgumentParser(
        description='GRAP - Galera Real-time Analysis Parser (Enhanced Production Implementation)',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  %(prog)s node1.log                                    # Single node analysis
  %(prog)s node1.log node2.log --multi                   # Multi-node cluster analysis  
  %(prog)s *.log --multi --format=json                   # JSON cluster analysis
  %(prog)s node.log --entities=SST,IST                   # Filter SST and IST entities only
  %(prog)s node.log --format=yaml --confidence-threshold=0.9       # YAML output with high confidence
  %(prog)s node.log --entities=IST --format=json         # IST workflow analysis in JSON
        """
    )
    parser.add_argument('logfiles', nargs='+', help='Galera log file(s) to analyze')
    parser.add_argument('--format', choices=['text', 'json', 'yaml'], default='text',
                        help='Output format (default: text)')
    parser.add_argument('--output', '-o', type=Path,
                        help='Output file (default: stdout)')
    parser.add_argument('-v', '--verbose', action='store_true',
                        help='Enable verbose logging')
    parser.add_argument('--multi', action='store_true',
                        help='Multi-node cluster analysis mode')
    parser.add_argument('--no-cache', action='store_true',
                        help='Disable cache usage (force re-analysis)')
    parser.add_argument('--cache-dir', type=Path, default='./grap_cache',
                        help='Cache directory (default: ./grap_cache)')
    
    # New enhanced options
    parser.add_argument('--entities', 
                       help='Comma-separated list of entity types to extract (SST,IST,VIEW,NODE,ERROR,TRANSACTION)')
    parser.add_argument('--confidence-threshold', type=float, default=0.0,
                       help='Minimum confidence threshold for entity extraction (default: 0.0)')
    
    args = parser.parse_args()
    
    if args.verbose:
        logging.basicConfig(level=logging.DEBUG)
    
    if args.multi and len(args.logfiles) > 1:
        # Multi-node analysis - TODO: Implement integrated multi-node processing
        print("Error: Multi-node analysis (--multi) is currently not available.")
        print("Use single-node analysis on individual log files instead:")
        for logfile in args.logfiles:
            print(f"  ./grap {logfile}")
        sys.exit(1)
    else:
        # Single-node analysis
        if len(args.logfiles) > 1:
            print("⚠️  Multiple files provided without --multi flag. Analyzing first file only.")
        
        log_file = Path(args.logfiles[0])
        
        # Initialize cache manager
        cache_manager = GrapCacheManager(args.cache_dir)
        
        # Check cache unless disabled
        analysis_data = None
        used_cache = False
        
        if not args.no_cache:
            cached_data = cache_manager.load_cache(log_file)
            if cached_data:
                analysis_data = cached_data['analysis_data']
                used_cache = True
                if args.verbose:
                    cache_meta = cached_data['cache_metadata']
                    print(f"📁 Using cached analysis from {cache_meta['cache_created']}")
                    print(f"   Original: {cache_meta['original_filename']} ({cache_meta['file_size']} bytes)")
                    print(f"   Modified: {cache_meta['file_modified_time']}")
        
        if not analysis_data:
            # Parse the log file
            if args.verbose:
                print(f"🔍 Analyzing {log_file.name}...")
            
            grap_parser = GaleraLogParser()
            entities = grap_parser.parse_log(log_file)
            
            # Apply entity filtering
            entity_types = None
            if args.entities:
                entity_types = set(e.strip().upper() for e in args.entities.split(','))
            
            filtered_entities = grap_parser.filter_entities(
                entities, entity_types, args.confidence_threshold
            )
            
            # Create analysis data structure (use filtered entities)
            formatter = GrapOutputFormatter()
            analysis_data = {
                'grap_version': '2.3.0-enhanced',
                'extraction_time': datetime.now().isoformat(),
                'total_entities': len(filtered_entities),
                'entities': [formatter.entity_to_dict(e) for e in filtered_entities]
            }
            
            # Save to cache unless disabled (cache all entities, not filtered)
            if not args.no_cache:
                cache_data = {
                    'grap_version': '2.3.0-enhanced',
                    'extraction_time': datetime.now().isoformat(),
                    'total_entities': len(entities),
                    'entities': [formatter.entity_to_dict(e) for e in entities]
                }
                cache_path = cache_manager.save_cache(log_file, cache_data)
                if args.verbose:
                    print(f"💾 Analysis cached to {cache_path}")
        else:
            # Load from cache and apply filters
            all_entities = []
            for entity_data in analysis_data['entities']:
                # Reconstruct entities from cache with correct types
                entity_type = entity_data.get('entity_type', '').lower()
                
                # Create entity of correct type
                if entity_type == 'node':
                    entity = NodeEntity()
                elif entity_type == 'view':
                    entity = ViewEntity()
                elif entity_type == 'sst':
                    entity = SSTEntity()
                elif entity_type == 'ist':
                    entity = ISTEntity()
                elif entity_type == 'error':
                    entity = ErrorEntity()
                elif entity_type == 'transaction':
                    entity = TransactionEntity()
                else:
                    entity = Entity()
                
                # Set all attributes
                for key, value in entity_data.items():
                    if key == 'timestamp' and value:
                        try:
                            entity.timestamp = datetime.fromisoformat(value.replace('Z', '+00:00'))
                        except:
                            entity.timestamp = None
                    else:
                        setattr(entity, key, value)
                all_entities.append(entity)
            
            # Apply filters to cached data
            entity_types = None
            if args.entities:
                entity_types = set(e.strip().upper() for e in args.entities.split(','))
            
            grap_parser = GaleraLogParser()
            filtered_entities = grap_parser.filter_entities(
                all_entities, entity_types, args.confidence_threshold
            )
        
        # Format output
        formatter = GrapOutputFormatter()
        if args.format == 'json':
            output = formatter.format_json(filtered_entities)
        elif args.format == 'yaml':
            output = formatter.format_yaml(filtered_entities)
        else:
            output = formatter.format_text(filtered_entities)
            
            # Add cache info to text output
            if used_cache:
                output = f"📁 (Using cached analysis)\n{output}"
        
        # Write output
        if args.output:
            args.output.write_text(output, encoding='utf-8')
            print(f"✅ Results written to {args.output}")
        else:
            print(output)

if __name__ == '__main__':
    main()
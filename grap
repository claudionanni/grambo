#!/usr/bin/env python3
"""
GRAP - Galera Real-time Analysis Parser (Centralized Entity System)

The only tool for entity extraction - uses centralized lib/entities system.
All other tools must use grap's JSON output, not extract entities themselves.
"""

import json
import sys
import os
from pathlib import Path
import argparse
import logging
from typing import Dict, List, Optional, Any, Set, Union

# Import centralized entity system - grap is the only extraction tool
from lib.entities import create_enhanced_parser, EntityType


class GrapParser:
    """Centralized Galera log parser using lib/entities system"""
    
    def __init__(self, pattern_dirs: List[str] = None):
        """Initialize with centralized entity system"""
        if pattern_dirs is None:
            pattern_dirs = ['patterns']
            
        # Create the enhanced parser from lib/entities
        self.parser = create_enhanced_parser(pattern_dirs)
        
        if self.parser is None:
            raise RuntimeError("Failed to create enhanced parser")
            
    def parse_log(self, log_file: Union[str, Path]) -> List[Any]:
        """Parse log file and return entities"""
        return self.parser.parse_single_log(str(log_file))
        
    def parse_multiple_logs(self, log_files: List[Union[str, Path]]) -> List[Any]:
        """Parse multiple log files for cluster analysis"""
        # For multiple logs, parse each individually and combine results
        all_entities = []
        for log_file in log_files:
            entities = self.parser.parse_single_log(str(log_file))
            all_entities.extend(entities)
        return all_entities
        
    def filter_entities(self, entities: List[Any], 
                       entity_types: Optional[Set[str]] = None,
                       confidence_threshold: float = 0.0) -> List[Any]:
        """Filter entities by type and confidence"""
        filtered = [e for e in entities if e.confidence >= confidence_threshold]
        
        if entity_types:
            # Convert entity type names to EntityType enums
            entity_type_enums = set()
            for et_name in entity_types:
                try:
                    entity_type_enums.add(EntityType(et_name.upper()))
                except ValueError:
                    print(f"Warning: Unknown entity type '{et_name}'", file=sys.stderr)
            
            filtered = [e for e in filtered if e.entity_type in entity_type_enums]
            
        return filtered


def entity_to_dict(entity: Any) -> Dict[str, Any]:
    """Convert entity to dictionary for JSON serialization"""
    result = {
        'entity_type': entity.entity_type.value,
        'entity_id': entity.entity_id,
        'timestamp': entity.timestamp.isoformat() if entity.timestamp else None,
        'line_number': entity.line_number,
        'log_source': entity.log_source,
        'confidence': entity.confidence,
        'content': entity.content if hasattr(entity, 'content') else None
    }
    
    # Add entity-specific attributes
    for attr, value in entity.__dict__.items():
        if not attr.startswith('_') and attr not in result:
            if hasattr(value, 'value'):  # Handle enums
                result[attr] = value.value
            elif isinstance(value, (str, int, float, bool, list, dict)) or value is None:
                result[attr] = value
            else:
                result[attr] = str(value)
                
    return result


def format_text(entities: List[Any]) -> str:
    """Format entities as human-readable text"""
    if not entities:
        return "No entities found.\n"
        
    output = []
    output.append(f"Found {len(entities)} entities:\n")
    
    # Group by entity type
    by_type = {}
    for entity in entities:
        entity_type = entity.entity_type.value
        if entity_type not in by_type:
            by_type[entity_type] = []
        by_type[entity_type].append(entity)
    
    for entity_type, type_entities in by_type.items():
        output.append(f"\n=== {entity_type.upper()} ENTITIES ({len(type_entities)}) ===")
        for entity in type_entities[:10]:  # Show first 10 of each type
            line_info = f"Line {entity.line_number}"
            if entity.timestamp:
                line_info += f" ({entity.timestamp})"
            
            # Show entity-specific summary
            if entity.entity_type == EntityType.CLUSTER:
                summary = f"Cluster {entity.cluster_uuid} - {entity.provider_name}"
            elif entity.entity_type == EntityType.NODE:
                summary = f"Node {entity.node_name or entity.node_uuid} - {entity.node_ip or 'no IP'}"
            elif entity.entity_type == EntityType.NODE_STATE:
                summary = f"State: {entity.from_state} -> {entity.to_state}"
            else:
                summary = str(entity.content) if hasattr(entity, 'content') and entity.content else "Entity"
                
            output.append(f"  {line_info}: {summary}")
            
        if len(type_entities) > 10:
            output.append(f"  ... and {len(type_entities) - 10} more")
    
    return '\n'.join(output)


def format_json(entities: List[Any]) -> str:
    """Format entities as JSON"""
    entities_data = [entity_to_dict(entity) for entity in entities]
    
    result = {
        'summary': {
            'total_entities': len(entities),
            'entity_types': {}
        },
        'entities': entities_data
    }
    
    # Count by type
    for entity in entities:
        entity_type = entity.entity_type.value
        result['summary']['entity_types'][entity_type] = \
            result['summary']['entity_types'].get(entity_type, 0) + 1
    
    return json.dumps(result, indent=2, ensure_ascii=False)


def format_yaml(entities: List[Any]) -> str:
    """Format entities as YAML"""
    try:
        import yaml
        entities_data = [entity_to_dict(entity) for entity in entities]
        
        result = {
            'summary': {
                'total_entities': len(entities),
                'entity_types': {}
            },
            'entities': entities_data
        }
        
        # Count by type
        for entity in entities:
            entity_type = entity.entity_type.value
            result['summary']['entity_types'][entity_type] = \
                result['summary']['entity_types'].get(entity_type, 0) + 1
        
        return yaml.dump(result, default_flow_style=False)
    except ImportError:
        return "YAML output requires PyYAML library"


def main():
    """Enhanced main CLI entry point using centralized entity system"""
    parser = argparse.ArgumentParser(
        description='GRAP - Galera Real-time Analysis Parser (Centralized Entity System)',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  %(prog)s node1.log                                    # Single node analysis
  %(prog)s node1.log node2.log --multi                  # Multi-node cluster analysis  
  %(prog)s *.log --multi --format=json                  # JSON cluster analysis
  %(prog)s node.log --entities=NODE,NODE_STATE,CLUSTER  # Filter enhanced entities
  %(prog)s node.log --format=yaml --confidence-threshold=0.9  # YAML output with high confidence
        """
    )
    parser.add_argument('logfiles', nargs='+', help='Galera log file(s) to analyze')
    parser.add_argument('--format', choices=['text', 'json', 'yaml'], default='text',
                        help='Output format (default: text)')
    parser.add_argument('--output', '-o', type=Path,
                        help='Output file (default: stdout)')
    parser.add_argument('-v', '--verbose', action='store_true',
                        help='Enable verbose logging')
    parser.add_argument('--multi', action='store_true',
                        help='Multi-node cluster analysis mode')
    parser.add_argument('--no-cache', action='store_true',
                        help='Disable cache usage (force re-analysis)')
    
    # Enhanced options
    parser.add_argument('--entities', 
                        help='Comma-separated list of entity types to include (e.g., NODE,CLUSTER,NODE_STATE)')
    parser.add_argument('--confidence-threshold', type=float, default=0.0,
                        help='Minimum confidence threshold (0.0-1.0, default: 0.0)')
    
    args = parser.parse_args()
    
    # Set up logging
    log_level = logging.DEBUG if args.verbose else logging.INFO
    logging.basicConfig(level=log_level, format='%(asctime)s - %(levelname)s - %(message)s')
    
    try:
        # Initialize centralized parser
        grap_parser = GrapParser()
        
        # Parse log files
        if args.multi or len(args.logfiles) > 1:
            entities = grap_parser.parse_multiple_logs(args.logfiles)
        else:
            entities = grap_parser.parse_log(args.logfiles[0])
        
        # Filter entities
        entity_types = None
        if args.entities:
            entity_types = set(e.strip().upper() for e in args.entities.split(','))
            
        filtered_entities = grap_parser.filter_entities(
            entities, 
            entity_types=entity_types,
            confidence_threshold=args.confidence_threshold
        )
        
        # Format output
        if args.format == 'json':
            output = format_json(filtered_entities)
        elif args.format == 'yaml':
            output = format_yaml(filtered_entities) 
        else:
            output = format_text(filtered_entities)
        
        # Write output
        if args.output:
            with open(args.output, 'w') as f:
                f.write(output)
        else:
            print(output)
            
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        if args.verbose:
            import traceback
            traceback.print_exc()
        sys.exit(1)


if __name__ == "__main__":
    main()